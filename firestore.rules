/**
 * @fileoverview Firestore Security Rules for WorkWise application.
 *
 * Core Philosophy:
 * This ruleset enforces a hybrid security model. Staff members have ownership-based access to their own profiles and actions.
 * Administrative access is granted via a database-based access control (DBAC) mechanism using the `/roles_admin/{uid}` collection.
 * Other top-level collections (`customers`, `workSchedules`, `locations`) are implicitly restricted to admin-only access.
 *
 * Data Structure:
 * - /staff/{staffId}: Staff member profiles, accessible only by the staff member themselves or an admin.
 * - /customers/{customerId}: Customer information, accessible only by admins.
 * - /workSchedules/{workScheduleId}: Work schedules, accessible only by admins.
 * - /locations/{locationId}: Location information, accessible only by admins.
 * - /staff/{staffId}/employeeActions/{employeeActionId}: Employee action logs, accessible only by the staff member themselves or an admin.
 * - /roles_admin/{uid}: Documents indicating admin role. The existence of a document grants admin privileges to the corresponding user.
 *
 * Key Security Decisions:
 * - Customers, WorkSchedules, and Locations are only accessible by admins.
 * - Staff members can only access their own profile and employee actions.
 * - Admin status is determined by the presence of a document in the `/roles_admin/{uid}` collection.
 * - List operations on the `/customers` collection are explicitly denied to non-admins to avoid accidental exposure of customer data.
 *
 * Denormalization for Authorization:
 *  - Admin status is checked via `exists(/databases/(default)/documents/roles_admin/$(request.auth.uid))`, avoiding the need to store admin status within the user document itself.
 *
 * Structural Segregation:
 *  - Employee actions are stored in a subcollection under the staff member's profile, ensuring clear ownership and preventing accidental public exposure.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is made by a signed-in user.
     * @return {bool} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the request is made by the owner of the document.
     * @param {string} userId - The user ID to compare against the request's auth UID.
     * @return {bool} True if the user ID matches the request's auth UID, false otherwise.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

     /**
     * @description Checks if the request is made by an existing owner of the document.
     * @param {string} userId - The user ID to compare against the request's auth UID.
     * @return {bool} True if the user ID matches the request's auth UID and the document exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the requesting user has admin privileges by verifying the existence of a document in the `/roles_admin/{uid}` collection.
     * @return {bool} True if the user is an admin, false otherwise.
     */
    function isAdmin() {
      return isSignedIn() && exists(/databases/(default)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * @description Rules for staff documents.
     * @path /staff/{staffId}
     * @allow (get) Authenticated staff member can read their own document: request.auth.uid == staffId
     * @allow (create) Authenticated staff member can create their own document: request.auth.uid == staffId
     * @allow (update) Authenticated staff member can update their own document: request.auth.uid == staffId
     * @allow (delete) Authenticated staff member can delete their own document: request.auth.uid == staffId
     * @deny (get) Authenticated staff member cannot read another staff member's document: request.auth.uid != staffId
     * @deny (create) Unauthenticated user cannot create a staff document: request.auth == null
     * @principle Enforces document ownership for staff profiles.
     */
    match /staff/{staffId} {
      allow get: if isSignedIn() && (isOwner(staffId) || isAdmin());
      allow list: if false; // Prevent listing of all staff documents

      allow create: if isSignedIn() && isOwner(staffId) && request.resource.data.id == staffId;
      allow update: if isExistingOwner(staffId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(staffId);
    }

    /**
     * @description Rules for customer documents.
     * @path /customers/{customerId}
     * @allow (get) Admin user can read customer documents.
     * @allow (create) Admin user can create customer documents.
     * @allow (update) Admin user can update customer documents.
     * @allow (delete) Admin user can delete customer documents.
     * @deny (get) Non-admin user cannot read customer documents.
     * @deny (create) Non-admin user cannot create customer documents.
     * @principle Restricts customer data access to admins only.
     */
    match /customers/{customerId} {
      allow get: if isAdmin();
      allow list: if false;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Rules for work schedule documents.
     * @path /workSchedules/{workScheduleId}
     * @allow (get) Admin user can read work schedule documents.
     * @allow (create) Admin user can create work schedule documents.
     * @allow (update) Admin user can update work schedule documents.
     * @allow (delete) Admin user can delete work schedule documents.
     * @deny (get) Non-admin user cannot read work schedule documents.
     * @deny (create) Non-admin user cannot create work schedule documents.
     * @principle Restricts work schedule data access to admins only.
     */
    match /workSchedules/{workScheduleId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Rules for location documents.
     * @path /locations/{locationId}
     * @allow (get) Admin user can read location documents.
     * @allow (create) Admin user can create location documents.
     * @allow (update) Admin user can update location documents.
     * @allow (delete) Admin user can delete location documents.
     * @deny (get) Non-admin user cannot read location documents.
     * @deny (create) Non-admin user cannot create location documents.
     * @principle Restricts location data access to admins only.
     */
    match /locations/{locationId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Rules for employee action documents within a staff member's subcollection.
     * @path /staff/{staffId}/employeeActions/{employeeActionId}
     * @allow (get) Authenticated staff member can read their own employee actions: request.auth.uid == staffId
     * @allow (create) Authenticated staff member can create employee actions under their own profile: request.auth.uid == staffId
     * @allow (update) Authenticated staff member can update their own employee actions: request.auth.uid == staffId
     * @allow (delete) Authenticated staff member can delete their own employee actions: request.auth.uid == staffId
     * @deny (get) Authenticated staff member cannot read another staff member's employee actions: request.auth.uid != staffId
     * @deny (create) Unauthenticated user cannot create employee actions: request.auth == null
     * @principle Enforces ownership for employee actions within a staff member's profile.
     */
    match /staff/{staffId}/employeeActions/{employeeActionId} {
      allow get: if isSignedIn() && (isOwner(staffId) || isAdmin());
      allow list: if isSignedIn() && (isOwner(staffId) || isAdmin());
      allow create: if isSignedIn() && isOwner(staffId) && request.resource.data.staffId == staffId;
      allow update: if isExistingOwner(staffId) && request.resource.data.staffId == resource.data.staffId;
      allow delete: if isExistingOwner(staffId);
    }

    /**
     * @description Rules for admin role documents.
     * @path /roles_admin/{uid}
     * @allow (get) Anyone can get a role.
     * @allow (create) Only a service account can create roles. // TODO
     * @allow (update) No one can update roles.
     * @allow (delete) Only a service account can delete roles. // TODO
     * @principle DBAC: Existence of document grants admin role.
     */
    match /roles_admin/{uid} {
        allow get: if isAdmin();
        allow list: if false;
        allow create: if false; // TODO: Only allow create from a trusted server environment or service account
        allow update: if false;
        allow delete: if false; // TODO: Only allow delete from a trusted server environment or service account
    }
  }
}