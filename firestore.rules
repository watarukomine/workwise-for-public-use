/**
 * @fileoverview Firestore Security Rules for WorkWise application.
 *
 * Core Philosophy:
 * This ruleset prioritizes strong authorization by enforcing strict ownership and role-based access control where appropriate.
 * It leverages denormalization to avoid costly `get()` calls and maintain atomic security checks.
 * The rules are designed to be auditable and maintainable through the use of helper functions.
 *
 * Data Structure:
 * - /staff/{staffId}: Stores staff member data, accessible only to the staff member themselves.
 * - /customers/{customerId}: Stores customer data. Write access is denied, read access is public.
 * - /locations/{locationId}: Stores location data. Write access is denied, read access is public.
 * - /workSchedules/{workScheduleId}: Stores work schedule data, accessible only to the staff member associated with the schedule.
 * - /employeeActions/{employeeActionId}: Stores employee action data, accessible only to the staff member who performed the action.
 *
 * Key Security Decisions:
 * - User listing is generally disallowed unless explicitly required and secured.
 * - Data validation is limited to fields crucial for authorization and relational integrity, allowing for rapid prototyping and schema evolution.
 * - All write operations are protected by authorization checks to prevent unauthorized data modification.
 *
 * Denormalization for Authorization:
 * - The `WorkSchedule` entity includes `staffId` to allow direct authorization against the associated staff member.
 * - The `EmployeeAction` entity includes `staffId` to allow direct authorization against the staff member who performed the action.
 *
 * Structural Segregation:
 *  Each entity resides in its own dedicated collection, with clear ownership or association established through fields like `staffId`.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to staff member documents.
     * @path /staff/{staffId}
     * @allow (create) - Authenticated user can create their own staff document if the staffId matches their UID.
     * @allow (get, list, update, delete) - Authenticated user can only access their own staff document.
     * @deny (create) - Non-authenticated user attempts to create a staff document.
     * @deny (update, delete) - Authenticated user attempts to modify another user's staff document.
     * @principle Enforces document ownership for all operations on staff documents.
     */
    match /staff/{staffId} {
      function isOwner(staffId) {
        return request.auth != null && request.auth.uid == staffId;
      }

      function isExistingOwner(staffId) {
        return isOwner(staffId) && resource != null;
      }

      allow get: if isOwner(staffId);
      allow list: if isOwner(staffId);
      allow create: if isOwner(staffId);
      allow update: if isExistingOwner(staffId);
      allow delete: if isExistingOwner(staffId);
    }

    /**
     * @description Controls access to customer documents. Customers should be readable by all and only created by the system.
     * @path /customers/{customerId}
     * @allow (get, list) - Public read access for all customer documents.
     * @deny (create, update, delete) - No user can create, update, or delete customer documents.
     * @principle Restricts write access to customer documents, allowing only read access.
     */
    match /customers/{customerId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to location documents. Locations should be readable by all and only created by the system.
     * @path /locations/{locationId}
     * @allow (get, list) - Public read access for all location documents.
     * @deny (create, update, delete) - No user can create, update, or delete location documents.
     * @principle Restricts write access to location documents, allowing only read access.
     */
    match /locations/{locationId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to work schedule documents, ensuring only associated staff can access.
     * @path /workSchedules/{workScheduleId}
     * @allow (create) - Authenticated user can create their own work schedule document if the staffId matches their UID.
     * @allow (get, list, update, delete) - Authenticated user can only access work schedule documents associated with their staff ID.
     * @deny (create) - Non-authenticated user attempts to create a work schedule document.
     * @deny (update, delete) - Authenticated user attempts to modify a work schedule document not associated with their staff ID.
     * @principle Enforces document ownership for all operations on work schedule documents.
     */
    match /workSchedules/{workScheduleId} {
        function getStaffId() {
            return request.resource.data.staffId;
        }
        function isOwner(staffId) {
          return request.auth != null && request.auth.uid == staffId;
        }
        function isExistingOwner(staffId) {
          return isOwner(staffId) && resource != null;
        }

        allow get: if isOwner(resource.data.staffId);
        allow list: if isOwner(get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.id);
        allow create: if isOwner(getStaffId());
        allow update: if isExistingOwner(resource.data.staffId);
        allow delete: if isExistingOwner(resource.data.staffId);
    }

    /**
     * @description Controls access to employee action documents, ensuring only the acting staff member can access.
     * @path /employeeActions/{employeeActionId}
     * @allow (create) - Authenticated user can create their own employee action document if the staffId matches their UID.
     * @allow (get, list, update, delete) - Authenticated user can only access employee action documents associated with their staff ID.
     * @deny (create) - Non-authenticated user attempts to create an employee action document.
     * @deny (update, delete) - Authenticated user attempts to modify an employee action document not associated with their staff ID.
     * @principle Enforces document ownership for all operations on employee action documents.
     */
    match /employeeActions/{employeeActionId} {
        function getStaffId() {
            return request.resource.data.staffId;
        }
        function isOwner(staffId) {
          return request.auth != null && request.auth.uid == staffId;
        }
        function isExistingOwner(staffId) {
          return isOwner(staffId) && resource != null;
        }

        allow get: if isOwner(resource.data.staffId);
        allow list: if isOwner(get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.id);
        allow create: if isOwner(getStaffId());
        allow update: if isExistingOwner(resource.data.staffId);
        allow delete: if isExistingOwner(resource.data.staffId);
    }
  }
}