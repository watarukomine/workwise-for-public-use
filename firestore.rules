/**
 * @file Firebase Security Rules for WorkWise Application
 *
 * @core_philosophy This ruleset enforces a combination of user-based ownership and administrative control.
 *   Staff members have full access to their own data (profile and actions), while administrative roles
 *   are required to manage customer, schedule, and location data. Admin privileges are granted based on
 *   the existence of a document in the `/roles_admin/{uid}` collection, where {uid} matches the Firebase auth UID.
 *   All write operations are secured with authorization checks.
 *
 * @data_structure
 *   - `/staff/{staffId}`: Stores profile information for each staff member. Only the staff member themselves can modify this data.
 *   - `/customers/{customerId}`: Stores customer information. Only admins can manage customer data.
 *   - `/workSchedules/{workScheduleId}`: Stores work schedule data. Only admins can manage work schedules.
 *   - `/locations/{locationId}`: Stores location data. Only admins can manage location data.
 *   - `/staff/{staffId}/employeeActions/{employeeActionId}`: Stores employee action logs. Only the staff member themselves can access these logs.
 *   - `/roles_admin/{uid}`: Indicates admin privileges for a user. The existence of a document at this path grants admin rights.
 *
 * @key_security_decisions
 *   - User listing is disallowed across the board for privacy.
 *   - Admin privileges are determined by the existence of a document in `/roles_admin/{uid}`.
 *   - All data is private by default, and explicit rules are required to grant access.
 *
 * @denormalization_for_authorization
 *   - N/A: Current data model does not require denormalization for authorization. The admin role
 *     is checked via the existence of a document in the `/roles_admin/{uid}` collection.
 *
 * @structural_segregation
 *   - N/A: There are no public vs. private versions of the same data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure read and write access to Staff documents. Only the staff member themselves can read or write their own profile.
     * @path /staff/{staffId}
     * @allow (get, update, delete) if the user is signed in and their UID matches the staffId.
     * @allow (create) if the user is signed in and their UID matches the staffId.
     * @deny (get, update, delete) if the user is not signed in or their UID does not match the staffId.
     * @deny (create) if the user is not signed in or their UID does not match the staffId.
     * @principle Enforces document ownership for writes.
     */
    match /staff/{staffId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(staffId);
      allow list: if false;

      allow create: if isOwner(staffId) && request.resource.data.id == staffId;
      allow update: if isExistingOwner(staffId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(staffId);
    }

    /**
     * @description Secure read and write access to Customer documents. Only admins can manage customer data.
     * @path /customers/{customerId}
     * @allow (get, list, create, update, delete) if the user is an admin.
     * @deny (get, list, create, update, delete) if the user is not an admin.
     * @principle Restricts access to admins.
     */
    match /customers/{customerId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isAdmin() {
        return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      allow get: if isAdmin();
      allow list: if isAdmin();

      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Secure read and write access to WorkSchedule documents. Only admins can manage work schedule data.
     * @path /workSchedules/{workScheduleId}
     * @allow (get, list, create, update, delete) if the user is an admin.
     * @deny (get, list, create, update, delete) if the user is not an admin.
     * @principle Restricts access to admins.
     */
    match /workSchedules/{workScheduleId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isAdmin() {
        return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      allow get: if isAdmin();
      allow list: if isAdmin();

      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Secure read and write access to Location documents. Only admins can manage location data.
     * @path /locations/{locationId}
     * @allow (get, list, create, update, delete) if the user is an admin.
     * @deny (get, list, create, update, delete) if the user is not an admin.
     * @principle Restricts access to admins.
     */
    match /locations/{locationId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isAdmin() {
        return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      allow get: if isAdmin();
      allow list: if isAdmin();

      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Secure read and write access to EmployeeAction documents. Only the staff member themselves can read or write their own action history.
     * @path /staff/{staffId}/employeeActions/{employeeActionId}
     * @allow (get, update, delete) if the user is signed in and their UID matches the staffId.
     * @allow (create) if the user is signed in and their UID matches the staffId.
     * @deny (get, update, delete) if the user is not signed in or their UID does not match the staffId.
     * @deny (create) if the user is not signed in or their UID does not match the staffId.
     * @principle Enforces document ownership for writes.
     */
    match /staff/{staffId}/employeeActions/{employeeActionId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

       function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(staffId);
      allow list: if isOwner(staffId);

      allow create: if isOwner(staffId);
      allow update: if isExistingOwner(staffId);
      allow delete: if isExistingOwner(staffId);
    }

    /**
     * @description Secure the admin role document.  Only a user whose auth ID matches the document ID can create this document, effectively granting themselves admin rights.
     * @path /roles_admin/{uid}
     * @allow (create) if the user is signed in and their UID matches the uid parameter.
     * @deny (get, list, update, delete) to prevent unauthorized access or modification.
     * @principle Restricts admin role creation to the user themselves.
     */
    match /roles_admin/{uid} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if false;
      allow list: if false;

      allow create: if isOwner(uid);
      allow update: if false;
      allow delete: if isExistingOwner(uid);
    }
  }
}