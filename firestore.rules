/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for staff-related data,
 * allowing staff members to read and write only their own data. Customer and jobsite data
 * is accessible to authorized users. This approach ensures data privacy and
 * prevents unauthorized access.
 *
 * Data Structure:
 * - /staff/{staffId}: Stores individual staff member profiles.
 * - /customers/{customerId}: Stores customer information.
 * - /staff/{staffId}/workSchedules/{workScheduleId}: Stores work schedules for specific staff members.
 * - /jobsites/{jobsiteId}: Stores jobsite data with geocoding information.
 * - /staff/{staffId}/employeeActions/{employeeActionId}: Stores actions performed by employees.
 *
 * Key Security Decisions:
 * - Staff members can only manage their own profiles and associated data (work schedules, employee actions).
 * - Customer and jobsite information is accessible to all authorized users.
 * - Listing of users is disallowed.
 *
 * Denormalization for Authorization:
 *  - The current data model uses path-based authorization, where the staffId is embedded in the document path.
 *  This approach simplifies the security rules and avoids the need for complex queries or data lookups.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to staff member profiles.
     * @path /staff/{staffId}
     * @allow (create) - If the authenticated user's ID matches the staffId.
     * @allow (get, update, delete) - If the authenticated user's ID matches the staffId.
     * @deny (create, get, update, delete) - If the authenticated user is not authenticated.
     * @deny (create, get, update, delete) - If the authenticated user's ID does not match the staffId.
     * @principle Enforces document ownership for staff profiles.
     */
    match /staff/{staffId} {
      allow get: if isSignedIn() && isOwner(staffId);
      allow list: if false; // Listing users is not permitted.
      allow create: if isSignedIn() && isOwner(staffId);
      allow update: if isSignedIn() && isExistingOwner(staffId);
      allow delete: if isSignedIn() && isExistingOwner(staffId);
    }

    /**
     * @description Controls access to customer data.
     * @path /customers/{customerId}
     * @allow (get, list) - All authenticated users can read customer data.
     * @allow (create, update, delete) - Only authenticated users can create, update or delete customer data.
     * @deny (create, get, update, delete) - If the user is not authenticated.
     * @principle Authenticated users can manage customer data.
     */
    match /customers/{customerId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Controls access to work schedules for a specific staff member.
     * @path /staff/{staffId}/workSchedules/{workScheduleId}
     * @allow (create, get, update, delete) - If the authenticated user's ID matches the staffId.
     * @deny (create, get, update, delete) - If the authenticated user's ID does not match the staffId.
     * @principle Enforces document ownership for work schedules.
     */
    match /staff/{staffId}/workSchedules/{workScheduleId} {
      allow get, list: if isSignedIn() && isOwner(staffId);
      allow create: if isSignedIn() && isOwner(staffId);
      allow update: if isSignedIn() && isExistingOwner(staffId);
      allow delete: if isSignedIn() && isExistingOwner(staffId);
    }

    /**
     * @description Controls access to jobsite data.
     * @path /jobsites/{jobsiteId}
     * @allow (get, list) - All authenticated users can read jobsite data.
     * @allow (create, update, delete) - Only authenticated users can create, update or delete jobsite data.
     * @deny (create, get, update, delete) - If the user is not authenticated.
     * @principle Authenticated users can manage jobsite data.
     */
    match /jobsites/{jobsiteId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Controls access to employee actions for a specific staff member.
     * @path /staff/{staffId}/employeeActions/{employeeActionId}
     * @allow (create, get, update, delete) - If the authenticated user's ID matches the staffId.
     * @deny (create, get, update, delete) - If the authenticated user's ID does not match the staffId.
     * @principle Enforces document ownership for employee actions.
     */
    match /staff/{staffId}/employeeActions/{employeeActionId} {
      allow get, list: if isSignedIn() && isOwner(staffId);
      allow create: if isSignedIn() && isOwner(staffId);
      allow update: if isSignedIn() && isExistingOwner(staffId);
      allow delete: if isSignedIn() && isExistingOwner(staffId);
    }

    // --- Helper Functions ---

    /**
     * @description Checks if the user is signed in.
     * @return {bool} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user is the owner of the document.
     * @param {string} userId The user ID to compare against.
     * @return {bool} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the owner of the document and the document exists.
     * @param {string} userId The user ID to compare against.
     * @return {bool} True if the user is the owner and the document exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
  }
}