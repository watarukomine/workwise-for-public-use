/**
 * @fileoverview Firestore Security Rules for WorkWise application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for staff-related data
 * (work schedules, employee actions), and open access for locations and customers.
 * The `staff` collection uses path-based ownership.
 *
 * Data Structure:
 * - `/staff/{staffId}`: Stores staff member profiles, accessible only by the staff member themselves.
 * - `/customers/{customerId}`: Stores customer profiles. Publicly readable.
 * - `/staff/{staffId}/workSchedules/{workScheduleId}`: Stores work schedules for each staff member,
 *   accessible only by the staff member themselves.
 * - `/locations/{locationId}`: Stores location information. Publicly readable.
 * - `/staff/{staffId}/employeeActions/{employeeActionId}`: Stores employee actions for each staff member,
 *   accessible only by the staff member themselves.
 *
 * Key Security Decisions:
 * - User listing is disallowed in all collections except for locations and customers.
 * - Ownership is validated on create and enforced immutably on update for user-owned data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows staff members to manage their own profiles.
     * @path /staff/{staffId}
     * @allow (create) - User with UID 'user_abc' can create a staff document if staffId == 'user_abc'.
     * @allow (get, update, delete) - User with UID 'user_abc' can get, update, and delete their staff document if staffId == 'user_abc'.
     * @deny (create) - User with UID 'user_def' cannot create a staff document with staffId == 'user_abc'.
     * @deny (get, update, delete) - User with UID 'user_def' cannot get, update, or delete staff document with staffId == 'user_abc'.
     * @principle Enforces document ownership for writes.
     */
    match /staff/{staffId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(staffId) {
        return isSignedIn() && request.auth.uid == staffId;
      }

      function isExistingOwner(staffId) {
          return isOwner(staffId) && resource != null;
      }

      allow get: if isOwner(staffId);
      allow list: if false;
      allow create: if isOwner(staffId);
      allow update: if isExistingOwner(staffId);
      allow delete: if isExistingOwner(staffId);
    }

    /**
     * @description Allows public read access to customer profiles.
     * @path /customers/{customerId}
     * @allow (get, list) - Any user can read customer profiles.
     * @deny (create, update, delete) - No user can create, update, or delete customer profiles.
     * @principle Allows public read access with no write access.
     */
    match /customers/{customerId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows staff members to manage their own work schedules.
     * @path /staff/{staffId}/workSchedules/{workScheduleId}
     * @allow (create) - User with UID 'user_abc' can create a work schedule under /staff/user_abc.
     * @allow (get, update, delete) - User with UID 'user_abc' can get, update and delete work schedules under /staff/user_abc.
     * @deny (create) - User with UID 'user_def' cannot create a work schedule under /staff/user_abc.
     * @deny (get, update, delete) - User with UID 'user_def' cannot get, update or delete work schedules under /staff/user_abc.
     * @principle Enforces document ownership for writes.
     */
    match /staff/{staffId}/workSchedules/{workScheduleId} {
        function isSignedIn() {
          return request.auth != null;
        }

        function isOwner(staffId) {
          return isSignedIn() && request.auth.uid == staffId;
        }

        function isExistingOwner(staffId) {
            return isOwner(staffId) && resource != null;
        }

        allow get: if isOwner(staffId);
        allow list: if isOwner(staffId);
        allow create: if isOwner(staffId);
        allow update: if isExistingOwner(staffId);
        allow delete: if isExistingOwner(staffId);
    }

    /**
     * @description Allows public read access to location information.
     * @path /locations/{locationId}
     * @allow (get, list) - Any user can read location information.
     * @deny (create, update, delete) - No user can create, update, or delete location information.
     * @principle Allows public read access with no write access.
     */
    match /locations/{locationId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows staff members to manage their own employee actions.
     * @path /staff/{staffId}/employeeActions/{employeeActionId}
     * @allow (create) - User with UID 'user_abc' can create an employee action under /staff/user_abc.
     * @allow (get, update, delete) - User with UID 'user_abc' can get, update and delete employee actions under /staff/user_abc.
     * @deny (create) - User with UID 'user_def' cannot create an employee action under /staff/user_abc.
     * @deny (get, update, delete) - User with UID 'user_def' cannot get, update or delete employee actions under /staff/user_abc.
     * @principle Enforces document ownership for writes.
     */
    match /staff/{staffId}/employeeActions/{employeeActionId} {
        function isSignedIn() {
          return request.auth != null;
        }

        function isOwner(staffId) {
          return isSignedIn() && request.auth.uid == staffId;
        }

        function isExistingOwner(staffId) {
            return isOwner(staffId) && resource != null;
        }

        allow get: if isOwner(staffId);
        allow list: if isOwner(staffId);
        allow create: if isOwner(staffId);
        allow update: if isExistingOwner(staffId);
        allow delete: if isExistingOwner(staffId);
    }
  }
}