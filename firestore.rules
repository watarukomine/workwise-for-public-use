/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for staff data and general authorization for customers and jobsites.
 *
 * Data Structure:
 * - /staff/{staffId}: Stores individual staff member data, accessible only by the staff member themselves.
 * - /customers/{customerId}: Stores customer data, accessible by any authenticated user.
 * - /staff/{staffId}/workSchedules/{workScheduleId}: Stores work schedules for a staff member, accessible only by that staff member.
 * - /jobsites/{jobsiteId}: Stores jobsite data, accessible by any authenticated user.
 * - /staff/{staffId}/employeeActions/{employeeActionId}: Stores employee actions, accessible only by the staff member.
 *
 * Key Security Decisions:
 * - User listing is enabled for `/staff`, `/customers`, and `/jobsites`, assuming that there is no sensitive data there.
 * - Only authenticated users can access data.
 *
 * Denormalization for Authorization:
 * - None specified in this ruleset.
 *
 * Structural Segregation:
 * - User-specific data (workSchedules, employeeActions) is stored in subcollections under the user's document to enforce ownership.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows staff members to read and write their own data.
     * @path /staff/{staffId}
     * @allow (get, list) if isSignedIn() && isOwner(staffId)
     * @allow (create, update, delete) if isSignedIn() && isOwner(staffId)
     * @deny (create) if !isSignedIn() || !isOwner(staffId)
     * @deny (update, delete) if !isSignedIn() || !isExistingOwner(staffId)
     * @principle Enforces document ownership for writes.
     */
    match /staff/{staffId} {
      allow get: if isSignedIn() && isOwner(staffId);
      allow list: if true;
      allow create: if isSignedIn() && isOwner(staffId);
      allow update: if isSignedIn() && isExistingOwner(staffId);
      allow delete: if isSignedIn() && isExistingOwner(staffId);
    }

    /**
     * @description Allows authenticated users to read customer data.
     * @path /customers/{customerId}
     * @allow (get, list) if isSignedIn()
     * @allow (create, update, delete) if isSignedIn()
     * @deny (create, update, delete) if !isSignedIn()
     * @principle Allows general access to customer data for authenticated users.
     */
    match /customers/{customerId} {
      allow get: if isSignedIn();
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Allows staff members to manage their own work schedules.
     * @path /staff/{staffId}/workSchedules/{workScheduleId}
     * @allow (get, list) if isSignedIn() && isOwner(staffId)
     * @allow (create, update, delete) if isSignedIn() && isOwner(staffId)
     * @deny (create) if !isSignedIn() || !isOwner(staffId)
     * @deny (update, delete) if !isSignedIn() || !isExistingOwner(staffId)
     * @principle Restricts access to a user's own data tree.
     */
    match /staff/{staffId}/workSchedules/{workScheduleId} {
      allow get: if isSignedIn() && isOwner(staffId);
      allow list: if isSignedIn() && isOwner(staffId);
      allow create: if isSignedIn() && isOwner(staffId);
      allow update: if isSignedIn() && isExistingOwner(staffId);
      allow delete: if isSignedIn() && isExistingOwner(staffId);
    }

    /**
     * @description Allows authenticated users to read jobsite data.
     * @path /jobsites/{jobsiteId}
     * @allow (get, list) if isSignedIn()
     * @allow (create, update, delete) if isSignedIn()
     * @deny (create, update, delete) if !isSignedIn()
     * @principle Allows general access to jobsite data for authenticated users.
     */
    match /jobsites/{jobsiteId} {
      allow get: if isSignedIn();
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Allows staff members to manage their own employee actions.
     * @path /staff/{staffId}/employeeActions/{employeeActionId}
     * @allow (get, list) if isSignedIn() && isOwner(staffId)
     * @allow (create, update, delete) if isSignedIn() && isOwner(staffId)
     * @deny (create) if !isSignedIn() || !isOwner(staffId)
     * @deny (update, delete) if !isSignedIn() || !isExistingOwner(staffId)
     * @principle Restricts access to a user's own data tree.
     */
    match /staff/{staffId}/employeeActions/{employeeActionId} {
      allow get: if isSignedIn() && isOwner(staffId);
      allow list: if isSignedIn() && isOwner(staffId);
      allow create: if isSignedIn() && isOwner(staffId);
      allow update: if isSignedIn() && isExistingOwner(staffId);
      allow delete: if isSignedIn() && isExistingOwner(staffId);
    }

    /**
     * @description Allows listing status for staff.
     * @path /staffStatus
     * @allow list if isSignedIn()
     * @deny get, create, update, delete
     * @principle Allows list status for staff members that are signed in.
     */
    match /staffStatus {
        allow list: if isSignedIn();
        allow get: if false;
        allow create: if false;
        allow update: if false;
        allow delete: if false;
    }
  }

  // Helper functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }

  function isExistingOwner(userId) {
      return isSignedIn() && isOwner(userId) && resource != null;
  }
}