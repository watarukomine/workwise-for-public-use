/**
 * @file Firestore Security Rules for WorkWise Application
 * @description This ruleset enforces a role-based access control model, with path-based ownership for staff data and admin-only access for customer, work schedule, and location data.
 *
 * Data Structure:
 * - /staff/{staffId}: Stores personal staff information; accessible only by the staff member themselves.
 * - /customers/{customerId}: Stores customer details; accessible only by admins.
 * - /workSchedules/{workScheduleId}: Stores work schedules; accessible only by admins.
 * - /locations/{locationId}: Stores location information; accessible only by admins.
 * - /staff/{staffId}/employeeActions/{employeeActionId}: Stores employee action logs; accessible only by the staff member.
 * - /roles_admin/{uid}: Indicates admin status; existence of the document grants admin privileges.
 *
 * Key Security Decisions:
 * - Admins are granted full access to customer, work schedule, and location data.
 * - Staff members can only access their own staff data and their employee action logs.
 * - Listing of customers, work schedules, and locations is denied to non-admins.
 * - Admin status is determined by the existence of a document in the `roles_admin` collection.
 * - Data shape is not strictly enforced in this prototyping phase to allow for rapid schema iteration.
 *
 * Denormalization for Authorization:
 * - The rules use the existence of a document in `/roles_admin/{uid}` to determine admin status, avoiding complex queries during rule evaluation.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is the owner of the document based on the `staffId` path parameter.
     * @param {string} staffId The staff ID to compare against the request's auth UID.
     * @return {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(staffId) {
      return isSignedIn() && request.auth.uid == staffId;
    }

    /**
     * @description Checks if the user is the owner of the existing document.
     * @param {string} staffId The staff ID to compare against the request's auth UID.
     * @return {boolean} True if the user is the owner and the document exists, false otherwise.
     */
    function isExistingOwner(staffId) {
      return isOwner(staffId) && resource != null;
    }

    /**
     * @description Checks if the user is an admin by verifying the existence of a document in the `roles_admin` collection.
     * @return {boolean} True if the user is an admin, false otherwise.
     */
    function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * @description Rule for the staff collection.
     * @path /staff/{staffId}
     * @allow (create) User with UID 'SoYoYTKtacdwxlsnKJKj7YCBrOo1' can create a staff document with staffId: 'SoYoYTKtacdwxlsnKJKj7YCBrOo1'.
     * @allow (get) User with UID 'SoYoYTKtacdwxlsnKJKj7YCBrOo1' can get their own staff document.
     * @allow (update) User with UID 'SoYoYTKtacdwxlsnKJKj7YCBrOo1' can update their own staff document if it exists.
     * @allow (delete) User with UID 'SoYoYTKtacdwxlsnKJKj7YCBrOo1' can delete their own staff document if it exists.
     * @deny (create) User with UID 'SoYoYTKtacdwxlsnKJKj7YCBrOo2' cannot create a staff document with staffId: 'SoYoYTKtacdwxlsnKJKj7YCBrOo1'.
     * @deny (get) User with UID 'SoYoYTKtacdwxlsnKJKj7YCBrOo2' cannot get staff document of user 'SoYoYTKtacdwxlsnKJKj7YCBrOo1'.
     * @principle Enforces document ownership for writes.
     */
    match /staff/{staffId} {
      allow get: if isOwner(staffId);
      allow list: if false;

      allow create: if isOwner(staffId) && request.resource.data.id == staffId;
      allow update: if isExistingOwner(staffId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(staffId);
    }

    /**
     * @description Rule for the customers collection.
     * @path /customers/{customerId}
     * @allow (create) Admins can create customer documents.
     * @allow (get) Admins can get customer documents.
     * @allow (list) Admins can list customer documents.
     * @allow (update) Admins can update customer documents.
     * @allow (delete) Admins can delete customer documents.
     * @deny (create) Non-admins cannot create customer documents.
     * @deny (get) Non-admins cannot get customer documents.
     * @deny (update) Non-admins cannot update customer documents.
     * @deny (delete) Non-admins cannot delete customer documents.
     * @principle Restricts access to admins.
     */
    match /customers/{customerId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Rule for the workSchedules collection.
     * @path /workSchedules/{workScheduleId}
     * @allow (create) Admins can create work schedule documents.
     * @allow (get) Admins can get work schedule documents.
     * @allow (list) Admins can list work schedule documents.
     * @allow (update) Admins can update work schedule documents.
     * @allow (delete) Admins can delete work schedule documents.
     * @deny (create) Non-admins cannot create work schedule documents.
     * @deny (get) Non-admins cannot get work schedule documents.
     * @deny (update) Non-admins cannot update work schedule documents.
     * @deny (delete) Non-admins cannot delete work schedule documents.
     * @principle Restricts access to admins.
     */
    match /workSchedules/{workScheduleId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Rule for the locations collection.
     * @path /locations/{locationId}
     * @allow (create) Admins can create location documents.
     * @allow (get) Admins can get location documents.
     * @allow (list) Admins can list location documents.
     * @allow (update) Admins can update location documents.
     * @allow (delete) Admins can delete location documents.
     * @deny (create) Non-admins cannot create location documents.
     * @deny (get) Non-admins cannot get location documents.
     * @deny (update) Non-admins cannot update location documents.
     * @deny (delete) Non-admins cannot delete location documents.
     * @principle Restricts access to admins.
     */
    match /locations/{locationId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Rule for the employeeActions subcollection under staff.
     * @path /staff/{staffId}/employeeActions/{employeeActionId}
     * @allow (create) User with UID 'SoYoYTKtacdwxlsnKJKj7YCBrOo1' can create an employeeAction document under their staff document.
     * @allow (get) User with UID 'SoYoYTKtacdwxlsnKJKj7YCBrOo1' can get their own employeeAction document.
     * @allow (list) User with UID 'SoYoYTKtacdwxlsnKJKj7YCBrOo1' can list their own employeeAction documents.
     * @allow (update) User with UID 'SoYoYTKtacdwxlsnKJKj7YCBrOo1' can update their own employeeAction document if it exists.
     * @allow (delete) User with UID 'SoYoYTKtacdwxlsnKJKj7YCBrOo1' can delete their own employeeAction document if it exists.
     * @deny (create) User with UID 'SoYoYTKtacdwxlsnKJKj7YCBrOo2' cannot create an employeeAction document under staff 'SoYoYTKtacdwxlsnKJKj7YCBrOo1'.
     * @deny (get) User with UID 'SoYoYTKtacdwxlsnKJKj7YCBrOo2' cannot get employeeAction document of staff 'SoYoYTKtacdwxlsnKJKj7YCBrOo1'.
     * @principle Enforces document ownership for writes in subcollection.
     */
    match /staff/{staffId}/employeeActions/{employeeActionId} {
      allow get: if isOwner(staffId);
      allow list: if isOwner(staffId);
      allow create: if isOwner(staffId);
      allow update: if isExistingOwner(staffId);
      allow delete: if isExistingOwner(staffId);
    }

    /**
     * @description Rule for the roles_admin collection.
     * @path /roles_admin/{uid}
     * @allow (create) Only accessible to backend to create the admin roles.
     * @allow (get) Only accessible to backend to create the admin roles.
     * @allow (update) Only accessible to backend to create the admin roles.
     * @allow (delete) Only accessible to backend to create the admin roles.
     * @principle Restricts access to admins.
     */
     match /roles_admin/{uid} {
        allow get: if false;
        allow list: if false;
        allow create: if false;
        allow update: if false;
        allow delete: if false;
     }
  }
}