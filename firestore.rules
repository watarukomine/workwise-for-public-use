/**
 * @fileoverview Firestore Security Rules for WorkWise application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for staff-related data,
 * allowing staff members to manage their own work schedules and employee actions.
 * Customer and location data are publicly readable but only writable by authorized users.
 *
 * Data Structure:
 * - /staff/{staffId}: Stores staff profiles, accessible only by the staff member themselves.
 * - /customers/{customerId}: Stores customer profiles, publicly readable.
 * - /staff/{staffId}/workSchedules/{workScheduleId}: Stores work schedules for staff, accessible only by the staff member.
 * - /locations/{locationId}: Stores location information, publicly readable.
 * - /staff/{staffId}/employeeActions/{employeeActionId}: Stores employee actions, accessible only by the staff member.
 *
 * Key Security Decisions:
 * - Staff members can only manage data directly associated with their own staff ID.
 * - Listing of customers and locations is allowed for all users (including unauthenticated users).
 *
 * Denormalization for Authorization:
 *  - Path-based ownership is leveraged to avoid denormalization.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     * @param {string} userId The user's ID.
     * @returns {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user is the owner of the resource.
     * @param {string} userId The user's ID.
     * @returns {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the owner of the resource and the resource exists.
     * @param {string} userId The user's ID.
     * @returns {boolean} True if the user is the owner and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Rules for staff profiles.
     * @path /staff/{staffId}
     * @allow (create) User with ID 'staffId' can create their own profile.
     * @deny (create) User with ID 'otherUserId' cannot create a profile with staffId = 'staffId'.
     * @allow (get) User with ID 'staffId' can get their profile.
     * @deny (get) User with ID 'otherUserId' cannot get the profile of staffId = 'staffId'.
     * @allow (update) User with ID 'staffId' can update their profile.
     * @deny (update) User with ID 'otherUserId' cannot update the profile of staffId = 'staffId'.
     * @allow (delete) User with ID 'staffId' can delete their profile.
     * @deny (delete) User with ID 'otherUserId' cannot delete the profile of staffId = 'staffId'.
     * @principle Enforces document ownership for writes.
     */
    match /staff/{staffId} {
      allow get: if isOwner(staffId);
      allow list: if false;
      allow create: if isOwner(staffId) && request.resource.data.id == staffId;
      allow update: if isExistingOwner(staffId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(staffId);
    }

    /**
     * @description Rules for customer profiles.
     * @path /customers/{customerId}
     * @allow (get, list) Any user can read customer profiles.
     * @deny (create, update, delete) No one can create, update, or delete customer profiles.
     * @principle Public read, owner-only writes (currently disabled, as no owner is defined).
     */
    match /customers/{customerId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Rules for work schedules.
     * @path /staff/{staffId}/workSchedules/{workScheduleId}
     * @allow (create) User with ID 'staffId' can create work schedules for themselves.
     * @deny (create) User with ID 'otherUserId' cannot create work schedules for staffId = 'staffId'.
     * @allow (get) User with ID 'staffId' can get their own work schedules.
     * @deny (get) User with ID 'otherUserId' cannot get the work schedules of staffId = 'staffId'.
     * @allow (update) User with ID 'staffId' can update their own work schedules.
     * @deny (update) User with ID 'otherUserId' cannot update the work schedules of staffId = 'staffId'.
     * @allow (delete) User with ID 'staffId' can delete their own work schedules.
     * @deny (delete) User with ID 'otherUserId' cannot delete the work schedules of staffId = 'staffId'.
     * @principle Enforces document ownership for writes.
     */
    match /staff/{staffId}/workSchedules/{workScheduleId} {
      allow get: if isOwner(staffId);
      allow list: if isOwner(staffId);
      allow create: if isOwner(staffId) && request.resource.data.staffId == staffId;
      allow update: if isExistingOwner(staffId) && request.resource.data.staffId == resource.data.staffId;
      allow delete: if isExistingOwner(staffId);
    }

    /**
     * @description Rules for location information.
     * @path /locations/{locationId}
     * @allow (get, list) Any user can read location information.
     * @deny (create, update, delete) No one can create, update, or delete location information.
     * @principle Public read, owner-only writes (currently disabled, as no owner is defined).
     */
    match /locations/{locationId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Rules for employee actions.
     * @path /staff/{staffId}/employeeActions/{employeeActionId}
     * @allow (create) User with ID 'staffId' can create employee actions for themselves.
     * @deny (create) User with ID 'otherUserId' cannot create employee actions for staffId = 'staffId'.
     * @allow (get) User with ID 'staffId' can get their own employee actions.
     * @deny (get) User with ID 'otherUserId' cannot get the employee actions of staffId = 'staffId'.
     * @allow (update) User with ID 'staffId' can update their own employee actions.
     * @deny (update) User with ID 'otherUserId' cannot update the employee actions of staffId = 'staffId'.
     * @allow (delete) User with ID 'staffId' can delete their own employee actions.
     * @deny (delete) User with ID 'otherUserId' cannot delete the employee actions of staffId = 'staffId'.
     * @principle Enforces document ownership for writes.
     */
    match /staff/{staffId}/employeeActions/{employeeActionId} {
      allow get: if isOwner(staffId);
      allow list: if isOwner(staffId);
      allow create: if isOwner(staffId) && request.resource.data.staffId == staffId;
      allow update: if isExistingOwner(staffId) && request.resource.data.staffId == resource.data.staffId;
      allow delete: if isExistingOwner(staffId);
    }
  }
}