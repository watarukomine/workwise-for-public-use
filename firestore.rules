/**
 * @file Firestore Security Rules
 * @description This ruleset enforces role-based access control for a work management application.
 *
 * Core Philosophy:
 * Access is strictly controlled based on user roles (admin, staff) and ownership.
 * Admins have full CRUD access to customer, schedule, and location data.
 * Staff members can only access their own profile data and associated employee actions.
 * Users can only access their own profile data.
 *
 * Data Structure:
 * - /users/{userId}: User profile information (email, displayName, role).
 * - /staff/{staffId}: Staff member profiles.
 * - /customers/{customerId}: Customer profiles.
 * - /schedules/{scheduleId}: Work schedules.
 * - /locations/{locationId}: Work locations.
 * - /staff/{staffId}/employee_actions/{employeeActionId}: Employee action logs.
 *
 * Key Security Decisions:
 * - User listing is disabled.
 * - Data validation is limited to essential authorization checks in this prototyping phase.
 * - All write operations are protected by authorization checks.
 *
 * Role Definitions:
 * - Admin: Has full CRUD access to customer, schedule, and location data.
 * - Staff: Can only access their own profile data and associated employee actions.
 * - User: Can only access their own profile data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows a user to read/write their own profile.
     * @path /users/{userId}
     * @allow (create) request.auth.uid == userId
     * @allow (get, update, delete) request.auth.uid == userId
     * @deny (create) request.auth == null
     * @deny (get, update, delete) request.auth == null || request.auth.uid != userId
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.email is string;
      allow update: if isOwner(userId) && resource.data.email == request.resource.data.email;
      allow delete: if isOwner(userId);
    }

    /**
     * @description Allows a staff member to read/write their own profile data.
     * @path /staff/{staffId}
     * @allow (create) request.auth.uid == staffId
     * @allow (get, update, delete) request.auth.uid == staffId
     * @deny (create) request.auth == null
     * @deny (get, update, delete) request.auth == null || request.auth.uid != staffId
     * @principle Enforces document ownership for staff profiles.
     */
    match /staff/{staffId} {
      function isOwner(staffId) {
        return request.auth != null && request.auth.uid == staffId;
      }
      allow get: if isOwner(staffId);
      allow list: if false;
      allow create: if isOwner(staffId) && request.resource.data.id == request.auth.uid;
      allow update: if isOwner(staffId) && resource.data.id == request.auth.uid;
      allow delete: if isOwner(staffId);
    }

    /**
     * @description Allows admins to create, read, update, or delete customer profiles.
     * @path /customers/{customerId}
     * @allow (create, get, update, delete, list) request.auth.token.role == 'admin'
     * @deny (create, get, update, delete, list) request.auth.token.role != 'admin'
     * @principle Enforces role-based access control for customer profiles.
     */
    match /customers/{customerId} {
      function isAdmin() {
        return request.auth != null && request.auth.token.role == 'admin';
      }
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Allows admins to create, read, update, or delete schedules.
     * @path /schedules/{scheduleId}
     * @allow (create, get, update, delete, list) request.auth.token.role == 'admin'
     * @deny (create, get, update, delete, list) request.auth.token.role != 'admin'
     * @principle Enforces role-based access control for schedules.
     */
    match /schedules/{scheduleId} {
      function isAdmin() {
        return request.auth != null && request.auth.token.role == 'admin';
      }
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Allows admins to create, read, update, or delete locations.
     * @path /locations/{locationId}
     * @allow (create, get, update, delete, list) request.auth.token.role == 'admin'
     * @deny (create, get, update, delete, list) request.auth.token.role != 'admin'
     * @principle Enforces role-based access control for locations.
     */
    match /locations/{locationId} {
      function isAdmin() {
        return request.auth != null && request.auth.token.role == 'admin';
      }
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Allows a staff member to create, read, update, or delete their own employee actions.
     * @path /staff/{staffId}/employee_actions/{employeeActionId}
     * @allow (create) request.auth.uid == staffId
     * @allow (get, update, delete) request.auth.uid == staffId
     * @deny (create) request.auth == null
     * @deny (get, update, delete) request.auth == null || request.auth.uid != staffId
     * @principle Enforces document ownership for employee actions.
     */
    match /staff/{staffId}/employee_actions/{employeeActionId} {
      function isOwner(staffId) {
        return request.auth != null && request.auth.uid == staffId;
      }
      allow get: if isOwner(staffId);
      allow list: if isOwner(staffId);
      allow create: if isOwner(staffId) && request.resource.data.employeeId == request.auth.uid;
      allow update: if isOwner(staffId) && resource.data.employeeId == request.auth.uid;
      allow delete: if isOwner(staffId);
    }
  }
}