/**
 * @fileOverview Firestore Security Rules for Prototyping.
 *
 * Core Philosophy:
 * This ruleset prioritizes secure authorization while offering data shape flexibility for rapid prototyping.
 * It enforces strong user-based access control, ensuring that only authenticated users can access specific data.
 * Schema validation is intentionally relaxed to allow for agile data model evolution, focusing on critical
 * authorization fields instead.
 *
 * Data Structure:
 * - No user-specific data trees exist, therefore no owner-only rules can be built and enforced.
 *
 * Key Security Decisions:
 * - The rules explicitly deny potentially unsafe operations like listing all users.
 * - All write operations require authentication and are strictly controlled via `request.auth.uid`.
 * - The rules rely on the principle of least privilege, granting only the necessary permissions.
 *
 * Denormalization for Authorization:
 *   The rule lacks a user-specific path and document. No implicit ownerId exits.
 *   In order to build the owner-only pattern, the order document must include an `ownerId` that matches `request.auth.uid`.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants or denies access to orders collection. Requires the `ownerId` field
     * to match request.auth.uid.
     * @path /databases/{database}/documents/orders/{orderId}
     * @allow (create) Authenticated user creates a new order with `ownerId` matching their `uid`.
     * @deny (create) Authenticated user attempts to create an order with mismatched `ownerId` and `uid`.
     * @allow (get, list) Anyone can read order data.
     * @allow (update, delete) Authenticated user updates or deletes an order where `ownerId` matches their `uid`.
     * @deny (update, delete) Authenticated user attempts to update or delete an order with a mismatched `ownerId`.
     * @principle Enforces document ownership for writes. Allows public reads.
     */
    match /orders/{orderId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.担当スタッフID == request.auth.uid;
      allow update: if isSignedIn() && request.resource.data.担当スタッフID == resource.data.担当スタッフID && request.auth.uid == resource.data.担当スタッフID;
      allow delete: if isSignedIn() && request.resource.data.担当スタッフID == resource.data.担当スタッフID && request.auth.uid == resource.data.担当スタッフID;
    }


    /**
     * @description Grants or denies access to staffs collection.
     * @path /databases/{database}/documents/staffs/{staffId}
     * @allow (create) Authenticated user creates a new staffs.
     * @deny (create) Not Allowed.
     * @allow (get, list) Anyone can read staffs data.
     * @allow (update, delete) Authenticated user updates or deletes an staffs.
     * @deny (update, delete) Not Allowed.
     */
    match /staffs/{staffId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ---- Helper functions ----

    /**
     * @description Checks if the request is authenticated.
     * @returns {boolean} True if `request.auth` is not null, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is the owner of the resource and the document exists.
     * @param {string} userId - The user ID to compare against the resource data.
     * @returns {boolean} True if the user ID matches the resource's owner ID and resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isSignedIn() && resource.data.担当スタッフID == request.auth.uid;
    }
  }
}