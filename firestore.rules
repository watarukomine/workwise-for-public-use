/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict authenticated-user-only model for all data access.
 *
 * Data Structure:
 * All data is stored in top-level collections: /staff/{staffId}, /customers/{customerId}, /jobsites/{jobsiteId},
 * /workSchedules/{workScheduleId}, and /employeeActions/{employeeActionId}.
 *
 * Key Security Decisions:
 * - Only authenticated users can read or write data.
 * - Listing of collections is explicitly disallowed to prevent information leakage.
 * - Data validation is relaxed in this prototype to allow for rapid iteration.  Only ownership on create and immutability of ownership are enforced.
 *
 * These rules are designed to be highly secure and easily auditable, focusing on simplicity
 * and direct enforcement of the core security principle: authenticated-user-only access.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Defines a global function to check if a user is signed in.
     * @returns {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Defines a global function to check if the authenticated user's ID matches the provided user ID.
     * @param {string} userId The user ID to compare against the authenticated user's ID.
     * @returns {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(resourceId) {
      return request.auth.uid == resourceId;
    }

    /**
     * @description Defines a global function to check if the user is the owner and the document exists.
     * @param {string} userId The user ID to compare against the authenticated user's ID.
     * @returns {boolean} True if the user is the owner and the document exists, false otherwise.
     */
    function isExistingOwner(resourceId) {
      return isOwner(resourceId) && existsAfter(/databases/$(database)/documents/staff/$(resourceId));
    }

    /**
     * @description Security rules for the /staff collection.
     * @path /staff/{staffId}
     * @allow (create) Authenticated user creates a new staff document with their user ID as the document ID.
     * @allow (get) Authenticated user reads a staff document.
     * @allow (update) Authenticated user updates their own staff document.
     * @allow (delete) Authenticated user deletes their own staff document.
     * @deny (create) Non-authenticated user attempts to create a staff document.
     * @deny (get) Non-authenticated user attempts to read a staff document.
     * @deny (update) Authenticated user attempts to update a staff document that is not theirs.
     * @deny (delete) Authenticated user attempts to delete a staff document that is not theirs.
     * @principle Enforces document ownership for writes.
     */
    match /staff/{staffId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == staffId;
      allow update: if isSignedIn() && request.auth.uid == staffId;
      allow delete: if isSignedIn() && request.auth.uid == staffId;
    }

    /**
     * @description Security rules for the /customers collection.
     * @path /customers/{customerId}
     * @allow (create) Authenticated user creates a new customer document with their user ID as the document ID.
     * @allow (get) Authenticated user reads a customer document.
     * @allow (update) Authenticated user updates their own customer document.
     * @allow (delete) Authenticated user deletes their own customer document.
     * @deny (create) Non-authenticated user attempts to create a customer document.
     * @deny (get) Non-authenticated user attempts to read a customer document.
     * @deny (update) Authenticated user attempts to update a customer document that is not theirs.
     * @deny (delete) Authenticated user attempts to delete a customer document that is not theirs.
     * @principle Enforces document ownership for writes.
     */
    match /customers/{customerId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == customerId;
      allow update: if isSignedIn() && request.auth.uid == customerId;
      allow delete: if isSignedIn() && request.auth.uid == customerId;
    }

    /**
     * @description Security rules for the /jobsites collection.
     * @path /jobsites/{jobsiteId}
     * @allow (create) Authenticated user creates a new jobsite document with their user ID as the document ID.
     * @allow (get) Authenticated user reads a jobsite document.
     * @allow (update) Authenticated user updates their own jobsite document.
     * @allow (delete) Authenticated user deletes their own jobsite document.
     * @deny (create) Non-authenticated user attempts to create a jobsite document.
     * @deny (get) Non-authenticated user attempts to read a jobsite document.
     * @deny (update) Authenticated user attempts to update a jobsite document that is not theirs.
     * @deny (delete) Authenticated user attempts to delete a jobsite document that is not theirs.
     * @principle Enforces document ownership for writes.
     */
    match /jobsites/{jobsiteId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == jobsiteId;
      allow update: if isSignedIn() && request.auth.uid == jobsiteId;
      allow delete: if isSignedIn() && request.auth.uid == jobsiteId;
    }

    /**
     * @description Security rules for the /workSchedules collection.
     * @path /workSchedules/{workScheduleId}
     * @allow (create) Authenticated user creates a new workSchedule document with their user ID as the document ID.
     * @allow (get) Authenticated user reads a workSchedule document.
     * @allow (update) Authenticated user updates their own workSchedule document.
     * @allow (delete) Authenticated user deletes their own workSchedule document.
     * @deny (create) Non-authenticated user attempts to create a workSchedule document.
     * @deny (get) Non-authenticated user attempts to read a workSchedule document.
     * @deny (update) Authenticated user attempts to update a workSchedule document that is not theirs.
     * @deny (delete) Authenticated user attempts to delete a workSchedule document that is not theirs.
     * @principle Enforces document ownership for writes.
     */
    match /workSchedules/{workScheduleId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == workScheduleId;
      allow update: if isSignedIn() && request.auth.uid == workScheduleId;
      allow delete: if isSignedIn() && request.auth.uid == workScheduleId;
    }

    /**
     * @description Security rules for the /employeeActions collection.
     * @path /employeeActions/{employeeActionId}
     * @allow (create) Authenticated user creates a new employeeAction document with their user ID as the document ID.
     * @allow (get) Authenticated user reads a employeeAction document.
     * @allow (update) Authenticated user updates their own employeeAction document.
     * @allow (delete) Authenticated user deletes their own employeeAction document.
     * @deny (create) Non-authenticated user attempts to create a employeeAction document.
     * @deny (get) Non-authenticated user attempts to read a employeeAction document.
     * @deny (update) Authenticated user attempts to update a employeeAction document that is not theirs.
     * @deny (delete) Authenticated user attempts to delete a employeeAction document that is not theirs.
     * @principle Enforces document ownership for writes.
     */
    match /employeeActions/{employeeActionId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == employeeActionId;
      allow update: if isSignedIn() && request.auth.uid == employeeActionId;
      allow delete: if isSignedIn() && request.auth.uid == employeeActionId;
    }
  }
}