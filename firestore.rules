/**
 * @fileoverview Firestore Security Rules for WorkWise application.
 *
 * Core Philosophy:
 * This ruleset enforces a combination of ownership-based and role-based access control.
 * Staff and Customer data are secured using path-based ownership. WorkSchedules, Locations, and EmployeeActions
 * use a more open model with the assumption that access will be managed via application logic.
 *
 * Data Structure:
 * - /staff/{staffId}: Stores staff member data, accessible only by the staff member themselves.
 * - /customers/{customerId}: Stores customer data, accessible only by authorized personnel.
 * - /workSchedules/{workScheduleId}: Stores work schedules. Access control is managed through application logic.
 * - /locations/{locationId}: Stores location data. Access control is managed through application logic.
 * - /employeeActions/{employeeActionId}: Stores employee action data, linked to staff and work schedule. Access control is managed through application logic.
 *
 * Key Security Decisions:
 * - Staff members can only access their own data.
 * - No user listing is allowed for any collection.
 * - Data shape validation is relaxed to enable rapid prototyping, focusing on ownership and relationship integrity only.
 * - Access control for WorkSchedules, Locations, and EmployeeActions is managed via application logic.
 *
 * Denormalization for Authorization:
 *  - Authorization checks for WorkSchedule and EmployeeAction will be performed in application logic.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to staff member data.
     * @path /staff/{staffId}
     * @allow (create) - Authenticated user with matching staffId can create their own document.
     * @allow (get, list, update, delete) - Authenticated user with matching staffId can read/write their own document.
     * @deny (create) - Authenticated user with non-matching staffId attempts to create a staff document.
     * @principle Enforces document ownership for all operations.
     */
    match /staff/{staffId} {
      function isOwner(staffId) {
        return request.auth != null && request.auth.uid == staffId;
      }

      function isExistingOwner(staffId) {
          return request.auth != null && resource != null && resource.data.id == staffId;
      }

      allow get: if isOwner(staffId);
      allow list: if false;
      allow create: if isOwner(staffId) && request.resource.data.id == staffId;
      allow update: if isExistingOwner(staffId);
      allow delete: if isExistingOwner(staffId);
    }

    /**
     * @description Controls access to customer data.
     * @path /customers/{customerId}
     * @allow (create) - Authenticated user can create a customer.
     * @allow (get, list, update, delete) - Authenticated user can read/write customer data.
     * @deny (create) - Unauthenticated user attempts to create a customer.
     * @principle Open access for prototyping.
     */
    match /customers/{customerId} {
      allow get, list: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    /**
     * @description Controls access to work schedule data.
     * @path /workSchedules/{workScheduleId}
     * @allow (create) - Authenticated user can create a work schedule.
     * @allow (get, list, update, delete) - Authenticated user can read/write work schedule data.
     * @deny (create) - Unauthenticated user attempts to create a work schedule.
     * @principle Open access for prototyping.
     */
    match /workSchedules/{workScheduleId} {
      allow get, list: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    /**
     * @description Controls access to location data.
     * @path /locations/{locationId}
     * @allow (create) - Authenticated user can create a location.
     * @allow (get, list, update, delete) - Authenticated user can read/write location data.
     * @deny (create) - Unauthenticated user attempts to create a location.
     * @principle Open access for prototyping.
     */
    match /locations/{locationId} {
      allow get, list: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    /**
     * @description Controls access to employee action data.
     * @path /employeeActions/{employeeActionId}
     * @allow (create) - Authenticated user can create an employee action.
     * @allow (get, list, update, delete) - Authenticated user can read/write employee action data.
     * @deny (create) - Unauthenticated user attempts to create an employee action.
     * @principle Open access for prototyping.
     */
    match /employeeActions/{employeeActionId} {
      allow get, list: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }
  }
}