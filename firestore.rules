rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided user ID.
     * @param {string} userId - The user ID to compare against the authenticated user's UID.
     * @return {boolean} True if the user IDs match, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is the owner of the existing document.
     * @param {string} userId - The user ID to compare against the authenticated user's UID.
     * @return {boolean} True if the user IDs match and the document exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the user is an administrator.
     * @return {boolean} Always false in this prototype. Replace with actual role-checking logic.
     */
    function isAdmin() {
      return false;
    }

    /**
     * @description Rules for the /staff/{staffId} collection.
     * @path /staff/{staffId}
     * @allow (create) - An administrator can create a staff profile. (This is currently denied because isAdmin() always returns false.)
     * @deny (create) - A non-administrator cannot create a staff profile.
     * @allow (get) - An administrator can read a staff profile. (This is currently denied because isAdmin() always returns false.)
     * @deny (get) - A non-administrator cannot read a staff profile.
     * @principle Enforces role-based access control; only administrators can manage staff profiles.
     */
    match /staff/{staffId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Rules for the /customers/{customerId} collection.
     * @path /customers/{customerId}
     * @allow (create) - An administrator can create a customer profile. (This is currently denied because isAdmin() always returns false.)
     * @deny (create) - A non-administrator cannot create a customer profile.
     * @allow (get) - An administrator can read a customer profile. (This is currently denied because isAdmin() always returns false.)
     * @deny (get) - A non-administrator cannot read a customer profile.
     * @principle Enforces role-based access control; only administrators can manage customer profiles.
     */
    match /customers/{customerId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Rules for the /staff/{staffId}/workSchedules/{workScheduleId} collection.
     * @path /staff/{staffId}/workSchedules/{workScheduleId}
     * @allow (create) - The staff member or an administrator can create a work schedule. The staffId in the path must match the staffId in the new document.
     * @deny (create) - A non-staff member or non-administrator cannot create a work schedule.
     * @allow (get) - The staff member or an administrator can read a work schedule.
     * @deny (get) - A non-staff member or non-administrator cannot create a work schedule.
     * @principle Enforces path-based ownership and role-based access control for work schedules.
     */
    match /staff/{staffId}/workSchedules/{workScheduleId} {
      allow get: if isOwner(staffId) || isAdmin();
      allow list: if isOwner(staffId) || isAdmin();
      allow create: if isOwner(staffId) || isAdmin();
      allow update: if isExistingOwner(staffId) || isAdmin();
      allow delete: if isExistingOwner(staffId) || isAdmin();
    }

    /**
     * @description Rules for the /staff/{staffId}/workSchedules/{workScheduleId}/employeeActions/{employeeActionId} collection.
     * @path /staff/{staffId}/workSchedules/{workScheduleId}/employeeActions/{employeeActionId}
     * @allow (create) - The staff member or an administrator can create an employee action.
     * @deny (create) - A non-staff member or non-administrator cannot create an employee action.
     * @allow (get) - The staff member or an administrator can read an employee action.
     * @deny (get) - A non-staff member or non-administrator cannot create an employee action.
     * @principle Enforces path-based ownership and role-based access control for employee actions.
     */
    match /staff/{staffId}/workSchedules/{workScheduleId}/employeeActions/{employeeActionId} {
      allow get: if isOwner(staffId) || isAdmin();
      allow list: if isOwner(staffId) || isAdmin();
      allow create: if isOwner(staffId) || isAdmin();
      allow update: if isExistingOwner(staffId) || isAdmin();
      allow delete: if isExistingOwner(staffId) || isAdmin();
    }

    /**
     * @description Rules for the /locations/{locationId} collection.
     * @path /locations/{locationId}
     * @allow (create) - An administrator can create a location. (This is currently denied because isAdmin() always returns false.)
     * @deny (create) - A non-administrator cannot create a location.
     * @allow (get) - An administrator can read a location. (This is currently denied because isAdmin() always returns false.)
     * @deny (get) - A non-administrator cannot read a location.
     * @principle Enforces role-based access control; only administrators can manage location data.
     */
    match /locations/{locationId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}