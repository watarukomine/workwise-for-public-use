/**
 * @file Firebase Security Rules for the application.
 *
 * @core_philosophy This ruleset implements a role-based access control system with "admin" and "staff" roles.
 * Admins have full CRUD access to most collections, while staff can only manage their own employee actions and read the staff collection.
 * User profiles are self-managed, with users able to read and write their own profiles.
 *
 * @data_structure
 * - /users/{userId}: Stores user profile data, where {userId} is the Firebase Auth UID.
 * - /staff/{staffId}: Stores staff member data.
 * - /customers/{customerId}: Stores customer data.
 * - /schedules/{scheduleId}: Stores schedule data.
 * - /locations/{locationId}: Stores location data.
 * - /staff/{staffId}/employee_actions/{employeeActionId}: Stores employee action logs.
 * - /config/admins: A single document storing a list of admin UIDs.
 *
 * @key_security_decisions
 * - Listing of users is disallowed to prevent unauthorized data access.
 * - Admins are defined in a dedicated `/config/admins` document for centralized management.
 * - Strict ownership is enforced for user profiles and employee actions.
 *
 * @denormalization_for_authorization
 * - Admin status is determined by checking against the `admin_uids` array in the `/config/admins` document, avoiding complex role management strategies.
 *
 * @structural_segregation N/A
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user's ID matches the requested user ID.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is an existing owner of the document.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the user is an admin by verifying their UID against the list in /config/admins.
     */
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/config/admins).data.admin_uids.hasAny([request.auth.uid]);
    }

    /**
     * @description Rule for the /users/{userId} collection.
     * @path /users/{userId}
     * @allow (get) Signed-in user can get their own profile.
     * @allow (create) Signed-in user can create their own profile.
     * @allow (update) Signed-in user can update their own profile.
     * @allow (delete) Signed-in user can delete their own profile.
     * @deny (get) User cannot get another user's profile.
     * @deny (create) User cannot create a profile with a mismatched ID.
     * @deny (update) User cannot update another user's profile.
     * @deny (delete) User cannot delete another user's profile.
     * @principle Enforces document ownership for writes, restricts access to a user's own data.
     */
    match /users/{userId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;

      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rule for the /staff/{staffId} collection.
     * @path /staff/{staffId}
     * @allow (get) Admins can get staff profiles.
     * @allow (create) Admins can create staff profiles.
     * @allow (update) Admins can update staff profiles.
     * @allow (delete) Admins can delete staff profiles.
     * @deny (get) Non-admins cannot get staff profiles.
     * @deny (create) Non-admins cannot create staff profiles.
     * @deny (update) Non-admins cannot update staff profiles.
     * @deny (delete) Non-admins cannot delete staff profiles.
     * @principle Restricts access to staff profiles to admins only.
     */
    match /staff/{staffId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Rule for the /customers/{customerId} collection.
     * @path /customers/{customerId}
     * @allow (get) Admins can get customer profiles.
     * @allow (create) Admins can create customer profiles.
     * @allow (update) Admins can update customer profiles.
     * @allow (delete) Admins can delete customer profiles.
     * @deny (get) Non-admins cannot get customer profiles.
     * @deny (create) Non-admins cannot create customer profiles.
     * @deny (update) Non-admins cannot update customer profiles.
     * @deny (delete) Non-admins cannot delete customer profiles.
     * @principle Restricts access to customer profiles to admins only.
     */
    match /customers/{customerId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Rule for the /schedules/{scheduleId} collection.
     * @path /schedules/{scheduleId}
     * @allow (get) Admins can get schedules.
     * @allow (create) Admins can create schedules.
     * @allow (update) Admins can update schedules.
     * @allow (delete) Admins can delete schedules.
     * @deny (get) Non-admins cannot get schedules.
     * @deny (create) Non-admins cannot create schedules.
     * @deny (update) Non-admins cannot update schedules.
     * @deny (delete) Non-admins cannot delete schedules.
     * @principle Restricts access to schedules to admins only.
     */
    match /schedules/{scheduleId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Rule for the /locations/{locationId} collection.
     * @path /locations/{locationId}
     * @allow (get) Admins can get locations.
     * @allow (create) Admins can create locations.
     * @allow (update) Admins can update locations.
     * @allow (delete) Admins can delete locations.
     * @deny (get) Non-admins cannot get locations.
     * @deny (create) Non-admins cannot create locations.
     * @deny (update) Non-admins cannot update locations.
     * @deny (delete) Non-admins cannot delete locations.
     * @principle Restricts access to locations to admins only.
     */
    match /locations/{locationId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Rule for the /staff/{staffId}/employee_actions/{employeeActionId} collection.
     * @path /staff/{staffId}/employee_actions/{employeeActionId}
     * @allow (get) Admins and the associated staff member can get employee actions.
     * @allow (create) Admins and the associated staff member can create employee actions.
     * @allow (update) Admins and the associated staff member can update employee actions.
     * @allow (delete) Admins and the associated staff member can delete employee actions.
     * @deny (get) Non-admins and other staff members cannot get employee actions.
     * @deny (create) Non-admins and other staff members cannot create employee actions.
     * @deny (update) Non-admins and other staff members cannot update employee actions.
     * @deny (delete) Non-admins and other staff members cannot delete employee actions.
     * @principle Enforces document ownership for writes, restricts access to a user's own data.
     */
    match /staff/{staffId}/employee_actions/{employeeActionId} {
      allow get: if isAdmin() || (isSignedIn() && isOwner(staffId));
      allow list: if isAdmin() || (isSignedIn() && isOwner(staffId));
      allow create: if isSignedIn() && (isOwner(staffId) || isAdmin()) && request.resource.data.employeeId == staffId;
      allow update: if (isAdmin() || (isSignedIn() && isOwner(staffId))) && resource != null && request.resource.data.employeeId == resource.data.employeeId;
      allow delete: if (isAdmin() || (isSignedIn() && isOwner(staffId))) && resource != null;
    }

    /**
     * @description Rule for the /config/admins document.
     * @path /config/admins
     * @allow (get) Only signed-in users can get the admin config.
     * @deny (create) No one can create this document through the client.
     * @deny (update) No one can update this document through the client.
     * @deny (delete) No one can delete this document through the client.
     * @principle Restricts access to a user's own data tree.
     */
    match /config/admins {
        allow get: if isSignedIn();
        allow list: if false;
        allow create: if false;
        allow update: if false;
        allow delete: if false;
    }
  }
}