rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Protects user profile information, allowing only the owner to read and write their own profile.
     * @path /users/{userId}
     * @allow (create) - User with UID 'user123' can create their own profile at /users/user123.
     * @allow (get, update, delete) - User with UID 'user123' can read, update, and delete their profile at /users/user123.
     * @deny (create) - User with UID 'user456' cannot create a profile at /users/user123.
     * @deny (get, update, delete) - User with UID 'user456' cannot read, update, or delete the profile at /users/user123.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && exists(resource);
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false; // Listing users is not permitted.
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Protects staff member profiles, allowing only admins or the staff member themselves to read and write.
     * @path /staff/{staffId}
     * @allow (create) - User with admin role can create staff profiles.
     * @allow (get, update, delete) - Staff member with UID 'staff123' can read, update, and delete their profile at /staff/staff123.
     * @deny (create) - User without admin role cannot create staff profiles.
     * @deny (get, update, delete) - User with UID 'user456' cannot read, update, or delete the profile at /staff/staff123.
     * @principle Enforces document ownership and role-based access control for staff profiles.
     */
    match /staff/{staffId} {
       function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(staffId) {
        return request.auth.uid == staffId;
      }

      function isAdmin() {
        return request.auth.token.role == 'admin';
      }

      function isExistingOwner(staffId) {
        return isOwner(staffId) && exists(resource);
      }

      allow get: if isSignedIn() && (isOwner(staffId) || isAdmin());
      allow list: if isSignedIn() && isAdmin();
      allow create: if isSignedIn() && isAdmin();
      allow update: if isSignedIn() && (isExistingOwner(staffId) || isAdmin());
      allow delete: if isSignedIn() && (isExistingOwner(staffId) || isAdmin());
    }

    /**
     * @description Protects customer profiles, allowing only admins to create, read, update, or delete them.
     * @path /customers/{customerId}
     * @allow (create, get, update, delete) - User with admin role can manage customer profiles.
     * @deny (create, get, update, delete) - User without admin role cannot manage customer profiles.
     * @principle Enforces role-based access control for customer profiles.
     */
    match /customers/{customerId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isAdmin() {
        return request.auth.token.role == 'admin';
      }

      allow get: if isSignedIn() && isAdmin();
      allow list: if isSignedIn() && isAdmin();
      allow create: if isSignedIn() && isAdmin();
      allow update: if isSignedIn() && isAdmin() && exists(resource);
      allow delete: if isSignedIn() && isAdmin() && exists(resource);
    }

    /**
     * @description Protects work schedules, allowing only admins to create, read, update, or delete them.
     * @path /schedules/{scheduleId}
     * @allow (create, get, update, delete) - User with admin role can manage work schedules.
     * @deny (create, get, update, delete) - User without admin role cannot manage work schedules.
     * @principle Enforces role-based access control for work schedules.
     */
    match /schedules/{scheduleId} {
       function isSignedIn() {
        return request.auth != null;
      }

      function isAdmin() {
        return request.auth.token.role == 'admin';
      }

      allow get: if isSignedIn() && isAdmin();
      allow list: if isSignedIn() && isAdmin();
      allow create: if isSignedIn() && isAdmin();
      allow update: if isSignedIn() && isAdmin() && exists(resource);
      allow delete: if isSignedIn() && isAdmin() && exists(resource);
    }

    /**
     * @description Protects location data, allowing only admins to create, read, update, or delete them.
     * @path /locations/{locationId}
     * @allow (create, get, update, delete) - User with admin role can manage location data.
     * @deny (create, get, update, delete) - User without admin role cannot manage location data.
     * @principle Enforces role-based access control for location data.
     */
    match /locations/{locationId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isAdmin() {
        return request.auth.token.role == 'admin';
      }

      allow get: if isSignedIn() && isAdmin();
      allow list: if isSignedIn() && isAdmin();
      allow create: if isSignedIn() && isAdmin();
      allow update: if isSignedIn() && isAdmin() && exists(resource);
      allow delete: if isSignedIn() && isAdmin() && exists(resource);
    }

    /**
     * @description Protects employee actions, allowing each staff member to manage only their own actions.
     * @path /staff/{staffId}/employee_actions/{employeeActionId}
     * @allow (create, get, update, delete) - Staff member with UID 'staff123' can manage their actions at /staff/staff123/employee_actions/{employeeActionId}.
     * @deny (create, get, update, delete) - User with UID 'user456' cannot manage actions at /staff/staff123/employee_actions/{employeeActionId}.
     * @principle Enforces document ownership for employee actions.
     */
    match /staff/{staffId}/employee_actions/{employeeActionId} {
       function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(staffId) {
        return request.auth.uid == staffId;
      }

       function isExistingOwner(staffId) {
        return isOwner(staffId) && exists(resource);
      }

      allow get: if isSignedIn() && isOwner(staffId);
      allow list: if isSignedIn() && isOwner(staffId);
      allow create: if isSignedIn() && isOwner(staffId);
      allow update: if isSignedIn() && isExistingOwner(staffId);
      allow delete: if isSignedIn() && isExistingOwner(staffId);
    }
  }
}