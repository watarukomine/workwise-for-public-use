/**
 * @fileoverview Firestore Security Rules for WorkWise application.
 *
 * Core Philosophy:
 * This ruleset enforces a combination of user-ownership and admin-only access patterns.
 * User data (staff profiles) are strictly controlled by the owning user, while other
 * data (customers, work schedules, locations, and employee actions) are managed by
 * administrators.  This ensures data privacy and prevents unauthorized modifications.
 *
 * Data Structure:
 * - /users/{userId}/staff/{staffId}: Staff profiles, owned by the user.
 * - /customers/{customerId}: Customer data, admin-only access.
 * - /workSchedules/{workScheduleId}: Work schedule data, admin-only access.
 * - /locations/{locationId}: Location data, admin-only access.
 * - /employeeActions/{employeeActionId}: Employee action data, admin-only access.
 *
 * Key Security Decisions:
 * - User listing is disallowed at the root level to prevent enumeration attacks.
 * - Data validation is relaxed (prototyping mode), focusing on authorization.
 *
 * Denormalization for Authorization:
 * To simplify and optimize rules, `EmployeeAction` documents may contain denormalized
 * `staffId` data, avoiding the need for `get()` calls to the `WorkSchedule` document.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided userId.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the owner of the existing document.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Rules for documents in the /users/{userId}/staff/{staffId} path.
     * @path /users/{userId}/staff/{staffId}
     * @allow (create) User "user123" can create a staff document if their UID matches {userId} and the document's `id` matches {staffId}.
     * @allow (get) User "user123" can read their own staff document.
     * @allow (update) User "user123" can update their own staff document.
     * @allow (delete) User "user123" can delete their own staff document.
     * @deny (create) User "user456" cannot create a staff document under /users/{user123} because the UID does not match.
     * @deny (get) User "user456" cannot read staff document under /users/{user123}.
     * @principle Enforces document ownership for writes; restricts access to a user's own data tree.
     */
    match /users/{userId}/staff/{staffId} {
      // Read rules: Only the owner can read their own staff document.
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);

      // Write rules: Only the owner can create, update, or delete their own staff document.
      allow create: if isOwner(userId) && request.resource.data.id == staffId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for documents in the /customers/{customerId} path.
     * @path /customers/{customerId}
     * @allow (get) Any authenticated user can read customer data.
     * @deny (create) No user can create customer data without admin privileges.
     * @deny (update) No user can update customer data without admin privileges.
     * @deny (delete) No user can delete customer data without admin privileges.
     * @principle Restricts access to Customer collection to admins only.
     */
    match /customers/{customerId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }

    /**
     * @description Rules for documents in the /workSchedules/{workScheduleId} path.
     * @path /workSchedules/{workScheduleId}
     * @allow (get) Any authenticated user can read work schedule data.
     * @deny (create) No user can create work schedule data without admin privileges.
     * @deny (update) No user can update work schedule data without admin privileges.
     * @deny (delete) No user can delete work schedule data without admin privileges.
     * @principle Restricts access to WorkSchedule collection to admins only.
     */
    match /workSchedules/{workScheduleId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }

    /**
     * @description Rules for documents in the /locations/{locationId} path.
     * @path /locations/{locationId}
     * @allow (get) Any authenticated user can read location data.
     * @deny (create) No user can create location data without admin privileges.
     * @deny (update) No user can update location data without admin privileges.
     * @deny (delete) No user can delete customer data without admin privileges.
     * @principle Restricts access to Location collection to admins only.
     */
    match /locations/{locationId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }

    /**
     * @description Rules for documents in the /employeeActions/{employeeActionId} path.
     * @path /employeeActions/{employeeActionId}
     * @allow (get) Any authenticated user can read employee action data.
     * @deny (create) No user can create employee action data without admin privileges.
     * @deny (update) No user can update employee action data without admin privileges.
     * @deny (delete) No user can delete employee action data without admin privileges.
     * @principle Restricts access to EmployeeAction collection to admins only.
     */
    match /employeeActions/{employeeActionId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }
  }
}