/**
 * @file Firebase Security Rules for Firestore.
 * @description This ruleset enforces a multi-layered security model based on path-based ownership,
 * public read access for specific collections, and administrative roles.
 *
 * Data Structure:
 * - /staff/{staffId}: Stores staff member data; access is restricted to the staff member themselves and admins.
 * - /customers/{customerId}: Stores customer data; read access is public, but write access is restricted.
 * - /schedules/{scheduleId}: Stores schedule data; access is not explicitly defined here, but in a real-world
 *   scenario, access would likely be controlled based on associated staff or customer.
 * - /staff/{staffId}/statusUpdates/{statusUpdateId}: Stores status updates for staff; access is limited to
 *   the staff member themselves and admins.
 * - /roles_admin/{userId}: Collection used to store admin roles; the existence of a document grants admin access.
 *
 * Key Security Decisions:
 * - Strict user-ownership model for staff and their status updates.
 * - Public read access for customer data to support searching, but restricted write access.
 * - Admin roles are managed through the `roles_admin` collection.
 * - Data validation is limited to ownership checks to enable rapid prototyping.
 *
 * Denormalization for Authorization:
 * The ruleset relies on path-based ownership and the `roles_admin` collection to make authorization decisions.
 * This avoids costly `get()` calls to other documents.
 *
 * Structural Segregation:
 * The ruleset uses separate collections for public (customers) and private (staff and status updates) data.
 * This approach is more secure and performant than using a single collection with a public/private flag.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages access to staff member data.
     * @path /staff/{staffId}
     * @allow (get, list) Authenticated user can read their own staff data.
     * @allow (create, update, delete) Authenticated user can manage their own staff data.
     * @deny (get, list) Authenticated user cannot read other staff data.
     * @deny (create, update, delete) Authenticated user cannot modify other staff data.
     * @principle Enforces document ownership for all operations.
     */
    match /staff/{staffId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get, list: if isSignedIn() && (isOwner(staffId) || isAdmin());
      allow create: if isOwner(staffId);
      allow update: if isExistingOwner(staffId) ;
      allow delete: if isExistingOwner(staffId);
    }

    /**
     * @description Manages access to customer data.
     * @path /customers/{customerId}
     * @allow (get, list) Anyone can read customer data.
     * @deny (create, update, delete) Only admins can create, update, or delete customer data.
     * @principle Public read access with restricted writes.
     */
    match /customers/{customerId} {
      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Manages access to schedule data.
     * @path /schedules/{scheduleId}
     * @allow (get, list) Anyone can read schedule data.
     * @deny (create, update, delete) No one can create, update, or delete schedule data.
     * @principle Restricted access; update rules as needed.
     */
    match /schedules/{scheduleId} {
          // In a real-world application, access to schedules would be
          // restricted based on the staff and customer involved.
          // For this prototype, access is denied to all operations to ensure no data can be updated.
          // TODO: Implement staff/customer based access control.
          allow get, list: if true;
          allow create, update, delete: if false;
    }

    /**
     * @description Manages access to staff status updates.
     * @path /staff/{staffId}/statusUpdates/{statusUpdateId}
     * @allow (get, list) Authenticated user can read their own status updates.
     * @allow (create, update, delete) Authenticated user can manage their own status updates.
     * @deny (get, list) Authenticated user cannot read other staff's status updates.
     * @deny (create, update, delete) Authenticated user cannot modify other staff's status updates.
     * @principle Enforces document ownership for all operations.
     */
    match /staff/{staffId}/statusUpdates/{statusUpdateId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get, list: if isSignedIn() && (isOwner(staffId) || isAdmin());
      allow create: if isOwner(staffId);
      allow update: if isExistingOwner(staffId);
      allow delete: if isExistingOwner(staffId);
    }
    /**
     * @description Manages access to admin role assignments.
     * @path /roles_admin/{userId}
     * @allow (get) Anyone can check if a user is an admin.
     * @deny (create, update, delete) Only admins can manage admin roles.
     */
    match /roles_admin/{userId} {
        function isAdmin() {
            return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
        }

        allow get: if true;
        allow create, update, delete: if isAdmin();
    }
  }
}