/**
 * @fileoverview Firestore Security Rules for WorkWise application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for staff profiles nested under `/users/{userId}/staff/{staffId}`.
 * All other collections (`customers`, `workSchedules`, `locations`, `employeeActions`) are intended for admin-only access.
 * The rules explicitly deny potentially dangerous operations like listing all documents in the root collections,
 * unless specifically designed for public access.
 *
 * Data Structure:
 * - /users/{userId}/staff/{staffId}: Staff profiles owned by individual users.
 * - /customers/{customerId}: Customer data (admin-only).
 * - /workSchedules/{workScheduleId}: Work schedule data (admin-only).
 * - /locations/{locationId}: Location data (admin-only).
 * - /employeeActions/{employeeActionId}: Employee action data (admin-only). Contains denormalized `staffId` for authorization.
 *
 * Key Security Decisions:
 * - No public access is granted to any collections.
 * - Listing of root collections (customers, workSchedules, locations, employeeActions) is denied to prevent unauthorized data discovery.
 * - User listing is explicitly disallowed.
 * - Access to 'EmployeeAction' documents, while admin-only, leverages the denormalized 'staffId' field to simplify potential future access control scenarios.
 *
 * Denormalization for Authorization:
 * - 'EmployeeAction' documents include a denormalized 'staffId' field from the associated 'WorkSchedule'. This allows for simpler, more performant rules if we need to restrict access to EmployeeActions based on the staff member involved.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure staff profiles under a user's path. Enforces ownership.
     * @path /users/{userId}/staff/{staffId}
     * @allow (create) User 'test_user' can create a staff profile at /users/test_user/staff/staff_123 if request.auth.uid == 'test_user' and request.resource.data.id == 'test_user'.
     * @allow (get) User 'test_user' can read their own staff profile at /users/test_user/staff/staff_123 if request.auth.uid == 'test_user'.
     * @allow (update) User 'test_user' can update their own staff profile at /users/test_user/staff/staff_123 if request.auth.uid == 'test_user'.
     * @allow (delete) User 'test_user' can delete their own staff profile at /users/test_user/staff/staff_123 if request.auth.uid == 'test_user'.
     * @deny (create) User 'other_user' cannot create a staff profile under 'test_user's path.
     * @deny (get) User 'other_user' cannot read 'test_user's staff profile.
     * @deny (update) User 'other_user' cannot update 'test_user's staff profile.
     * @deny (delete) User 'other_user' cannot delete 'test_user's staff profile.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/staff/{staffId} {
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId) && resource.data.id == request.resource.data.id;
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Secure customer data. Accessible only to admins.
     * @path /customers/{customerId}
     * @allow (create) Should be granted to an admin user. Example: allow create: if isAdmin();
     * @allow (get) Should be granted to an admin user. Example: allow get: if isAdmin();
     * @allow (update) Should be granted to an admin user. Example: allow update: if isAdmin();
     * @allow (delete) Should be granted to an admin user. Example: allow delete: if isAdmin();
     * @deny (create) Any non-admin user cannot create customer data.
     * @deny (get) Any non-admin user cannot read customer data.
     * @deny (update) Any non-admin user cannot update customer data.
     * @deny (delete) Any non-admin user cannot delete customer data.
     * @principle Restricts access to admin users only.
     */
    match /customers/{customerId} {
      allow create: if false; // TODO: Add admin validation once roles are defined.
      allow get: if false; // TODO: Add admin validation once roles are defined.
      allow list: if false;
      allow update: if false; // TODO: Add admin validation once roles are defined.
      allow delete: if false; // TODO: Add admin validation once roles are defined.
    }

    /**
     * @description Secure work schedule data. Accessible only to admins.
     * @path /workSchedules/{workScheduleId}
     * @allow (create) Should be granted to an admin user. Example: allow create: if isAdmin();
     * @allow (get) Should be granted to an admin user. Example: allow get: if isAdmin();
     * @allow (update) Should be granted to an admin user. Example: allow update: if isAdmin();
     * @allow (delete) Should be granted to an admin user. Example: allow delete: if isAdmin();
     * @deny (create) Any non-admin user cannot create work schedule data.
     * @deny (get) Any non-admin user cannot read work schedule data.
     * @deny (update) Any non-admin user cannot update work schedule data.
     * @deny (delete) Any non-admin user cannot delete work schedule data.
     * @principle Restricts access to admin users only.
     */
    match /workSchedules/{workScheduleId} {
      allow create: if false; // TODO: Add admin validation once roles are defined.
      allow get: if false; // TODO: Add admin validation once roles are defined.
      allow list: if false;
      allow update: if false; // TODO: Add admin validation once roles are defined.
      allow delete: if false; // TODO: Add admin validation once roles are defined.
    }

    /**
     * @description Secure location data. Accessible only to admins.
     * @path /locations/{locationId}
     * @allow (create) Should be granted to an admin user. Example: allow create: if isAdmin();
     * @allow (get) Should be granted to an admin user. Example: allow get: if isAdmin();
     * @allow (update) Should be granted to an admin user. Example: allow update: if isAdmin();
     * @allow (delete) Should be granted to an admin user. Example: allow delete: if isAdmin();
     * @deny (create) Any non-admin user cannot create location data.
     * @deny (get) Any non-admin user cannot read location data.
     * @deny (update) Any non-admin user cannot update location data.
     * @deny (delete) Any non-admin user cannot delete location data.
     * @principle Restricts access to admin users only.
     */
    match /locations/{locationId} {
      allow create: if false; // TODO: Add admin validation once roles are defined.
      allow get: if false; // TODO: Add admin validation once roles are defined.
      allow list: if false;
      allow update: if false; // TODO: Add admin validation once roles are defined.
      allow delete: if false; // TODO: Add admin validation once roles are defined.
    }

    /**
     * @description Secure employee action data. Accessible only to admins.
     * @path /employeeActions/{employeeActionId}
     * @allow (create) Should be granted to an admin user. Example: allow create: if isAdmin();
     * @allow (get) Should be granted to an admin user. Example: allow get: if isAdmin();
     * @allow (update) Should be granted to an admin user. Example: allow update: if isAdmin();
     * @allow (delete) Should be granted to an admin user. Example: allow delete: if isAdmin();
     * @deny (create) Any non-admin user cannot create employee action data.
     * @deny (get) Any non-admin user cannot read employee action data.
     * @deny (update) Any non-admin user cannot update employee action data.
     * @deny (delete) Any non-admin user cannot delete employee action data.
     * @principle Restricts access to admin users only.
     */
    match /employeeActions/{employeeActionId} {
      allow create: if false; // TODO: Add admin validation once roles are defined.
      allow get: if false; // TODO: Add admin validation once roles are defined.
      allow list: if false;
      allow update: if false; // TODO: Add admin validation once roles are defined.
      allow delete: if false; // TODO: Add admin validation once roles are defined.
    }
  }

  // Helper functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }

  function isExistingOwner(userId) {
    return isOwner(userId) && resource != null;
  }
}