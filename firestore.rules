rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to staff member documents.
     * @path /staff/{staffId}
     * @allow (get, list) if request.auth.uid == staffId
     * @allow (create, update, delete) if request.auth.uid == staffId
     * @deny (get, list) if request.auth.uid != staffId
     * @deny (create, update, delete) if request.auth.uid != staffId
     * @principle Enforces document ownership for staff data.
     */
    match /staff/{staffId} {
      // function to check if the user is signed in
      function isSignedIn() {
        return request.auth != null;
      }

      // function to check if the user is the owner
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      //function to check if the user is the existing owner
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      // Allows the user to read their own staff document
      allow get: if isOwner(staffId);
      allow list: if false; // explicitly prevent listing

      // Allows the user to create their own staff document, enforcing that the document id matches their user id.
      allow create: if isSignedIn() && request.auth.uid == staffId;

      // Allows the user to update their own staff document.
      allow update: if isExistingOwner(staffId);

      // Allows the user to delete their own staff document.
      allow delete: if isExistingOwner(staffId);
    }

    /**
     * @description Controls access to customer documents.
     * @path /customers/{customerId}
     * @allow (get, list) if true
     * @allow (create, update, delete) if isSignedIn()
     * @deny (create, update, delete) if !isSignedIn()
     * @principle Allows access to customers documents by authenticated users.
     */
    match /customers/{customerId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Controls access to work schedule documents for a specific staff member.
     * @path /staff/{staffId}/workSchedules/{workScheduleId}
     * @allow (get, list) if request.auth.uid == staffId
     * @allow (create, update, delete) if request.auth.uid == staffId
     * @deny (get, list) if request.auth.uid != staffId
     * @deny (create, update, delete) if request.auth.uid != staffId
     * @principle Enforces document ownership for work schedules.
     */
    match /staff/{staffId}/workSchedules/{workScheduleId} {
      // function to check if the user is signed in
      function isSignedIn() {
        return request.auth != null;
      }

      // function to check if the user is the owner
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      //function to check if the user is the existing owner
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      // Allows the owner to read their own work schedule document.
      allow get: if isOwner(staffId);

      // Allows the owner to list their own work schedule document.
      allow list: if isOwner(staffId);

      // Allows the owner to create a work schedule document.
      allow create: if isOwner(staffId);

      // Allows the owner to update their own work schedule document.
      allow update: if isExistingOwner(staffId);

      // Allows the owner to delete their own work schedule document.
      allow delete: if isExistingOwner(staffId);
    }

    /**
     * @description Controls access to jobsite documents.
     * @path /jobsites/{jobsiteId}
     * @allow (get, list) if true
     * @allow (create, update, delete) if isSignedIn()
     * @deny (create, update, delete) if !isSignedIn()
     * @principle Allows access to jobsites documents by authenticated users.
     */
    match /jobsites/{jobsiteId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Controls access to employee action documents for a specific staff member.
     * @path /staff/{staffId}/employeeActions/{employeeActionId}
     * @allow (get, list) if request.auth.uid == staffId
     * @allow (create, update, delete) if request.auth.uid == staffId
     * @deny (get, list) if request.auth.uid != staffId
     * @deny (create, update, delete) if request.auth.uid != staffId
     * @principle Enforces document ownership for employee actions.
     */
    match /staff/{staffId}/employeeActions/{employeeActionId} {
      // function to check if the user is signed in
      function isSignedIn() {
        return request.auth != null;
      }

      // function to check if the user is the owner
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      //function to check if the user is the existing owner
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      // Allows the owner to read their own employee action document.
      allow get: if isOwner(staffId);

      // Allows the owner to list their own employee action documents.
      allow list: if isOwner(staffId);

      // Allows the owner to create a new employee action document.
      allow create: if isOwner(staffId);

      // Allows the owner to update their own employee action document.
      allow update: if isExistingOwner(staffId);

      // Allows the owner to delete their own employee action document.
      allow delete: if isExistingOwner(staffId);
    }
  }
}