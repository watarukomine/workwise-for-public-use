/**
 * @fileoverview Firestore Security Rules for Prototyping.
 *
 * Core Philosophy:
 * This ruleset prioritizes strict authentication and authorization, ensuring only signed-in users can access data. It avoids complex data validation to enable rapid prototyping.
 *
 * Data Structure:
 * The database consists of top-level collections for 'staff', 'customers', 'jobsites', 'workSchedules', and 'employeeActions'.
 * Each collection contains documents identified by unique IDs.
 *
 * Key Security Decisions:
 * - All collections require authentication.
 * - List operations are only permitted to authenticated users.
 * - No data shape validation is performed in this prototype.
 *
 * To improve security and performance, always denormalize authorization data directly onto the documents being secured.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to the 'staff' collection.
     * @path /staff/{staffId}
     * @allow (create) Authenticated user can create a staff document.
     * @deny (create) Non-authenticated user cannot create a staff document.
     * @allow (get, list) Authenticated user can read a staff document.
     * @deny (get, list) Non-authenticated user cannot read a staff document.
     * @allow (update, delete) Authenticated user can update or delete a staff document if it exists.
     * @deny (update, delete) Non-authenticated user cannot update or delete a staff document.
     * @principle Requires authentication for all operations.
     */
    match /staff/{staffId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Controls access to the 'customers' collection.
     * @path /customers/{customerId}
     * @allow (create) Authenticated user can create a customer document.
     * @deny (create) Non-authenticated user cannot create a customer document.
     * @allow (get, list) Authenticated user can read a customer document.
     * @deny (get, list) Non-authenticated user cannot read a customer document.
     * @allow (update, delete) Authenticated user can update or delete a customer document if it exists.
     * @deny (update, delete) Non-authenticated user cannot update or delete a customer document.
     * @principle Requires authentication for all operations.
     */
    match /customers/{customerId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Controls access to the 'jobsites' collection.
     * @path /jobsites/{jobsiteId}
     * @allow (create) Authenticated user can create a jobsite document.
     * @deny (create) Non-authenticated user cannot create a jobsite document.
     * @allow (get, list) Authenticated user can read a jobsite document.
     * @deny (get, list) Non-authenticated user cannot read a jobsite document.
     * @allow (update, delete) Authenticated user can update or delete a jobsite document if it exists.
     * @deny (update, delete) Non-authenticated user cannot update or delete a jobsite document.
     * @principle Requires authentication for all operations.
     */
    match /jobsites/{jobsiteId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Controls access to the 'workSchedules' collection.
     * @path /workSchedules/{workScheduleId}
     * @allow (create) Authenticated user can create a workSchedule document.
     * @deny (create) Non-authenticated user cannot create a workSchedule document.
     * @allow (get, list) Authenticated user can read a workSchedule document.
     * @deny (get, list) Non-authenticated user cannot read a workSchedule document.
     * @allow (update, delete) Authenticated user can update or delete a workSchedule document if it exists.
     * @deny (update, delete) Non-authenticated user cannot update or delete a workSchedule document.
     * @principle Requires authentication for all operations.
     */
    match /workSchedules/{workScheduleId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Controls access to the 'employeeActions' collection.
     * @path /employeeActions/{employeeActionId}
     * @allow (create) Authenticated user can create a employeeAction document.
     * @deny (create) Non-authenticated user cannot create a employeeAction document.
     * @allow (get, list) Authenticated user can read a employeeAction document.
     * @deny (get, list) Non-authenticated user cannot read a employeeAction document.
     * @allow (update, delete) Authenticated user can update or delete a employeeAction document if it exists.
     * @deny (update, delete) Non-authenticated user cannot update or delete a employeeAction document.
     * @principle Requires authentication for all operations.
     */
    match /employeeActions/{employeeActionId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    // Helper function to determine if a user is signed in.
    function isSignedIn() {
      return request.auth != null;
    }
  }
}