/**
 * @fileoverview Firestore Security Rules for WorkWise application.
 *
 * Core Philosophy:
 * This ruleset enforces a combination of ownership-based and role-based access control.
 * Users have full control over their own staff profiles.
 * WorkSchedules, Orders, and Customers are publicly readable but only modifiable by specific roles or owners.
 *
 * Data Structure:
 * - /users/{userId}/staff/{staffId}:  Staff profiles, owned by the user.
 * - /customers/{customerId}: Customer data, publicly readable, writes must be controlled.
 * - /workSchedules/{workScheduleId}: Work schedule data, publicly readable, writes must be controlled.
 * - /locations/{locationId}: Location data, publicly readable, writes must be controlled.
 * - /employeeActions/{employeeActionId}: Employee action logs, writes must be controlled.
 * - /orders/{orderId}: Orders, publicly readable, writes must be controlled.
 *
 * Key Security Decisions:
 * - User listing is disabled on the root `/users` collection.
 * - Public read access is granted to the `/customers`, `/workSchedules`, and `/orders` collections to simplify read operations for the application.  Writes must be validated.
 * - Locations and EmployeeActions are intended for admin-level management, but the specific role-based access control is not yet defined.
 *
 * Denormalization for Authorization:
 * - The `EmployeeAction` entity can denormalize the `staffId` from the related `WorkSchedule` to simplify authorization rules, preventing extra reads.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure access to user-specific staff profiles.
     * @path /users/{userId}/staff/{staffId}
     * @allow (create) User 'test_user' with UID 'test_user' can create their own staff profile with matching userId and staffId.
     * @allow (get, update, delete) User 'test_user' with UID 'test_user' can read, update, and delete their own staff profile.
     * @deny (create) User 'another_user' with UID 'another_user' cannot create a staff profile under 'test_user's ID.
     * @deny (get, update, delete) User 'another_user' with UID 'another_user' cannot read, update, or delete 'test_user's staff profile.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/staff/{staffId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Control access to customer data. Public read, writes must be controlled.
     * @path /customers/{customerId}
     * @allow (get, list) Any authenticated user can read customer data.
     * @deny (create, update, delete) No one can write to customer data without specific authorization (TODO: Define authorization)
     * @principle Public read access with restricted writes.
     */
    match /customers/{customerId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Control access to work schedule data. Public read, writes must be controlled.
     * @path /workSchedules/{workScheduleId}
     * @allow (get, list) Any authenticated user can read work schedule data.
     * @deny (create, update, delete) No one can write to work schedule data without specific authorization (TODO: Define authorization)
     * @principle Public read access with restricted writes.
     */
    match /workSchedules/{workScheduleId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Restrict access to location data. Accessible to admins (TODO: Define the admin role).
     * @path /locations/{locationId}
     * @allow (get, list) Any authenticated user can read location data.
     * @deny (create, update, delete) No one can write to location data without specific authorization (TODO: Define authorization)
     * @principle Restricts access to a specific role (admin).
     */
    match /locations/{locationId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Restrict access to employee action data. Accessible to admins (TODO: Define the admin role).
     * @path /employeeActions/{employeeActionId}
     * @allow (get, list) Any authenticated user can read employee action data.
     * @deny (create, update, delete) No one can write to employee action data without specific authorization (TODO: Define authorization)
     * @principle Restricts access to a specific role (admin).
     */
    match /employeeActions/{employeeActionId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Control access to order data. Public read, writes must be controlled.
     * @path /orders/{orderId}
     * @allow (get, list) Any authenticated user can read order data.
     * @deny (create, update, delete) No one can write to order data without specific authorization (TODO: Define authorization)
     * @principle Public read access with restricted writes.
     */
    match /orders/{orderId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }
  }
}