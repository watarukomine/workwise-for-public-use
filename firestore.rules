/**
 * @file Firebase Security Rules for Firestore.
 * @description This ruleset enforces a strict user-ownership model for staff-related data and allows open access to customer and jobsite data.
 *
 * Data Structure:
 * - /staff/{staffId}: Stores staff member data, accessible only by the staff member themselves.
 * - /customers/{customerId}: Stores customer data, accessible by any authenticated user.
 * - /staff/{staffId}/workSchedules/{workScheduleId}: Stores work schedule data, accessible only by the associated staff member.
 * - /jobsites/{jobsiteId}: Stores jobsite data, accessible by any authenticated user.
 * - /staff/{staffId}/employeeActions/{employeeActionId}: Stores employee actions, accessible only by the associated staff member.
 *
 * Key Security Decisions:
 * - Staff members can only access their own data.
 * - Customers and Jobsites data is publicly accessible to any authenticated user.
 * - Listing of staff is not permitted; the query was denied.
 *
 * Denormalization for Authorization:
 *  N/A - The current structure relies on path-based authorization, avoiding the need for denormalization.
 *
 * Structural Segregation:
 *  N/A - There is no need for segregation of public and private data. All data for staff members is private and nested under their respective user ID.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    //  Helper function to determine if a user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Utility function to check if the request is made by the owner
    function isOwner(staffId) {
      return request.auth != null && request.auth.uid == staffId;
    }

    // Utility function to check if the request is made by the owner and the resource exists
    function isExistingOwner(staffId) {
      return isOwner(staffId) && exists(resource);
    }

    /**
     * @description Manages access to staff member documents.
     * @path /staff/{staffId}
     */
    match /staff/{staffId} {
      allow get: if isOwner(staffId);
      allow list: if false; // Listing staff is not permitted.
      allow create: if isOwner(staffId);
      allow update: if isExistingOwner(staffId);
      allow delete: if isExistingOwner(staffId);
    }

    /**
     * @description Manages access to customer documents.
     * @path /customers/{customerId}
     */
    match /customers/{customerId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }

    /**
     * @description Manages access to work schedule documents nested under a specific staff member.
     * @path /staff/{staffId}/workSchedules/{workScheduleId}
     */
    match /staff/{staffId}/workSchedules/{workScheduleId} {
      allow get, list: if isOwner(staffId);
      allow create: if isOwner(staffId);
      allow update: if isExistingOwner(staffId);
      allow delete: if isExistingOwner(staffId);
    }

    /**
     * @description Manages access to jobsite documents.
     * @path /jobsites/{jobsiteId}
     */
    match /jobsites/{jobsiteId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }

    /**
     * @description Manages access to employee actions documents nested under a specific staff member.
     * @path /staff/{staffId}/employeeActions/{employeeActionId}
     */
    match /staff/{staffId}/employeeActions/{employeeActionId} {
      allow get, list: if isOwner(staffId);
      allow create: if isOwner(staffId);
      allow update: if isExistingOwner(staffId);
      allow delete: if isExistingOwner(staffId);
    }
  }
}