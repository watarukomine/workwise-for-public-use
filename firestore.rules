/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for all data.
 *
 * Data Structure:
 * - /staff/{staffId}: Stores staff member data.
 * - /customers/{customerId}: Stores customer data.
 * - /jobsites/{jobsiteId}: Stores jobsite data.
 * - /workSchedules/{workScheduleId}: Stores work schedule data.
 * - /employeeActions/{employeeActionId}: Stores employee action data.
 *
 * Key Security Decisions:
 * - All collections are restricted to authenticated users.
 * - No user listing is allowed.
 * - Write operations are restricted to authenticated users.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     * @returns {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's ID matches the provided user ID.
     * @param {string} userId - The user ID to compare against.
     * @returns {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user's ID matches the provided user ID and the resource exists
     * @param {string} userId - The user ID to compare against.
     * @returns {boolean} True if the user is the owner, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Rules for the /staff/{staffId} collection.
     * @path /staff/{staffId}
     * @allow (create) Signed-in user creates a staff document with their own ID.
     * @deny (create) Signed-in user tries to create a staff document with someone else's ID.
     * @principle Enforces document ownership for writes.
     */
    match /staff/{staffId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && isOwner(staffId);
      allow update: if isExistingOwner(staffId);
      allow delete: if isExistingOwner(staffId);
    }

    /**
     * @description Rules for the /customers/{customerId} collection.
     * @path /customers/{customerId}
     * @allow (create) Signed-in user creates a customer document with their own ID.
     * @deny (create) Signed-in user tries to create a customer document with someone else's ID.
     * @principle Enforces document ownership for writes.
     */
    match /customers/{customerId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Rules for the /jobsites/{jobsiteId} collection.
     * @path /jobsites/{jobsiteId}
     * @allow (create) Signed-in user creates a jobsite document with their own ID.
     * @deny (create) Signed-in user tries to create a jobsite document with someone else's ID.
     * @principle Enforces document ownership for writes.
     */
    match /jobsites/{jobsiteId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Rules for the /workSchedules/{workScheduleId} collection.
     * @path /workSchedules/{workScheduleId}
     * @allow (create) Signed-in user creates a workSchedule document with their own ID.
     * @deny (create) Signed-in user tries to create a workSchedule document with someone else's ID.
     * @principle Enforces document ownership for writes.
     */
    match /workSchedules/{workScheduleId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Rules for the /employeeActions/{employeeActionId} collection.
     * @path /employeeActions/{employeeActionId}
     * @allow (create) Signed-in user creates a employeeAction document with their own ID.
     * @deny (create) Signed-in user tries to create a employeeAction document with someone else's ID.
     * @principle Enforces document ownership for writes.
     */
    match /employeeActions/{employeeActionId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

        /**
     * @description Rules for the /orders collection.
     * @path /orders
     * @allow (list) No one can list orders.
     * @principle  Denies all listing of orders due to explicit error in application.
     */
    match /orders/{orderId} {
      allow get: if false;
      allow list: if false; // This rule addresses the original error report.
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}