/**
 * @fileoverview Firestore Security Rules for WorkWise application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for staff-related data
 * (work schedules, employee actions).  Customer and location data is publicly readable.
 *
 * Data Structure:
 * - /staff/{staffId}: Stores staff member profiles. Only the staff member can read/write their own profile.
 * - /customers/{customerId}: Stores customer profiles. Publicly readable.
 * - /staff/{staffId}/workSchedules/{workScheduleId}: Stores work schedules for each staff member. Only the staff member can read/write their schedules.
 * - /locations/{locationId}: Stores location information. Publicly readable.
 * - /staff/{staffId}/employeeActions/{employeeActionId}: Stores employee actions for each staff member. Only the staff member can read/write their actions.
 *
 * Key Security Decisions:
 * - User listing is disallowed.
 * - Public read access is granted to the /customers and /locations collections.
 * - All write operations on staff-owned data are restricted to the owning staff member.
 *
 * Denormalization for Authorization:
 *  - Not required due to path-based ownership.
 *
 * Structural Segregation:
 *  - Private staff data is stored under /staff/{staffId}, while public data (customers, locations) resides in top-level collections.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Rule for staff member profiles.
     * @path /staff/{staffId}
     * @allow (create, update, delete) if the request is made by the staff member (isOwner).
     * @allow (get, list) if the request is made by the staff member (isOwner).
     * @deny (create, update, delete) if the request is not made by the staff member.
     * @deny (get, list) if the request is not made by the staff member.
     * @principle Enforces document ownership for staff profiles.
     */
    match /staff/{staffId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(staffId);
      allow list: if false; // Explicitly disallowing listing of staff members.
      allow create: if isOwner(staffId) && request.resource.data.id == staffId;
      allow update: if isExistingOwner(staffId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(staffId);
    }

    /**
     * @description Rule for customer profiles.
     * @path /customers/{customerId}
     * @allow (get, list) to everyone.
     * @deny (create, update, delete) to everyone.
     * @principle Allows public read access to customer profiles.
     */
    match /customers/{customerId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Rule for work schedules belonging to a staff member.
     * @path /staff/{staffId}/workSchedules/{workScheduleId}
     * @allow (create, update, delete) if the request is made by the staff member (isOwner).
     * @allow (get, list) if the request is made by the staff member (isOwner).
     * @deny (create, update, delete) if the request is not made by the staff member.
     * @deny (get, list) if the request is not made by the staff member.
     * @principle Enforces document ownership for work schedules.
     */
    match /staff/{staffId}/workSchedules/{workScheduleId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(staffId);
      allow list: if isOwner(staffId);
      allow create: if isOwner(staffId);
      allow update: if isExistingOwner(staffId);
      allow delete: if isExistingOwner(staffId);
    }

    /**
     * @description Rule for location information.
     * @path /locations/{locationId}
     * @allow (get, list) to everyone.
     * @deny (create, update, delete) to everyone.
     * @principle Allows public read access to location information.
     */
    match /locations/{locationId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Rule for employee actions belonging to a staff member.
     * @path /staff/{staffId}/employeeActions/{employeeActionId}
     * @allow (create, update, delete) if the request is made by the staff member (isOwner).
     * @allow (get, list) if the request is made by the staff member (isOwner).
     * @deny (create, update, delete) if the request is not made by the staff member.
     * @deny (get, list) if the request is not made by the staff member.
     * @principle Enforces document ownership for employee actions.
     */
    match /staff/{staffId}/employeeActions/{employeeActionId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
        function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(staffId);
      allow list: if isOwner(staffId);
      allow create: if isOwner(staffId);
      allow update: if isExistingOwner(staffId);
      allow delete: if isExistingOwner(staffId);
    }
  }
}