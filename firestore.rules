/**
 * @fileoverview Firestore Security Rules for WorkWise application.
 *
 * Core Philosophy:
 * This ruleset enforces a hybrid security model. Staff members have ownership-based access to their own profiles and actions, while application admins manage customer, work schedule, and location data.
 *
 * Data Structure:
 * - /staff/{staffId}: Stores individual staff profiles, accessible only by the staff member themselves (or an admin, if roles are implemented).
 * - /customers/{customerId}: Stores customer information, managed by admins.
 * - /workSchedules/{workScheduleId}: Stores work schedules, managed by admins.
 * - /locations/{locationId}: Stores location data, managed by admins.
 * - /staff/{staffId}/employeeActions/{employeeActionId}: Stores individual employee actions, accessible only by the staff member themselves (or an admin).
 * - /roles_admin/{uid}: Indicates admin role for the user with matching uid. Existence of the document grants admin privileges.
 *
 * Key Security Decisions:
 * - Admins are granted full access to customer, work schedule, and location data.
 * - Staff members can only access their own profile data and employee actions.
 * - Listing of customers, work schedules, and locations is allowed for admins only.
 * - User listing is explicitly disallowed.
 *
 * Denormalization for Authorization:
 * The `staffId` field is denormalized into the `/staff/{staffId}/employeeActions/{employeeActionId}` documents to allow for efficient ownership checks without requiring additional reads.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the current user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the current user's UID matches the provided userId.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is an admin.
     */
    function isAdmin() {
       return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
    /**
     * @description Checks if the user is an admin and that the document exists.
     */
    function isExistingAdmin() {
      return isAdmin() && resource != null;
    }

    /**
     * @description Checks if the user is the owner and that the document exists.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Rules for the /staff/{staffId} collection.
     * @path /staff/{staffId}
     * @allow (create) User with UID 'user123' can create a document where staffId is 'user123'.
     * @allow (get, update, delete) User with UID 'user123' can get, update, or delete the document where staffId is 'user123'.
     * @deny (create) User with UID 'user456' cannot create a document where staffId is 'user123'.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /staff/{staffId} {
      allow get: if isSignedIn() && isOwner(staffId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(staffId) && request.resource.data.id == staffId;
      allow update: if isExistingOwner(staffId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(staffId);
    }

     /**
      * @description Rules for the /customers/{customerId} collection.
      * @path /customers/{customerId}
      * @allow (get, list, create, update, delete) Admin user can get, list, create, update, and delete customer data.
      * @deny (get, list, create, update, delete) Non-admin user cannot get, list, create, update, or delete customer data.
      * @principle Restricts customer data management to authorized admins.
      */
    match /customers/{customerId} {
        allow get: if isAdmin();
        allow list: if isAdmin();
        allow create: if isAdmin();
        allow update: if isExistingAdmin();
        allow delete: if isExistingAdmin();
    }

    /**
     * @description Rules for the /workSchedules/{workScheduleId} collection.
     * @path /workSchedules/{workScheduleId}
     * @allow (get, list, create, update, delete) Admin user can get, list, create, update, and delete work schedule data.
     * @deny (get, list, create, update, delete) Non-admin user cannot get, list, create, update, or delete work schedule data.
     * @principle Restricts work schedule data management to authorized admins.
     */
    match /workSchedules/{workScheduleId} {
        allow get: if isAdmin();
        allow list: if isAdmin();
        allow create: if isAdmin();
        allow update: if isExistingAdmin();
        allow delete: if isExistingAdmin();
    }

    /**
     * @description Rules for the /locations/{locationId} collection.
     * @path /locations/{locationId}
     * @allow (get, list, create, update, delete) Admin user can get, list, create, update, and delete location data.
     * @deny (get, list, create, update, delete) Non-admin user cannot get, list, create, update, or delete location data.
     * @principle Restricts location data management to authorized admins.
     */
    match /locations/{locationId} {
        allow get: if isAdmin();
        allow list: if isAdmin();
        allow create: if isAdmin();
        allow update: if isExistingAdmin();
        allow delete: if isExistingAdmin();
    }

    /**
     * @description Rules for the /staff/{staffId}/employeeActions/{employeeActionId} collection.
     * @path /staff/{staffId}/employeeActions/{employeeActionId}
     * @allow (create) User with UID 'user123' can create an employee action where staffId is 'user123'.
     * @allow (get, update, delete) User with UID 'user123' can get, update, or delete the employee action where staffId is 'user123'.
     * @deny (create) User with UID 'user456' cannot create an employee action where staffId is 'user123'.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /staff/{staffId}/employeeActions/{employeeActionId} {
      allow get: if isSignedIn() && isOwner(staffId);
      allow list: if isSignedIn() && isOwner(staffId);
      allow create: if isSignedIn() && isOwner(staffId) && request.resource.data.staffId == staffId;
      allow update: if isExistingOwner(staffId) && request.resource.data.staffId == resource.data.staffId;
      allow delete: if isExistingOwner(staffId);
    }
    /**
     * @description Rules for the /roles_admin/{uid} collection.
     * @path /roles_admin/{uid}
     * @allow (create) User with UID 'admin123' can create a document where uid is 'admin123'.
     * @allow (get, update, delete) User with UID 'admin123' can get, update, or delete the document where uid is 'admin123'.
     * @deny (create) User with UID 'user456' cannot create a document where uid is 'admin123'.
     */
    match /roles_admin/{uid} {
        allow get: if isAdmin();
        allow list: if false;
        allow create: if isSignedIn() && isOwner(uid);
        allow update: if false;
        allow delete: if false;
    }
  }
}