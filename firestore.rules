/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for staff-related data and broader access for customers and jobsites.
 *
 * Data Structure:
 * - /staff/{staffId}: Stores individual staff member data, accessible only by the staff member themselves.
 * - /customers/{customerId}: Stores customer data. Access is open (in this prototype).
 * - /jobsites/{jobsiteId}: Stores jobsite data. Access is open (in this prototype).
 * - /staff/{staffId}/workSchedules/{workScheduleId}: Stores work schedules, accessible only by the associated staff member.
 * - /staff/{staffId}/employeeActions/{employeeActionId}: Stores employee actions, accessible only by the associated staff member.
 *
 * Key Security Decisions:
 * - Staff members can only read and write their own staff document and related subcollections (workSchedules, employeeActions).
 * - Listing of the `/staff` collection is denied to all users.
 * - Customer and Jobsite data is publicly readable (get, list). Writes are currently open (in this prototype) but should be secured in a production environment.
 *
 * Denormalization for Authorization:
 * - The rules rely on path-based authorization to ensure that a staff member can only access data under their own `staffId`. No `get()` calls are needed.
 *
 * Structural Segregation:
 * - Private data (workSchedules, employeeActions) is stored under user-specific subcollections, while potentially public data (customers, jobsites) resides in top-level collections.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to the /staff collection. Staff members can only read/write their own document.
     * @path /staff/{staffId}
     */
    match /staff/{staffId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(staffId) {
        return isSignedIn() && request.auth.uid == staffId;
      }

      function isExistingOwner(staffId) {
        return isOwner(staffId) && resource.data != null;
      }

      allow get: if isOwner(staffId);
      // Deny listing the staff collection
      allow list: if false;
      allow create: if isOwner(staffId);
      allow update: if isExistingOwner(staffId);
      allow delete: if isExistingOwner(staffId);
    }

    /**
     * @description Controls access to the /customers collection. Accessible by authorized users.
     * @path /customers/{customerId}
     */
    match /customers/{customerId} {
      allow get, list: if true;
      // CRITICAL: In a production environment, writes to the customer collection should be restricted.
      allow create, update, delete: if true; // TODO: Add authorization checks for customer writes.
    }

    /**
     * @description Controls access to the /staff/{staffId}/workSchedules collection. Only the staff member can access their schedules.
     * @path /staff/{staffId}/workSchedules/{workScheduleId}
     */
    match /staff/{staffId}/workSchedules/{workScheduleId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(staffId) {
        return isSignedIn() && request.auth.uid == staffId;
      }

       function isExistingOwner(staffId) {
        return isOwner(staffId) && resource.data != null;
      }


      allow get: if isOwner(staffId);
      allow list: if isOwner(staffId);
      allow create: if isOwner(staffId);
      allow update: if isExistingOwner(staffId);
      allow delete: if isExistingOwner(staffId);
    }

    /**
     * @description Controls access to the /jobsites collection. Accessible by authorized users.
     * @path /jobsites/{jobsiteId}
     */
    match /jobsites/{jobsiteId} {
      allow get, list: if true;
      // CRITICAL: In a production environment, writes to the jobsite collection should be restricted.
      allow create, update, delete: if true; // TODO: Add authorization checks for jobsite writes.
    }

    /**
     * @description Controls access to the /staff/{staffId}/employeeActions collection. Only the staff member and admins can access the actions.
     * @path /staff/{staffId}/employeeActions/{employeeActionId}
     */
    match /staff/{staffId}/employeeActions/{employeeActionId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(staffId) {
        return isSignedIn() && request.auth.uid == staffId;
      }

      function isExistingOwner(staffId) {
        return isOwner(staffId) && resource.data != null;
      }

      allow get: if isOwner(staffId);
      allow list: if isOwner(staffId);
      allow create: if isOwner(staffId);
      allow update: if isExistingOwner(staffId);
      allow delete: if isExistingOwner(staffId);
    }
  }
}