/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control model with user-ownership where appropriate.
 *
 * Data Structure:
 * - /users/{userId}: User profile information, accessible to the user and admins.
 * - /staff/{staffId}: Staff profiles, managed by admins.
 * - /customers/{customerId}: Customer profiles, managed by admins.
 * - /schedules/{scheduleId}: Work schedules, managed by admins.
 * - /locations/{locationId}: Location data, managed by admins.
 * - /staff/{staffId}/employee_actions/{employeeActionId}: Employee actions, manageable by the staff member and admins.
 * - /config/admins: Configuration document storing a list of admin UIDs.
 *
 * Key Security Decisions:
 * - Strict user-ownership for user profiles.
 * - Admin-only access for managing staff, customers, schedules, and locations.
 * - Admins can manage any employee action, but staff can only manage their own.
 * - Listing the `/users` collection is denied to prevent information disclosure.
 *
 * Denormalization for Authorization:
 * - The rules rely on the `config/admins` document to efficiently determine admin privileges.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Protects the admin configuration document.
     * @path /databases/{database}/documents/config/admins
     * @allow (get) If the request is authenticated.
     * @deny (list) Listing is not allowed.
     * @deny (create) Only the system can create this document.
     * @deny (update) Only the system can update this document.
     * @deny (delete) Only the system can delete this document.
     * @principle Enforces a singleton admin configuration document.
     */
    match /config/admins {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to user profile data.
     * @path /databases/{database}/documents/users/{userId}
     * @allow (get) If the user is the owner or an admin.
     * @allow (list) If the user is the owner.
     * @allow (create) If the user is creating their own profile.
     * @allow (update) If the user is the owner or an admin.
     * @allow (delete) If the user is the owner or an admin.
     * @principle Enforces user ownership for profiles and admin override.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId) || isAdmin();
      allow delete: if isExistingOwner(userId) || isAdmin();
    }

    /**
     * @description Controls access to staff profiles.
     * @path /databases/{database}/documents/staff/{staffId}
     * @allow (get) If the user is an admin.
     * @allow (list) If the user is an admin.
     * @allow (create) If the user is an admin.
     * @allow (update) If the user is an admin.
     * @allow (delete) If the user is an admin.
     * @principle Restricts staff data management to admins.
     */
    match /staff/{staffId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Controls access to customer profiles.
     * @path /databases/{database}/documents/customers/{customerId}
     * @allow (get) If the user is an admin.
     * @allow (list) If the user is an admin.
     * @allow (create) If the user is an admin.
     * @allow (update) If the user is an admin.
     * @allow (delete) If the user is an admin.
     * @principle Restricts customer data management to admins.
     */
    match /customers/{customerId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Controls access to work schedules.
     * @path /databases/{database}/documents/schedules/{scheduleId}
     * @allow (get) If the user is an admin.
     * @allow (list) If the user is an admin.
     * @allow (create) If the user is an admin.
     * @allow (update) If the user is an admin.
     * @allow (delete) If the user is an admin.
     * @principle Restricts schedule data management to admins.
     */
    match /schedules/{scheduleId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Controls access to location data.
     * @path /databases/{database}/documents/locations/{locationId}
     * @allow (get) If the user is an admin.
     * @allow (list) If the user is an admin.
     * @allow (create) If the user is an admin.
     * @allow (update) If the user is an admin.
     * @allow (delete) If the user is an admin.
     * @principle Restricts location data management to admins.
     */
    match /locations/{locationId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Controls access to employee actions, allowing staff to manage their own and admins to manage all.
     * @path /databases/{database}/documents/staff/{staffId}/employee_actions/{employeeActionId}
     * @allow (get) If the user is the staff member or an admin.
     * @allow (list) If the user is the staff member or an admin.
     * @allow (create) If the user is the staff member or an admin.
     * @allow (update) If the user is the staff member or an admin.
     * @allow (delete) If the user is the staff member or an admin.
     * @principle Enforces ownership for staff actions and admin override.
     */
    match /staff/{staffId}/employee_actions/{employeeActionId} {
      allow get: if isStaffOwner(staffId) || isAdmin();
      allow list: if isStaffOwner(staffId) || isAdmin();
      allow create: if isStaffOwner(staffId) || isAdmin();
      allow update: if (isStaffOwner(staffId) || isAdmin()) && resource != null;
      allow delete: if (isStaffOwner(staffId) || isAdmin()) && resource != null;
    }

    // ---- Helper functions ----

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

     function isStaffOwner(staffId) {
      return request.auth.uid == staffId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.uid in getAdminUids();
    }

    function getAdminUids() {
      return get(/databases/$(database)/documents/config/admins).data.admin_uids;
    }
  }
}