/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control model with user-owned profiles and admin-managed data.
 *
 * Data Structure:
 * - /users/{userId}: User profile information, accessible only to the user and admins.
 * - /staff/{staffId}: Staff member profiles, managed by admins only.
 * - /customers/{customerId}: Customer profiles, managed by admins only.
 * - /schedules/{scheduleId}: Work schedules, managed by admins only.
 * - /locations/{locationId}: Location data, managed by admins only.
 * - /staff/{staffId}/employee_actions/{employeeActionId}: Employee actions, managed by the associated staff member and admins.
 * - /config/admins: Configuration document storing a list of admin UIDs, used for admin privilege checks.
 *
 * Key Security Decisions:
 * - User profiles are owned by the user and can only be accessed by that user or an admin.
 * - All other collections (staff, customers, schedules, locations) are managed exclusively by admins.
 * - Listing the /users collection is disallowed, as this could expose sensitive user information.
 * - The /config/admins document is publicly readable to allow rules to determine admin status.
 *
 * Denormalization for Authorization:
 * - Admin status is determined by checking if the user's UID is present in the `admin_uids` array within the /config/admins document.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     * @returns {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user's UID matches the provided userId.
     * @param {string} userId - The user ID to compare against.
     * @returns {boolean} True if the user is signed in and their UID matches the userId, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is an existing owner of a document.
     * @param {string} userId - The user ID to compare against the document's owner.
     * @returns {boolean} True if the document exists, the user is signed in, and their UID matches the userId, false otherwise.
     */
    function isExistingOwner(userId) {
      return resource != null && isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is an admin.
     * @returns {boolean} True if the user's UID is in the admin_uids array in the /config/admins document, false otherwise.
     */
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/config/admins).data.admin_uids.hasAny([request.auth.uid]);
    }
    
    /**
     * @description Rules for user profiles.
     * @path /users/{userId}
     * @allow (get) User with matching {userId} can read their own profile.
     * @allow (create) User can create their own profile if the UID matches the {userId}.
     * @allow (update) User with matching {userId} can update their own profile.
     * @allow (delete) User with matching {userId} can delete their own profile.
     * @deny (get) User tries to read another user's profile.
     * @deny (create) User tries to create a profile with a mismatched UID.
     * @deny (update) User tries to update another user's profile.
     * @deny (delete) User tries to delete another user's profile.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false; // Prevent listing all user profiles.

      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for staff member profiles.
     * @path /staff/{staffId}
     * @allow (get) Admin can read any staff profile.
     * @allow (create) Admin can create a staff profile.
     * @allow (update) Admin can update any staff profile.
     * @allow (delete) Admin can delete any staff profile.
     * @deny (get) Non-admin tries to read a staff profile.
     * @deny (create) Non-admin tries to create a staff profile.
     * @deny (update) Non-admin tries to update a staff profile.
     * @deny (delete) Non-admin tries to delete a staff profile.
     * @principle Restricts access to staff profiles to admins only.
     */
    match /staff/{staffId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Rules for customer profiles.
     * @path /customers/{customerId}
     * @allow (get) Admin can read any customer profile.
     * @allow (create) Admin can create a customer profile.
     * @allow (update) Admin can update any customer profile.
     * @allow (delete) Admin can delete any customer profile.
     * @deny (get) Non-admin tries to read a customer profile.
     * @deny (create) Non-admin tries to create a customer profile.
     * @deny (update) Non-admin tries to update a customer profile.
     * @deny (delete) Non-admin tries to delete a customer profile.
     * @principle Restricts access to customer profiles to admins only.
     */
    match /customers/{customerId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Rules for work schedules.
     * @path /schedules/{scheduleId}
     * @allow (get) Admin can read any schedule.
     * @allow (create) Admin can create a schedule.
     * @allow (update) Admin can update any schedule.
     * @allow (delete) Admin can delete any schedule.
     * @deny (get) Non-admin tries to read a schedule.
     * @deny (create) Non-admin tries to create a schedule.
     * @deny (update) Non-admin tries to update a schedule.
     * @deny (delete) Non-admin tries to delete a schedule.
     * @principle Restricts access to work schedules to admins only.
     */
    match /schedules/{scheduleId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Rules for location data.
     * @path /locations/{locationId}
     * @allow (get) Admin can read any location data.
     * @allow (create) Admin can create location data.
     * @allow (update) Admin can update any location data.
     * @allow (delete) Admin can delete any location data.
     * @deny (get) Non-admin tries to read location data.
     * @deny (create) Non-admin tries to create location data.
     * @deny (update) Non-admin tries to update location data.
     * @deny (delete) Non-admin tries to delete location data.
     * @principle Restricts access to location data to admins only.
     */
    match /locations/{locationId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Rules for employee actions.
     * @path /staff/{staffId}/employee_actions/{employeeActionId}
     * @allow (get) Staff can read their own employee actions, and admins can read any.
     * @allow (create) Staff can create their own employee actions, and admins can create any.
     * @allow (update) Staff can update their own employee actions, and admins can update any.
     * @allow (delete) Staff can delete their own employee actions, and admins can delete any.
     * @deny (get) Staff tries to read another staff member's actions.
     * @deny (create) Staff tries to create actions for another staff member.
     * @deny (update) Staff tries to update actions for another staff member.
     * @deny (delete) Staff tries to delete actions for another staff member.
     * @principle Enforces ownership for staff-related data, allows admin override.
     */
    match /staff/{staffId}/employee_actions/{employeeActionId} {
      allow get: if isOwner(staffId) || isAdmin();
      allow list: if isOwner(staffId) || isAdmin();
      allow create: if isOwner(staffId) || isAdmin();
      allow update: if (isOwner(staffId) || isAdmin()) && resource != null;
      allow delete: if (isOwner(staffId) || isAdmin()) && resource != null;
    }

    /**
     * @description Rules for the admin configuration document.
     * @path /config/admins
     * @allow (get) Anyone can read the admin config.
     * @deny (create) No one can create this document through the rules (it must be created manually).
     * @deny (update) No one can update this document through the rules (it must be updated manually).
     * @deny (delete) No one can delete this document through the rules (it must be deleted manually).
     * @principle Allows public read access for admin status checks, restricts modification.
     */
    match /config/admins {
      allow get: if true;
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}