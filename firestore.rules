rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows any authenticated user to read customer data.
     * @path /customers/{customerId}
     * @allow (get, list) Any authenticated user can read customer data.
     * @deny (create, update, delete) Only authenticated users can modify customer data.
     * @principle Allows public read access for customers and owner-only writes.
     */
    match /customers/{customerId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }

    /**
     * @description Manages staff member data.
     * @path /staff/{staffId}
     * @allow (create, update, delete) Only the owner can create, update, and delete their staff document.
     * @allow (get, list) Any authenticated user can read staff data.
     * @deny (create, update, delete) Prevents non-owners from modifying staff data.
     * @principle Enforces document ownership for writes.
     */
    match /staff/{staffId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if request.auth.uid == staffId;
    }

    /**
     * @description Manages work schedule data.
     * @path /workSchedules/{workScheduleId}
     * @allow (create, update, delete) Only the owner can create, update, and delete their work schedule document.
     * @allow (get, list) Any authenticated user can read work schedule data.
     * @deny (create, update, delete) Prevents non-owners from modifying work schedule data.
     * @principle Enforces document ownership for writes.
     */
    match /workSchedules/{workScheduleId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if request.auth.uid == workScheduleId;
    }

    /**
     * @description Manages location data.
     * @path /locations/{locationId}
     * @allow (create, update, delete) Only the owner can create, update, and delete their location document.
     * @allow (get, list) Any authenticated user can read location data.
     * @deny (create, update, delete) Prevents non-owners from modifying location data.
     * @principle Enforces document ownership for writes.
     */
    match /locations/{locationId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if request.auth.uid == locationId;
    }

    /**
     * @description Manages employee action data.
     * @path /employeeActions/{employeeActionId}
     * @allow (create, update, delete) Only the owner can create, update, and delete their employee action document.
     * @allow (get, list) Any authenticated user can read employee action data.
     * @deny (create, update, delete) Prevents non-owners from modifying employee action data.
     * @principle Enforces document ownership for writes.
     */
    match /employeeActions/{employeeActionId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if request.auth.uid == employeeActionId;
    }

    /**
     * @description Marks a user as staff based on the existence of this document.
     * @path /roles_staff/{userId}
     * @allow create: if request.auth.uid == userId;
     * @allow get: if isSignedIn();
     * @allow list: if false;
     * @allow update: if false;
     * @allow delete: if request.auth.uid == userId;
     * @deny (create, update, delete) Prevents non-owners from modifying employee action data.
     * @principle Enforces document ownership for writes.
     */
    match /roles_staff/{userId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create, update, delete: if request.auth.uid == userId;
    }
  }

  // Helper function to determine if the user is signed in.
  function isSignedIn() {
    return request.auth != null;
  }

  // Helper function to determine if the user is the owner of the document.
  function isOwner(userId) {
    return request.auth.uid == userId;
  }
}