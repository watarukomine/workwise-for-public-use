/**
 * @fileoverview Firestore Security Rules for WorkWise application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for staff data,
 * while allowing general authenticated access to customer, location, and work schedule data.
 * Employee actions are secured under the respective staff member's document.
 *
 * Data Structure:
 * - /staff/{staffId}: Stores staff member details; only accessible to the staff member themselves.
 * - /customers/{customerId}: Stores customer details; accessible to any authenticated user.
 * - /locations/{locationId}: Stores location details; accessible to any authenticated user.
 * - /workSchedules/{workScheduleId}: Stores work schedule entries; accessible to any authenticated user.
 * - /staff/{staffId}/employeeActions/{employeeActionId}: Stores employee actions; accessible only to the staff member.
 *
 * Key Security Decisions:
 * - Staff members can only access their own documents and associated employee actions.
 * - Listing of staff members is disallowed for security reasons.
 * - Customer, location, and work schedule data is accessible to any authenticated user.
 * - Authentication is required to access most parts of the database.
 * - No data validation is performed (prototyping mode).
 *
 * Denormalization for Authorization:
 *  - The `staffId` is used both in the path for `/staff/{staffId}` and as a field in the `EmployeeAction` documents nested under the staff member. This allows for simple, efficient ownership checks.
 *
 * Structural Segregation:
 *  - Employee actions are stored as a subcollection of staff documents, ensuring clear ownership and simplified security rules.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Defines the security rules for the 'staff' collection.
     * @path /staff/{staffId}
     * @allow (create) Authenticated user creates their own staff document.
     * @deny (create) Authenticated user tries to create a staff document for another user.
     * @allow (get) Authenticated user reads their own staff document.
     * @deny (get) Authenticated user tries to read another user's staff document.
     * @allow (update) Authenticated user updates their own staff document.
     * @deny (update) Authenticated user tries to update another user's staff document.
     * @allow (delete) Authenticated user deletes their own staff document.
     * @deny (delete) Authenticated user tries to delete another user's staff document.
     * @principle Enforces document ownership for staff data.
     */
    match /staff/{staffId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(staffId);
      // Listing staff is not permitted.
      allow list: if false;
      allow create: if isOwner(staffId);
      allow update: if isExistingOwner(staffId);
      allow delete: if isExistingOwner(staffId);
    }

    /**
     * @description Defines the security rules for the 'customers' collection.
     * @path /customers/{customerId}
     * @allow (get) Any authenticated user can read customer data.
     * @allow (create) Any authenticated user can create customer data.
     * @allow (update) Any authenticated user can update customer data.
     * @allow (delete) Any authenticated user can delete customer data.
     * @principle Allows general authenticated access to customer data.
     */
    match /customers/{customerId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Defines the security rules for the 'locations' collection.
     * @path /locations/{locationId}
     * @allow (get) Any authenticated user can read location data.
     * @allow (create) Any authenticated user can create location data.
     * @allow (update) Any authenticated user can update location data.
     * @allow (delete) Any authenticated user can delete location data.
     * @principle Allows general authenticated access to location data.
     */
    match /locations/{locationId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Defines the security rules for the 'workSchedules' collection.
     * @path /workSchedules/{workScheduleId}
     * @allow (get) Any authenticated user can read work schedule data.
     * @allow (create) Any authenticated user can create work schedule data.
     * @allow (update) Any authenticated user can update work schedule data.
     * @allow (delete) Any authenticated user can delete work schedule data.
     * @principle Allows general authenticated access to work schedule data.
     */
    match /workSchedules/{workScheduleId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Defines the security rules for the 'employeeActions' subcollection under each staff member.
     * @path /staff/{staffId}/employeeActions/{employeeActionId}
     * @allow (create) Authenticated user creates an employee action for their own staff document.
     * @deny (create) Authenticated user tries to create an employee action for another user's staff document.
     * @allow (get) Authenticated user reads their own employee action.
     * @deny (get) Authenticated user tries to read another user's employee action.
     * @allow (update) Authenticated user updates their own employee action.
     * @deny (update) Authenticated user tries to update another user's employee action.
     * @allow (delete) Authenticated user deletes their own employee action.
     * @deny (delete) Authenticated user tries to delete another user's employee action.
     * @principle Enforces document ownership for employee action data, scoped to the staff member.
     */
    match /staff/{staffId}/employeeActions/{employeeActionId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(staffId);
      allow list: if isOwner(staffId);
      allow create: if isOwner(staffId);
      allow update: if isExistingOwner(staffId);
      allow delete: if isExistingOwner(staffId);
    }
  }
}