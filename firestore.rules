/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for staff-related data and public read access for customer and jobsite data.
 *
 * Data Structure:
 * - /staff/{staffId}: Stores staff member data, accessible only to the staff member themselves.
 * - /customers/{customerId}: Stores customer data, publicly readable.
 * - /staff/{staffId}/workSchedules/{workScheduleId}: Stores work schedules for a staff member, accessible only to that staff member.
 * - /jobsites/{jobsiteId}: Stores jobsite data, publicly readable.
 * - /staff/{staffId}/employeeActions/{employeeActionId}: Stores employee actions, accessible only to the staff member.
 *
 * Key Security Decisions:
 * - Staff members can only access their own data (ownership model).
 * - Listing of staff and employee action collections is restricted to the owner.
 * - Customer and jobsite data are publicly readable.
 *
 * Denormalization for Authorization:
 * - The `staffId` is used in the path to establish ownership, avoiding the need for `get()` calls.
 *
 * Structural Segregation:
 * - Publicly readable data (customers, jobsites) is stored in top-level collections, separate from private user data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to staff member data.
     * @path /staff/{staffId}
     * @allow (get, list) if request.auth.uid == staffId; (read)
     * @allow (create, update, delete) if request.auth.uid == staffId; (write)
     * @deny (get, list) if request.auth.uid != staffId; (read)
     * @deny (create, update, delete) if request.auth.uid != staffId; (write)
     * @principle Enforces document ownership for writes.
     */
    match /staff/{staffId} {
      allow get: if isSignedIn() && isOwner(staffId);
      allow list: if false; // Listing staff is disabled

      allow create: if isSignedIn() && isOwner(staffId) && request.resource.data.id == staffId;
      allow update: if isSignedIn() && isExistingOwner(staffId) && request.resource.data.id == resource.data.id;
      allow delete: if isSignedIn() && isExistingOwner(staffId);
    }

    /**
     * @description Controls access to customer data.
     * @path /customers/{customerId}
     * @allow (get, list) if true; (read)
     * @allow (create, update, delete) if false; (write)
     * @deny (create, update, delete) if true; (write)
     * @principle Allows public read access.
     */
    match /customers/{customerId} {
      allow get, list: if true; // Public read

      allow create: if false; // TODO: Add authorization logic for creating customers
      allow update: if false; // TODO: Add authorization logic for updating customers
      allow delete: if false; // TODO: Add authorization logic for deleting customers
    }

    /**
     * @description Controls access to work schedule data for a specific staff member.
     * @path /staff/{staffId}/workSchedules/{workScheduleId}
     * @allow (get, list) if request.auth.uid == staffId; (read)
     * @allow (create, update, delete) if request.auth.uid == staffId; (write)
     * @deny (get, list) if request.auth.uid != staffId; (read)
     * @deny (create, update, delete) if request.auth.uid != staffId; (write)
     * @principle Restricts access to a user's own data tree.
     */
    match /staff/{staffId}/workSchedules/{workScheduleId} {
      allow get: if isSignedIn() && isOwner(staffId);
      allow list: if isSignedIn() && isOwner(staffId);

      allow create: if isSignedIn() && isOwner(staffId) && request.resource.data.staffId == staffId;
      allow update: if isSignedIn() && isExistingOwner(staffId) && request.resource.data.staffId == staffId;
      allow delete: if isSignedIn() && isExistingOwner(staffId);
    }

    /**
     * @description Controls access to jobsite data.
     * @path /jobsites/{jobsiteId}
     * @allow (get, list) if true; (read)
     * @allow (create, update, delete) if false; (write)
     * @deny (create, update, delete) if true; (write)
     * @principle Allows public read access.
     */
    match /jobsites/{jobsiteId} {
      allow get, list: if true;

      allow create: if false; // TODO: Add authorization logic for creating jobsites
      allow update: if false; // TODO: Add authorization logic for updating jobsites
      allow delete: if false; // TODO: Add authorization logic for deleting jobsites
    }

    /**
     * @description Controls access to employee actions for a specific staff member.
     * @path /staff/{staffId}/employeeActions/{employeeActionId}
     * @allow (get, list) if request.auth.uid == staffId; (read)
     * @allow (create, update, delete) if request.auth.uid == staffId; (write)
     * @deny (get, list) if request.auth.uid != staffId; (read)
     * @deny (create, update, delete) if request.auth.uid != staffId; (write)
     * @principle Restricts access to a user's own data tree.
     */
    match /staff/{staffId}/employeeActions/{employeeActionId} {
      allow get: if isSignedIn() && isOwner(staffId);
      allow list: if isSignedIn() && isOwner(staffId);

      allow create: if isSignedIn() && isOwner(staffId) && request.resource.data.staffId == staffId;
      allow update: if isSignedIn() && isExistingOwner(staffId) && request.resource.data.staffId == staffId;
      allow delete: if isSignedIn() && isExistingOwner(staffId);
    }
  }

  // Helper functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }

    function isExistingOwner(userId) {
    return isOwner(userId) && resource != null;
  }
}