rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows users to read and write their own profile data, and admins to read all profiles.
     * @path /users/{userId}
     * @allow (get, create, update, delete) User with matching {userId} can perform these operations.
     * @allow (get) Admin user can perform this operation.
     * @deny (create, update, delete) User attempts to modify another user's profile.
     * @deny (list) Listing users is not permitted.
     * @principle Enforces document ownership for writes and restricts listing.
     */
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Allows admins to manage staff member profiles.
     * @path /staff/{staffId}
     * @allow (create, update, delete, get, list) Admin user can perform these operations.
     * @deny (create, update, delete, get, list) Non-admin user cannot perform these operations.
     * @principle Restricts access to admin users only.
     */
    match /staff/{staffId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Allows admins to manage customer profiles.
     * @path /customers/{customerId}
     * @allow (create, update, delete, get, list) Admin user can perform these operations.
     * @deny (create, update, delete, get, list) Non-admin user cannot perform these operations.
     * @principle Restricts access to admin users only.
     */
    match /customers/{customerId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Allows admins to manage work schedules.
     * @path /schedules/{scheduleId}
     * @allow (create, update, delete, get, list) Admin user can perform these operations.
     * @deny (create, update, delete, get, list) Non-admin user cannot perform these operations.
     * @principle Restricts access to admin users only.
     */
    match /schedules/{scheduleId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Allows admins to manage location data.
     * @path /locations/{locationId}
     * @allow (create, update, delete, get, list) Admin user can perform these operations.
     * @deny (create, update, delete, get, list) Non-admin user cannot perform these operations.
     * @principle Restricts access to admin users only.
     */
    match /locations/{locationId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Allows staff to manage their own employee actions, and admins to manage any.
     * @path /staff/{staffId}/employee_actions/{employeeActionId}
     * @allow (create, update, delete, get, list) Staff can perform these operations on their own actions.
     * @allow (create, update, delete, get, list) Admin user can perform these operations on any action.
     * @deny (create, update, delete, get, list) Staff attempts to modify another staff member's actions.
     * @principle Enforces ownership for staff actions, with admin override.
     */
    match /staff/{staffId}/employee_actions/{employeeActionId} {
      allow get, list: if isSignedIn() && (isOwner(staffId) || isAdmin());
      allow create: if isSignedIn() && (isOwner(staffId) || isAdmin());
      allow update: if isSignedIn() && (isOwner(staffId) || isAdmin());
      allow delete: if isSignedIn() && (isOwner(staffId) || isAdmin());
    }

    /**
     * @description Allows reading the list of admin UIDs.
     * @path /config/admins
     * @allow (get) Any signed-in user can read this document to determine admin status.
     * @deny (create, update, delete, list) No one can create, update, delete, or list this document through the API.
     * @principle Provides admin list for role-based access control.
     */
    match /config/admins {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/config/admins).data.admin_uids is list && request.auth.uid in get(/databases/$(database)/documents/config/admins).data.admin_uids;
    }

    function isExistingOwner(userId) {
        return isOwner(userId);
    }
  }
}