/**
 * @file Firebase Security Rules for Firestore.
 * @description This ruleset enforces a strict user-ownership model for staff-related data and allows broader access to customer and jobsite information.
 *
 * Data Structure:
 * - /staff/{staffId}: Stores staff member data, accessible only by the staff member themselves.
 * - /customers/{customerId}: Stores customer data, accessible to all authenticated users.
 * - /staff/{staffId}/workSchedules/{workScheduleId}: Stores work schedules, accessible only by the associated staff member.
 * - /jobsites/{jobsiteId}: Stores jobsite data, accessible to all authenticated users.
 * - /staff/{staffId}/employeeActions/{employeeActionId}: Stores employee actions, accessible only by the associated staff member.
 *
 * Key Security Decisions:
 * - User data is strictly segregated and accessible only by the owning user.
 * - Listing of staff, work schedules and employee actions is restricted to the owning user.
 * - Customer and jobsite data are publicly readable, but write access is not defined in this prototype.
 * - The rules prioritize security and assume that any unspecified access should be denied.
 *
 * Denormalization for Authorization:
 * - Data is nested under the staff ID to avoid complex queries for authorization.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to staff member documents.
     * @path /staff/{staffId}
     * @allow (get, create, update, delete, list) if the user is the owner of the document.
     * @deny (get, create, update, delete, list) if the user is not authenticated.
     * @principle Enforces document ownership for writes.
     */
    match /staff/{staffId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
      allow get: if true;
      allow list: if false;

      allow create: if isOwner(staffId);
      allow update: if isExistingOwner(staffId);
      allow delete: if isExistingOwner(staffId);
    }

    /**
     * @description Controls access to customer documents.
     * @path /customers/{customerId}
     * @allow (get, list) if true.
     * @deny (create, update, delete) since write access is not defined in this prototype.
     * @principle Allows public read access, restricts write access.
     */
    match /customers/{customerId} {
      allow get: if true;
      allow list: if true;
      allow create: if false; 
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to work schedule documents nested under a staff member.
     * @path /staff/{staffId}/workSchedules/{workScheduleId}
     * @allow (get, create, update, delete, list) if the user is the owner of the parent staff document.
     * @deny (get, create, update, delete, list) if the user is not authenticated or not the owner.
     * @principle Enforces document ownership for writes and restricts access to user-specific data.
     */
    match /staff/{staffId}/workSchedules/{workScheduleId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(staffId);
      allow list: if isOwner(staffId);
      allow create: if isOwner(staffId);
      allow update: if isExistingOwner(staffId);
      allow delete: if isExistingOwner(staffId);
    }

    /**
     * @description Controls access to jobsite documents.
     * @path /jobsites/{jobsiteId}
     * @allow (get, list) if true.
     * @deny (create, update, delete) since write access is not defined in this prototype.
     * @principle Allows public read access, restricts write access.
     */
    match /jobsites/{jobsiteId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to employee action documents nested under a staff member.
     * @path /staff/{staffId}/employeeActions/{employeeActionId}
     * @allow (get, create, update, delete, list) if the user is the owner of the parent staff document.
     * @deny (get, create, update, delete, list) if the user is not authenticated or not the owner.
     * @principle Enforces document ownership for writes and restricts access to user-specific data.
     */
    match /staff/{staffId}/employeeActions/{employeeActionId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
      allow get: if isOwner(staffId);
      allow list: if isOwner(staffId);
      allow create: if isOwner(staffId);
      allow update: if isExistingOwner(staffId);
      allow delete: if isExistingOwner(staffId);
    }
  }
}