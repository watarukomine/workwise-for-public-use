/**
 * @fileoverview Firestore Security Rules for WorkWise application.
 *
 * Core Philosophy:
 * This ruleset enforces a hybrid security model. Staff members have ownership-based access to their own data (profile and actions).
 * Customer, WorkSchedule, and Location data are managed by application admins.
 * A special collection `/roles_admin/{uid}` is used to grant admin privileges, based on document existence.
 *
 * Data Structure:
 * - /staff/{staffId}: Staff profiles, accessible only by the staff member themselves or an admin.
 * - /customers/{customerId}: Customer data, accessible only by admins.
 * - /workSchedules/{workScheduleId}: Work schedule data, accessible only by admins.
 * - /locations/{locationId}: Location data, accessible only by admins.
 * - /staff/{staffId}/employeeActions/{employeeActionId}: Employee actions, accessible only by the staff member themselves or an admin.
 * - /roles_admin/{uid}: Admin role assignments. The existence of a document indicates admin privileges for the given user ID.
 *
 * Key Security Decisions:
 * - Listing customers, work schedules, and locations is only permitted to admins.
 * - Staff members can only access their own profile and employee action data.
 * - Admin status is determined by the presence of a document in the `roles_admin` collection.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Authentication is required for most operations.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user is the owner of the document, based on the provided userId.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Enforces ownership-based access control.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is an existing owner of the document, based on the provided userId.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Enforces existence and ownership-based access control for updates and deletes.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the authenticated user has admin privileges by verifying the existence of an admin role document.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Implements role-based access control for admin users.
     */
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * @description Rules for the /staff/{staffId} collection.
     * @path /staff/{staffId}
     * @allow (get, list) User with uid matching staffId can read their own profile. Admin can read any profile.
     * @allow (create) User with uid matching staffId can create their own profile.
     * @allow (update, delete) User with uid matching staffId can update/delete their own profile. Admin can update/delete any profile.
     * @deny (get, list) User trying to read another staff member's profile.
     * @deny (create) User trying to create a profile with a staffId that doesn't match their uid.
     * @deny (update, delete) User trying to update/delete another staff member's profile.
     * @principle Enforces document ownership for staff profiles. Admins have full access.
     */
    match /staff/{staffId} {
      allow get: if isOwner(staffId) || isAdmin();
      allow list: if isOwner(staffId) || isAdmin();
      allow create: if isOwner(staffId);
      allow update: if isExistingOwner(staffId) || isAdmin();
      allow delete: if isExistingOwner(staffId) || isAdmin();
    }

    /**
     * @description Rules for the /customers/{customerId} collection.
     * @path /customers/{customerId}
     * @allow (get, list) Admins can read customer data.
     * @allow (create, update, delete) Admins can create, update, and delete customer data.
     * @deny (get, list, create, update, delete) Non-admins cannot access customer data.
     * @principle Restricts customer data access to admins only.
     */
    match /customers/{customerId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Rules for the /workSchedules/{workScheduleId} collection.
     * @path /workSchedules/{workScheduleId}
     * @allow (get, list) Admins can read work schedule data.
     * @allow (create, update, delete) Admins can create, update, and delete work schedule data.
     * @deny (get, list, create, update, delete) Non-admins cannot access work schedule data.
     * @principle Restricts work schedule data access to admins only.
     */
    match /workSchedules/{workScheduleId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Rules for the /locations/{locationId} collection.
     * @path /locations/{locationId}
     * @allow (get, list) Admins can read location data.
     * @allow (create, update, delete) Admins can create, update, and delete location data.
     * @deny (get, list, create, update, delete) Non-admins cannot access location data.
     * @principle Restricts location data access to admins only.
     */
    match /locations/{locationId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Rules for the /staff/{staffId}/employeeActions/{employeeActionId} collection.
     * @path /staff/{staffId}/employeeActions/{employeeActionId}
     * @allow (get, list) User with uid matching staffId can read their own employee actions. Admin can read any staff member's actions.
     * @allow (create) User with uid matching staffId can create employee actions under their own profile.
     * @allow (update, delete) User with uid matching staffId can update/delete their own employee actions. Admin can update/delete any employee action.
     * @deny (get, list) User trying to read another staff member's employee actions.
     * @deny (create) User trying to create an employee action under a staffId that doesn't match their uid.
     * @deny (update, delete) User trying to update/delete another staff member's employee actions.
     * @principle Enforces document ownership for employee actions. Admins have full access.
     */
    match /staff/{staffId}/employeeActions/{employeeActionId} {
      allow get: if isOwner(staffId) || isAdmin();
      allow list: if isOwner(staffId) || isAdmin();
      allow create: if isOwner(staffId);
      allow update: if isExistingOwner(staffId) || isAdmin();
      allow delete: if isExistingOwner(staffId) || isAdmin();
    }

    /**
     * @description Rules for the /roles_admin/{uid} collection.
     * @path /roles_admin/{uid}
     * @allow (get) Anyone can get the document. This allows checking for admin status.
     * @allow (create) Only the user with the matching uid can create the document.
     * @allow (update, delete) Only the user with the matching uid can update or delete the document.
     * @deny (list) Listing the collection is not allowed for security.
     * @principle Existence of the document grants admin privileges.
     */
    match /roles_admin/{uid} {
      allow get: if true;
      allow list: if false;
      allow create: if isOwner(uid);
      allow update: if isExistingOwner(uid);
      allow delete: if isExistingOwner(uid);
    }
  }
}