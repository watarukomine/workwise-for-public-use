/**
 * @fileoverview Firestore Security Rules for WorkWise application.
 *
 * Core Philosophy:
 * This ruleset enforces a combination of user-ownership for staff profiles and admin-only access for customer, location, work schedule, and employee action data.
 *
 * Data Structure:
 * - Staff profiles are nested under `/users/{userId}/staff/{staffId}`, ensuring user-specific access.
 * - Customer data resides in `/customers/{customerId}` and is intended for admin use.
 * - Work schedules are stored in `/workSchedules/{workScheduleId}` and are intended for admin use.
 * - Locations are stored in `/locations/{locationId}` and are intended for admin use.
 * - Employee actions are stored in `/employeeActions/{employeeActionId}` and are intended for admin use.
 *
 * Key Security Decisions:
 * - Users can only access their own staff profile data.
 * - Listing of work schedules is restricted.
 * - Customers, locations, and employee actions are only accessible to admins (not implemented in this version, defaults to deny all).
 *
 * Denormalization for Authorization:
 * The `EmployeeAction` entity's schema includes `staffId`, denormalized from `WorkSchedule`. This enables authorization rules for `EmployeeAction` documents without needing to perform additional reads to fetch associated `WorkSchedule` data.
 *
 * Structural Segregation:
 * The use of a user subcollection `/users/{userId}/staff/{staffId}` separates private staff data from public or shared data, allowing for more secure and performant list operations.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces user-ownership for staff profiles. Only the authenticated user can access their own staff profile.
     * @path /users/{userId}/staff/{staffId}
     * @allow (create) - User '0hhwNJRPFMTfqXhnHKGfn2Dz9Oi1' creates their own staff profile with staffId matching userId.
     * @allow (get, update, delete) - User '0hhwNJRPFMTfqXhnHKGfn2Dz9Oi1' reads, updates, or deletes their own staff profile.
     * @deny (create) - User '0hhwNJRPFMTfqXhnHKGfn2Dz9Oi1' tries to create a staff profile under a different userId.
     * @deny (get, update, delete) - User 'anotherUser' tries to read, update, or delete staff profile belonging to '0hhwNJRPFMTfqXhnHKGfn2Dz9Oi1'.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree, validates relational integrity between documents.
     */
    match /users/{userId}/staff/{staffId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Restricts access to customer data to admins only.
     * @path /customers/{customerId}
     * @allow None - No access is granted in this prototype version.
     * @deny All - All operations are denied to all users.
     * @principle Restricts access to a collection.
     */
    match /customers/{customerId} {
      allow get: if false;
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Restricts access to work schedule data.
     * @path /workSchedules/{workScheduleId}
     * @allow None - No access is granted in this prototype version.
     * @deny All - All operations are denied to all users.
     * @principle Restricts access to a collection.
     */
    match /workSchedules/{workScheduleId} {
      allow get: if false;
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Restricts access to location data.
     * @path /locations/{locationId}
     * @allow None - No access is granted in this prototype version.
     * @deny All - All operations are denied to all users.
     * @principle Restricts access to a collection.
     */
    match /locations/{locationId} {
      allow get: if false;
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Restricts access to employee action data.
     * @path /employeeActions/{employeeActionId}
     * @allow None - No access is granted in this prototype version.
     * @deny All - All operations are denied to all users.
     * @principle Restricts access to a collection.
     */
    match /employeeActions/{employeeActionId} {
      allow get: if false;
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
  }
}