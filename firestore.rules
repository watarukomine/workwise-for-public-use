/**
 * @file Firebase Security Rules for Firestore.
 *
 * Core Philosophy:
 * This ruleset enforces a strict authenticated-user-only access model,
 * ensuring that only logged-in users can create, read, update, or delete data.
 * No public access is granted. Each top-level collection requires authentication for all operations.
 *
 * Data Structure:
 * The Firestore database contains the following top-level collections:
 * - /staff/{staffId}: Stores staff member data.
 * - /customers/{customerId}: Stores customer data.
 * - /jobsites/{jobsiteId}: Stores jobsite data.
 * - /workSchedules/{workScheduleId}: Stores work schedule data.
 * - /employeeActions/{employeeActionId}: Stores employee action data.
 *
 * Key Security Decisions:
 * - All read and write operations require user authentication.
 * - No listing of collections is allowed without authentication.
 * - Data validation is minimal, focusing on preventing unauthorized access and ensuring
 *   relational integrity where necessary (e.g., matching user IDs in paths and documents).
 * - The rules explicitly deny any operation not explicitly allowed.
 *
 * Denormalization for Authorization:
 * While the current ruleset doesn't implement denormalization for authorization,
 * future enhancements could benefit from this approach. For example:
 * - Adding a `staffId` field to the `/workSchedules/{workScheduleId}` document would
 *   allow for more efficient authorization checks based on staff ownership.
 * - Including a `customerId` field in the `/employeeActions/{employeeActionId}` document
 *   could enable rules that grant specific customers access to employee action data related to them.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to the /staff collection. Only authenticated users can create, read, update, or delete staff documents.
     * @path /staff/{staffId}
     * @allow (create) User abc can create a staff document if they are authenticated.
     * @deny (create) User abc cannot create a staff document if they are not authenticated.
     * @allow (get) User abc can get a staff document if they are authenticated.
     * @deny (get) User abc cannot get a staff document if they are not authenticated.
     * @allow (list) User abc can list staff documents if they are authenticated.
     * @deny (list) User abc cannot list staff documents if they are not authenticated.
     * @allow (update) User abc can update a staff document if they are authenticated.
     * @deny (update) User abc cannot update a staff document if they are not authenticated.
     * @allow (delete) User abc can delete a staff document if they are authenticated.
     * @deny (delete) User abc cannot delete a staff document if they are not authenticated.
     * @principle Enforces authentication for all operations on staff documents.
     */
    match /staff/{staffId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Controls access to the /customers collection. Only authenticated users can create, read, update, or delete customer documents.
     * @path /customers/{customerId}
     * @allow (create) User abc can create a customer document if they are authenticated.
     * @deny (create) User abc cannot create a customer document if they are not authenticated.
     * @allow (get) User abc can get a customer document if they are authenticated.
     * @deny (get) User abc cannot get a customer document if they are not authenticated.
     * @allow (list) User abc can list customer documents if they are authenticated.
     * @deny (list) User abc cannot list customer documents if they are not authenticated.
     * @allow (update) User abc can update a customer document if they are authenticated.
     * @deny (update) User abc cannot update a customer document if they are not authenticated.
     * @allow (delete) User abc can delete a customer document if they are authenticated.
     * @deny (delete) User abc cannot delete a customer document if they are not authenticated.
     * @principle Enforces authentication for all operations on customer documents.
     */
    match /customers/{customerId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Controls access to the /jobsites collection. Only authenticated users can create, read, update, or delete jobsite documents.
     * @path /jobsites/{jobsiteId}
     * @allow (create) User abc can create a jobsite document if they are authenticated.
     * @deny (create) User abc cannot create a jobsite document if they are not authenticated.
     * @allow (get) User abc can get a jobsite document if they are authenticated.
     * @deny (get) User abc cannot get a jobsite document if they are not authenticated.
     * @allow (list) User abc can list jobsite documents if they are authenticated.
     * @deny (list) User abc cannot list jobsite documents if they are not authenticated.
     * @allow (update) User abc can update a jobsite document if they are authenticated.
     * @deny (update) User abc cannot update a jobsite document if they are not authenticated.
     * @allow (delete) User abc can delete a jobsite document if they are authenticated.
     * @deny (delete) User abc cannot delete a jobsite document if they are not authenticated.
     * @principle Enforces authentication for all operations on jobsite documents.
     */
    match /jobsites/{jobsiteId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Controls access to the /workSchedules collection. Only authenticated users can create, read, update, or delete work schedule documents.
     * @path /workSchedules/{workScheduleId}
     * @allow (create) User abc can create a workSchedule document if they are authenticated.
     * @deny (create) User abc cannot create a workSchedule document if they are not authenticated.
     * @allow (get) User abc can get a workSchedule document if they are authenticated.
     * @deny (get) User abc cannot get a workSchedule document if they are not authenticated.
     * @allow (list) User abc can list workSchedule documents if they are authenticated.
     * @deny (list) User abc cannot list workSchedule documents if they are not authenticated.
     * @allow (update) User abc can update a workSchedule document if they are authenticated.
     * @deny (update) User abc cannot update a workSchedule document if they are not authenticated.
     * @allow (delete) User abc can delete a workSchedule document if they are authenticated.
     * @deny (delete) User abc cannot delete a workSchedule document if they are not authenticated.
     * @principle Enforces authentication for all operations on workSchedule documents.
     */
    match /workSchedules/{workScheduleId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Controls access to the /employeeActions collection. Only authenticated users can create, read, update, or delete employee action documents.
     * @path /employeeActions/{employeeActionId}
     * @allow (create) User abc can create a employeeAction document if they are authenticated.
     * @deny (create) User abc cannot create a employeeAction document if they are not authenticated.
     * @allow (get) User abc can get a employeeAction document if they are authenticated.
     * @deny (get) User abc cannot get a employeeAction document if they are not authenticated.
     * @allow (list) User abc can list employeeAction documents if they are authenticated.
     * @deny (list) User abc cannot list employeeAction documents if they are not authenticated.
     * @allow (update) User abc can update a employeeAction document if they are authenticated.
     * @deny (update) User abc cannot update a employeeAction document if they are not authenticated.
     * @allow (delete) User abc can delete a employeeAction document if they are authenticated.
     * @deny (delete) User abc cannot delete a employeeAction document if they are not authenticated.
     * @principle Enforces authentication for all operations on employeeAction documents.
     */
    match /employeeActions/{employeeActionId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

  }

  // Helper function to determine if a user is signed in.
  function isSignedIn() {
    return request.auth != null;
  }
}