/**
 * @fileoverview Firestore Security Rules for WorkWise application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for staff-related data
 * (work schedules, employee actions) and allows public read access to other collections.
 *
 * Data Structure:
 * - `/staff/{staffId}`: Stores staff member profiles.
 * - `/customers/{customerId}`: Stores customer profiles.
 * - `/staff/{staffId}/workSchedules/{workScheduleId}`: Stores work schedules for each staff member.
 * - `/locations/{locationId}`: Stores location information.
 * - `/staff/{staffId}/employeeActions/{employeeActionId}`: Stores employee actions for each staff member.
 *
 * Key Security Decisions:
 * - Staff members can only access their own work schedules and employee actions.
 * - Listing of customer and location documents is allowed for all users.
 * - All write operations are restricted based on ownership or explicit denial.
 *
 * Denormalization for Authorization:
 *  - No denormalization is required as we are enforcing path based ownership.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants access to staff profiles based on ownership.
     * @path /staff/{staffId}
     * @allow (create) - Authenticated user can create their own staff profile.
     * @allow (get, list, update, delete) - Authenticated user can access their own staff profile.
     * @deny (create, get, list, update, delete) - Any user other than the staff member themselves.
     * @principle Enforces document ownership for writes.
     */
    match /staff/{staffId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(staffId);
      allow list: if false;
      allow create: if isOwner(staffId) && request.resource.data.id == staffId;
      allow update: if isExistingOwner(staffId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(staffId);
    }

    /**
     * @description Grants public read access to customer profiles.
     * @path /customers/{customerId}
     * @allow (get, list) - Any user can read customer profiles.
     * @deny (create, update, delete) - No user can create, update, or delete customer profiles.
     * @principle Allows public read with owner-only writes, but writes are explicitly denied since there is no clear owner.
     */
    match /customers/{customerId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Grants access to work schedules based on staff ownership.
     * @path /staff/{staffId}/workSchedules/{workScheduleId}
     * @allow (create, get, list, update, delete) - Authenticated user can access their own work schedules.
     * @deny (create, get, list, update, delete) - Any user other than the staff member themselves.
     * @principle Enforces document ownership for writes, enforces relational integrity.
     */
    match /staff/{staffId}/workSchedules/{workScheduleId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(staffId);
      allow list: if isOwner(staffId);
      allow create: if isOwner(staffId);
      allow update: if isExistingOwner(staffId);
      allow delete: if isExistingOwner(staffId);
    }

    /**
     * @description Grants public read access to location information.
     * @path /locations/{locationId}
     * @allow (get, list) - Any user can read location information.
     * @deny (create, update, delete) - No user can create, update, or delete location information.
     * @principle Allows public read with owner-only writes, but writes are explicitly denied since there is no clear owner.
     */
    match /locations/{locationId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Grants access to employee actions based on staff ownership.
     * @path /staff/{staffId}/employeeActions/{employeeActionId}
     * @allow (create, get, list, update, delete) - Authenticated user can access their own employee actions.
     * @deny (create, get, list, update, delete) - Any user other than the staff member themselves.
     * @principle Enforces document ownership for writes, enforces relational integrity.
     */
    match /staff/{staffId}/employeeActions/{employeeActionId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(staffId);
      allow list: if isOwner(staffId);
      allow create: if isOwner(staffId);
      allow update: if isExistingOwner(staffId);
      allow delete: if isExistingOwner(staffId);
    }

     /**
      * @description Denies all access to the `staffStatus` collection.
      * @path /staffStatus
      * @allow None
      * @deny All
      * @principle: Explicitly deny access to prevent unintended data exposure.
      */
     match /staffStatus/{document} {
       allow get: if false;
       allow list: if false;
       allow create: if false;
       allow update: if false;
       allow delete: if false;
     }
  }
}