/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for staff data and restricts access to customer, work schedule, and location data to application admins.
 *
 * Data Structure:
 * - /staff/{staffId}: Stores individual staff member data, accessible only by the staff member themselves.
 * - /customers/{customerId}: Stores customer data, accessible only by admins.
 * - /workSchedules/{workScheduleId}: Stores work schedule data, accessible only by admins.
 * - /locations/{locationId}: Stores location data, accessible only by admins.
 * - /staff/{staffId}/employeeActions/{employeeActionId}: Stores employee action history, accessible only by the staff member themselves.
 * - /roles_admin/{uid}: Documents in this collection grant admin privileges to the user with the matching Firebase auth uid.
 *
 * Key Security Decisions:
 * - User listing is generally disallowed to protect privacy.
 * - All write operations are protected by authorization checks, preventing unauthorized data modification.
 * - Admin privileges are determined by the existence of a document in the `/roles_admin/{uid}` collection.
 *
 * Denormalization for Authorization:
 *   - The data structure does not require denormalization for authorization.
 *
 * Structural Segregation:
 *   - Private data (staff profiles, employee actions) is stored under user-specific paths.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows a staff member to read and write their own profile data.
     * @path /staff/{staffId}
     * @allow (get, create, update, delete) if the user is signed in and the staffId matches their UID.
     * @deny (create, update, delete) if the user is not signed in or the staffId does not match their UID.
     * @principle Enforces document ownership for writes.
     */
    match /staff/{staffId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(staffId) {
        return isSignedIn() && request.auth.uid == staffId;
      }
      function isExistingOwner(staffId) {
        return isOwner(staffId) && resource != null;
      }
      allow get: if isOwner(staffId);
      allow list: if false;
      allow create: if isOwner(staffId);
      allow update: if isExistingOwner(staffId);
      allow delete: if isExistingOwner(staffId);
    }

    /**
     * @description Allows admins to read and write customer data.
     * @path /customers/{customerId}
     * @allow (get, list, create, update, delete) if the user is an admin.
     * @deny (get, list, create, update, delete) if the user is not an admin.
     * @principle Restricts access to customer data to authorized admins only.
     */
    match /customers/{customerId} {
      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Allows admins to read and write work schedule data.
     * @path /workSchedules/{workScheduleId}
     * @allow (get, list, create, update, delete) if the user is an admin.
     * @deny (get, list, create, update, delete) if the user is not an admin.
     * @principle Restricts access to work schedule data to authorized admins only.
     */
    match /workSchedules/{workScheduleId} {
      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Allows admins to read and write location data.
     * @path /locations/{locationId}
     * @allow (get, list, create, update, delete) if the user is an admin.
     * @deny (get, list, create, update, delete) if the user is not an admin.
     * @principle Restricts access to location data to authorized admins only.
     */
    match /locations/{locationId} {
      function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Allows a staff member to read and write their own employee action data.
     * @path /staff/{staffId}/employeeActions/{employeeActionId}
     * @allow (get, create, update, delete) if the user is signed in and the staffId matches their UID.
     * @deny (create, update, delete) if the user is not signed in or the staffId does not match their UID.
     * @principle Enforces document ownership for writes.
     */
    match /staff/{staffId}/employeeActions/{employeeActionId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(staffId) {
        return isSignedIn() && request.auth.uid == staffId;
      }
      function isExistingOwner(staffId) {
        return isOwner(staffId) && resource != null;
      }
      allow get: if isOwner(staffId);
      allow list: if isOwner(staffId);
      allow create: if isOwner(staffId);
      allow update: if isExistingOwner(staffId);
      allow delete: if isExistingOwner(staffId);
    }

    /**
     * @description Allows anyone to read the roles_admin collection.
     * @path /roles_admin/{uid}
     * @allow (get, list) if the user is signed in.
     * @allow (create) if the user is an admin.
     * @deny (update, delete) always.
     * @principle Restricts access to roles_admin collection to authorized admins only.
     */
        match /roles_admin/{uid} {
          function isAdmin() {
              return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
          }
          allow get: if isAdmin();
          allow list: if isAdmin();
          allow create: if isAdmin();
          allow update: if false;
          allow delete: if false;
        }
  }
}