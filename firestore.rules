/**
 * @fileoverview Firestore Security Rules for WorkWise application.
 *
 * Core Philosophy:
 * This ruleset prioritizes authorization independence and structural segregation.
 * Staff data is strictly user-owned via path-based authorization.
 * Customer, WorkSchedule, Location, EmployeeAction, and Order data is broadly accessible to authenticated users, but write operations are limited for specific entities (e.g., only admins can modify locations).
 *
 * Data Structure:
 * - /users/{userId}/staff/{staffId}: Staff member profiles, owned by the user.
 * - /customers/{customerId}: Customer data.
 * - /workSchedules/{workScheduleId}: Work schedule data.
 * - /locations/{locationId}: Location data (e.g., office addresses).
 * - /employeeActions/{employeeActionId}: Records of employee actions.
 * - /orders/{orderId}: Unassigned work orders.
 *
 * Key Security Decisions:
 * - User listing is disabled to prevent information disclosure.
 * - Missing ownership fields for the 'Recipe' entity will result in owner-only writes being disabled until the schema is updated.
 * - Ambiguous write permissions default to `allow create, update, delete: if false;`.
 *
 * Denormalization for Authorization:
 * The `EmployeeAction` entity denormalizes the `staffId` from the associated `WorkSchedule`. This design choice enables rules to validate an employee's access to an action independently of the work schedule, avoiding expensive `get()` operations.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows a user to manage their own staff profile.
     * @path /users/{userId}/staff/{staffId}
     * @allow (create) - User with UID 'user123' can create a staff document with staffId 'staff456' under /users/user123/staff/staff456
     * @allow (get,update,delete) - User with UID 'user123' can get, update, or delete their staff document with staffId 'staff456' under /users/user123/staff/staff456
     * @deny (create) - User with UID 'user123' cannot create a staff document under /users/otherUser/staff/staff456
     * @deny (update,delete) - User with UID 'user123' cannot update or delete the staff document with staffId 'staff789' under /users/user123/staff/staff789
     * @principle Enforces document ownership for all operations within a user's data tree.
     */
    match /users/{userId}/staff/{staffId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;
      allow update: if isSignedIn() && isOwner(userId) && resource != null && request.resource.data.id == resource.data.id;
      allow delete: if isSignedIn() && isOwner(userId) && resource != null;
    }

    /**
     * @description Allows any authenticated user to read customer data.
     * @path /customers/{customerId}
     * @allow (get, list) - Any authenticated user can read customer data.
     * @deny (create, update, delete) - Only an admin can modify customer data (currently denied).
     * @principle Allows public read access for customer data, but restricts writes.
     */
    match /customers/{customerId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows any authenticated user to read work schedule data.
     * @path /workSchedules/{workScheduleId}
     * @allow (get, list) - Any authenticated user can read work schedule data.
     * @deny (create, update, delete) - Only an admin can modify work schedule data (currently denied).
     * @principle Allows public read access for work schedule data, but restricts writes.
     */
    match /workSchedules/{workScheduleId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows only admins to manage location data.
     * @path /locations/{locationId}
     * @allow (create, update, delete) - Only an admin can modify location data.
     * @deny (get, list) - Non-admins cannot read location data (currently allowed for all signed in users).
     * @principle Restricts access to location data to authorized personnel.
     */
    match /locations/{locationId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows only admins to manage employee action data.
     * @path /employeeActions/{employeeActionId}
     * @allow (create, update, delete) - Only an admin can modify employee action data.
     * @deny (get, list) - Non-admins cannot read employee action data (currently allowed for all signed in users).
     * @principle Restricts access to employee action data to authorized personnel.
     */
    match /employeeActions/{employeeActionId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows any authenticated user to read order data.
     * @path /orders/{orderId}
     * @allow (get, list) - Any authenticated user can read order data.
     * @deny (create, update, delete) - Only an admin can modify order data (currently denied).
     * @principle Allows public read access for order data, but restricts writes.
     */
    match /orders/{orderId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}