/**
 * @fileoverview Firestore Security Rules for WorkWise application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for staff-related data
 * (work schedules, employee actions) and open access for locations and customers.
 * It leverages path-based authorization.
 *
 * Data Structure:
 * - /staff/{staffId}: Stores staff profile information.
 * - /staff/{staffId}/workSchedules/{workScheduleId}: Stores work schedules owned by a specific staff member.
 * - /staff/{staffId}/employeeActions/{employeeActionId}: Stores employee actions owned by a specific staff member.
 * - /customers/{customerId}: Stores customer information (public read).
 * - /locations/{locationId}: Stores location information (public read).
 *
 * Key Security Decisions:
 * - Staff can only access their own profile and associated work schedules and employee actions.
 * - Customers and Locations are publicly readable.
 * - No user listing is allowed except for explicitly defined public collections.
 *
 * Denormalization for Authorization:
 * - N/A: Path-based ownership negates the need for data denormalization. The staffId is implicit in the path.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Rules for staff profiles.
     * @path /staff/{staffId}
     * @allow (create) User with UID 'SoYoYTKtacdwxlsnKJKj7YCBrOo1' can create their own profile if staffId matches their UID.
     * @deny (create) User with UID 'SoYoYTKtacdwxlsnKJKj7YCBrOo1' cannot create a profile with a different staffId.
     * @allow (get) User with UID 'SoYoYTKtacdwxlsnKJKj7YCBrOo1' can get their own profile.
     * @deny (get) User with UID 'randomUserId' cannot get another user's profile.
     * @allow (update) User with UID 'SoYoYTKtacdwxlsnKJKj7YCBrOo1' can update their own profile.
     * @deny (update) User with UID 'randomUserId' cannot update another user's profile.
     * @allow (delete) User with UID 'SoYoYTKtacdwxlsnKJKj7YCBrOo1' can delete their own profile.
     * @deny (delete) User with UID 'randomUserId' cannot delete another user's profile.
     * @principle Enforces document ownership for writes.
     */
    match /staff/{staffId} {
      allow create: if isSignedIn() && isOwner(staffId) && request.resource.data.id == staffId;
      allow get: if isSignedIn() && isOwner(staffId);
      allow list: if false; // Prevent listing of all staff members
      allow update: if isSignedIn() && isExistingOwner(staffId) && request.resource.data.id == resource.data.id;
      allow delete: if isSignedIn() && isExistingOwner(staffId);
    }

    /**
     * @description Rules for customer profiles. Publicly readable.
     * @path /customers/{customerId}
     * @allow (get) Any user can read customer profiles.
     * @allow (list) Any user can list customer profiles.
     * @deny (create) No user can create customer profiles.
     * @deny (update) No user can update customer profiles.
     * @deny (delete) No user can delete customer profiles.
     * @principle Allows public read access to customer data.
     */
    match /customers/{customerId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Rules for work schedules owned by a specific staff member.
     * @path /staff/{staffId}/workSchedules/{workScheduleId}
     * @allow (create) User with UID 'SoYoYTKtacdwxlsnKJKj7YCBrOo1' can create a work schedule if staffId matches their UID.
     * @deny (create) User with UID 'randomUserId' cannot create a work schedule under another user's staffId.
     * @allow (get) User with UID 'SoYoYTKtacdwxlsnKJKj7YCBrOo1' can get their own work schedule.
     * @deny (get) User with UID 'randomUserId' cannot get another user's work schedule.
     * @allow (list) User with UID 'SoYoYTKtacdwxlsnKJKj7YCBrOo1' can list their own work schedules.
     * @deny (list) User with UID 'randomUserId' cannot list another user's work schedules.
     * @allow (update) User with UID 'SoYoYTKtacdwxlsnKJKj7YCBrOo1' can update their own work schedule.
     * @deny (update) User with UID 'randomUserId' cannot update another user's work schedule.
     * @allow (delete) User with UID 'SoYoYTKtacdwxlsnKJKj7YCBrOo1' can delete their own work schedule.
     * @deny (delete) User with UID 'randomUserId' cannot delete another user's work schedule.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /staff/{staffId}/workSchedules/{workScheduleId} {
      allow create: if isSignedIn() && isOwner(staffId);
      allow get: if isSignedIn() && isOwner(staffId);
      allow list: if isSignedIn() && isOwner(staffId);
      allow update: if isSignedIn() && isExistingOwner(staffId);
      allow delete: if isSignedIn() && isExistingOwner(staffId);
    }

    /**
     * @description Rules for location information. Publicly readable.
     * @path /locations/{locationId}
     * @allow (get) Any user can read location information.
     * @allow (list) Any user can list locations.
     * @deny (create) No user can create locations.
     * @deny (update) No user can update locations.
     * @deny (delete) No user can delete locations.
     * @principle Allows public read access to location data.
     */
    match /locations/{locationId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Rules for employee actions owned by a specific staff member.
     * @path /staff/{staffId}/employeeActions/{employeeActionId}
     * @allow (create) User with UID 'SoYoYTKtacdwxlsnKJKj7YCBrOo1' can create an employee action if staffId matches their UID.
     * @deny (create) User with UID 'randomUserId' cannot create an employee action under another user's staffId.
     * @allow (get) User with UID 'SoYoYTKtacdwxlsnKJKj7YCBrOo1' can get their own employee action.
     * @deny (get) User with UID 'randomUserId' cannot get another user's employee action.
     * @allow (list) User with UID 'SoYoYTKtacdwxlsnKJKj7YCBrOo1' can list their own employee actions.
     * @deny (list) User with UID 'randomUserId' cannot list another user's employee actions.
     * @allow (update) User with UID 'SoYoYTKtacdwxlsnKJKj7YCBrOo1' can update their own employee action.
     * @deny (update) User with UID 'randomUserId' cannot update another user's employee action.
     * @allow (delete) User with UID 'SoYoYTKtacdwxlsnKJKj7YCBrOo1' can delete their own employee action.
     * @deny (delete) User with UID 'randomUserId' cannot delete another user's employee action.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /staff/{staffId}/employeeActions/{employeeActionId} {
      allow create: if isSignedIn() && isOwner(staffId);
      allow get: if isSignedIn() && isOwner(staffId);
      allow list: if isSignedIn() && isOwner(staffId);
      allow update: if isSignedIn() && isExistingOwner(staffId);
      allow delete: if isSignedIn() && isExistingOwner(staffId);
    }
    
     /**
      * @description This path was the source of the error reported. It's being explicitly denied here.
      * @path /orders
      * @deny (get) No user can get an order.
      * @deny (list) No user can list orders.
      * @deny (create) No user can create orders.
      * @deny (update) No user can update orders.
      * @deny (delete) No user can delete orders.
      * @principle Explicitly denying a collection that caused a permissions error.
      */
    match /orders/{orderId} {
       allow get, list, create, update, delete: if false;
    }
  }

  // Helper Functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }

  function isExistingOwner(userId) {
    return isOwner(userId) && resource != null;
  }
}