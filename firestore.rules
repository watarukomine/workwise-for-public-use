/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a secure, authenticated-user-centric model.
 * All data access requires a user to be signed in.
 *
 * Data Structure:
 * The database consists of several top-level collections: /staff, /customers, /jobsites, /workSchedules, and /employeeActions.
 * Each collection stores data related to its respective entity.
 *
 * Key Security Decisions:
 * - Only authenticated users can access any data.
 * - There is currently no role based access control.
 * - All write operations are disallowed as a default.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Rules for the /staff collection. Only authenticated users can read. Writes are disabled.
     * @path /staff/{staffId}
     * @allow (get, list) User is signed in.
     * @deny (create, update, delete) Always.  Writes are not permitted.
     * @principle Requires authentication for reads and disables writes.
     */
    match /staff/{staffId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Rules for the /customers collection. Only authenticated users can read. Writes are disabled.
     * @path /customers/{customerId}
     * @allow (get, list) User is signed in.
     * @deny (create, update, delete) Always.  Writes are not permitted.
     * @principle Requires authentication for reads and disables writes.
     */
    match /customers/{customerId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Rules for the /jobsites collection. Only authenticated users can read. Writes are disabled.
     * @path /jobsites/{jobsiteId}
     * @allow (get, list) User is signed in.
     * @deny (create, update, delete) Always.  Writes are not permitted.
     * @principle Requires authentication for reads and disables writes.
     */
    match /jobsites/{jobsiteId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Rules for the /workSchedules collection. Only authenticated users can read. Writes are disabled.
     * @path /workSchedules/{workScheduleId}
     * @allow (get, list) User is signed in.
     * @deny (create, update, delete) Always.  Writes are not permitted.
     * @principle Requires authentication for reads and disables writes.
     */
    match /workSchedules/{workScheduleId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Rules for the /employeeActions collection. Only authenticated users can read. Writes are disabled.
     * @path /employeeActions/{employeeActionId}
     * @allow (get, list) User is signed in.
     * @deny (create, update, delete) Always.  Writes are not permitted.
     * @principle Requires authentication for reads and disables writes.
     */
    match /employeeActions/{employeeActionId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Rules for the /orders collection. Only authenticated users can read. Writes are disabled.
     * @path /orders
     * @allow (get, list) User is signed in.
     * @deny (create, update, delete) Always.  Writes are not permitted.
     * @principle Requires authentication for reads and disables writes.
     */
    match /orders {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}