/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict authenticated-user access model for all collections.
 * All data is stored in top-level collections: /staff/{staffId}, /customers/{customerId}, /jobsites/{jobsiteId}, /workSchedules/{workScheduleId}, and /employeeActions/{employeeActionId}.
 * Key Security Decisions:
 *  - Listing of any collection is forbidden unless explicitly allowed. This prevents unauthorized data discovery.
 *  - All write operations require the user to be authenticated.
 *  - Read operations require the user to be authenticated.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages staff member data. Only authenticated users can access staff data.
     * @path /staff/{staffId}
     * @allow (create) - Authenticated user can create staff data.
     * @deny (create) - Unauthenticated user attempts to create staff data.
     * @allow (get) - Authenticated user can get staff data.
     * @deny (get) - Unauthenticated user attempts to get staff data.
     * @allow (list) - Authenticated user can list staff data.
     * @deny (list) - Unauthenticated user attempts to list staff data.
     * @allow (update) - Authenticated user can update staff data.
     * @deny (update) - Unauthenticated user attempts to update staff data.
     * @allow (delete) - Authenticated user can delete staff data.
     * @deny (delete) - Unauthenticated user attempts to delete staff data.
     * @principle Authenticated users only.
     */
    match /staff/{staffId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Manages customer data. Only authenticated users can access customer data.
     * @path /customers/{customerId}
     * @allow (create) - Authenticated user can create customer data.
     * @deny (create) - Unauthenticated user attempts to create customer data.
     * @allow (get) - Authenticated user can get customer data.
     * @deny (get) - Unauthenticated user attempts to get customer data.
     * @allow (list) - Authenticated user can list customer data.
     * @deny (list) - Unauthenticated user attempts to list customer data.
     * @allow (update) - Authenticated user can update customer data.
     * @deny (update) - Unauthenticated user attempts to update customer data.
     * @allow (delete) - Authenticated user can delete customer data.
     * @deny (delete) - Unauthenticated user attempts to delete customer data.
     * @principle Authenticated users only.
     */
    match /customers/{customerId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Manages jobsite data. Only authenticated users can access jobsite data.
     * @path /jobsites/{jobsiteId}
     * @allow (create) - Authenticated user can create jobsite data.
     * @deny (create) - Unauthenticated user attempts to create jobsite data.
     * @allow (get) - Authenticated user can get jobsite data.
     * @deny (get) - Unauthenticated user attempts to get jobsite data.
     * @allow (list) - Authenticated user can list jobsite data.
     * @deny (list) - Unauthenticated user attempts to list jobsite data.
     * @allow (update) - Authenticated user can update jobsite data.
     * @deny (update) - Unauthenticated user attempts to update jobsite data.
     * @allow (delete) - Authenticated user can delete jobsite data.
     * @deny (delete) - Unauthenticated user attempts to delete jobsite data.
     * @principle Authenticated users only.
     */
    match /jobsites/{jobsiteId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Manages work schedule data. Only authenticated users can access work schedule data.
     * @path /workSchedules/{workScheduleId}
     * @allow (create) - Authenticated user can create work schedule data.
     * @deny (create) - Unauthenticated user attempts to create work schedule data.
     * @allow (get) - Authenticated user can get work schedule data.
     * @deny (get) - Unauthenticated user attempts to get work schedule data.
     * @allow (list) - Authenticated user can list work schedule data.
     * @deny (list) - Unauthenticated user attempts to list work schedule data.
     * @allow (update) - Authenticated user can update work schedule data.
     * @deny (update) - Unauthenticated user attempts to update work schedule data.
     * @allow (delete) - Authenticated user can delete work schedule data.
     * @deny (delete) - Unauthenticated user attempts to delete work schedule data.
     * @principle Authenticated users only.
     */
    match /workSchedules/{workScheduleId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Manages employee action data. Only authenticated users can access employee action data.
     * @path /employeeActions/{employeeActionId}
     * @allow (create) - Authenticated user can create employee action data.
     * @deny (create) - Unauthenticated user attempts to create employee action data.
     * @allow (get) - Authenticated user can get employee action data.
     * @deny (get) - Unauthenticated user attempts to get employee action data.
     * @allow (list) - Authenticated user can list employee action data.
     * @deny (list) - Unauthenticated user attempts to list employee action data.
     * @allow (update) - Authenticated user can update employee action data.
     * @deny (update) - Unauthenticated user attempts to update employee action data.
     * @allow (delete) - Authenticated user can delete employee action data.
     * @deny (delete) - Unauthenticated user attempts to delete employee action data.
     * @principle Authenticated users only.
     */
    match /employeeActions/{employeeActionId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

  }

  function isSignedIn() {
    return request.auth != null;
  }
}