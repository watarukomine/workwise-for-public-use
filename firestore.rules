/**
 * @file Firebase Security Rules for Firestore.
 *
 * @core_philosophy This ruleset enforces a role-based access control system,
 * where 'admin' roles have broad access and 'staff' roles have limited access,
 * primarily to their own data. Data validation is relaxed for prototyping.
 *
 * @data_structure
 * - /staff/{staffId}: Stores staff profiles, managed by admins.
 * - /customers/{customerId}: Stores customer data, managed by admins.
 * - /schedules/{scheduleId}: Stores schedule data, managed by admins.
 * - /locations/{locationId}: Stores location data, managed by admins.
 * - /staff/{staffId}/employee_actions/{employeeActionId}: Stores employee actions.
 *   Staff can manage their own actions, and admins can manage all actions.
 * - /config/admins: A singleton document containing a list of admin UIDs.
 *
 * @key_security_decisions
 * - Strict role-based access control with admin override.
 * - Data validation is minimized for rapid prototyping.
 * - No user listing is allowed for privacy.
 *
 * @denormalization_for_authorization
 * - The `AdminConfig` document at `/config/admins` is used to store a list of admin UIDs.
 *   The `isAdmin()` function checks if `request.auth.uid` is in this list.
 *   This avoids complex collection queries in the security rules.
 *
 * @structural_segregation N/A
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants access to staff profiles based on role.
     * @path /staff/{staffId}
     * @allow (get) Authenticated admin can read a staff profile.
     * @allow (create) Authenticated admin can create a staff profile.
     * @deny (get) Non-admin cannot read a staff profile.
     * @deny (create) Non-admin cannot create a staff profile.
     * @principle Enforces role-based access control; admins manage staff profiles.
     */
    match /staff/{staffId} {
      allow get: if isAdmin();
      allow list: if false;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Grants access to customer profiles based on role.
     * @path /customers/{customerId}
     * @allow (get) Authenticated admin can read a customer profile.
     * @allow (create) Authenticated admin can create a customer profile.
     * @deny (get) Non-admin cannot read a customer profile.
     * @deny (create) Non-admin cannot create a customer profile.
     * @principle Enforces role-based access control; admins manage customer profiles.
     */
    match /customers/{customerId} {
      allow get: if isAdmin();
      allow list: if false;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Grants access to schedule data based on role.
     * @path /schedules/{scheduleId}
     * @allow (get) Authenticated admin can read a schedule entry.
     * @allow (create) Authenticated admin can create a schedule entry.
     * @deny (get) Non-admin cannot read a schedule entry.
     * @deny (create) Non-admin cannot create a schedule entry.
     * @principle Enforces role-based access control; admins manage schedule data.
     */
    match /schedules/{scheduleId} {
      allow get: if isAdmin();
      allow list: if false;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Grants access to location data based on role.
     * @path /locations/{locationId}
     * @allow (get) Authenticated admin can read a location entry.
     * @allow (create) Authenticated admin can create a location entry.
     * @deny (get) Non-admin cannot read a location entry.
     * @deny (create) Non-admin cannot create a location entry.
     * @principle Enforces role-based access control; admins manage location data.
     */
    match /locations/{locationId} {
      allow get: if isAdmin();
      allow list: if false;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Grants access to employee actions based on role.
     * @path /staff/{staffId}/employee_actions/{employeeActionId}
     * @allow (get) Authenticated admin can read any employee action.
     * @allow (get) Authenticated staff can read their own employee actions.
     * @allow (create) Authenticated staff can create their own employee actions.
     * @allow (update) Authenticated staff can update their own employee actions.
     * @allow (delete) Authenticated staff can delete their own employee actions.
     * @deny (get) Authenticated staff cannot read other staff's employee actions.
     * @deny (create) Authenticated staff cannot create employee actions for other staff.
     * @principle Enforces role-based access control with ownership for staff actions.
     */
    match /staff/{staffId}/employee_actions/{employeeActionId} {
      allow get: if isAdmin() || isOwner(staffId);
      allow list: if isAdmin() || isOwner(staffId);
      allow create: if isSignedIn() && (isOwner(staffId));
      allow update: if isSignedIn() && (isOwner(staffId) && resource != null);
      allow delete: if isSignedIn() && (isOwner(staffId) && resource != null);
    }

    /**
     * @description Grants access to the admin configuration document.
     * @path /config/admins
     * @allow (get) Only authenticated users can read the admin configuration.
     * @allow (update) Only authenticated users can update the admin configuration.
     * @deny (get) Unauthenticated users cannot read the admin configuration.
     * @deny (update) Unauthenticated users cannot update the admin configuration.
     * @principle Restricts access to the admin configuration to authenticated users only.
     */
    match /config/admins {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if false;
      allow update: if false; // TODO: Add validation to only allow admins to update
      allow delete: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
          && get(/databases/$(database)/documents/config/admins).data.admin_uids.hasAny([request.auth.uid]);
    }
  }
}