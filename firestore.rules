/**
 * @fileOverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset prioritizes robust authorization by strictly enforcing ownership and role-based access.
 * It leverages path-based ownership where appropriate and uses a dedicated collection for global admin roles.
 * Data validation is relaxed to enable rapid prototyping, focusing on authorization-critical fields.
 *
 * Data Structure:
 * - /staff/{staffId}: Stores individual staff member data. Only the staff member or an admin can access this data.
 * - /customers/{customerId}: Stores customer data. Intended for public consumption, but currently requires authentication.
 * - /schedules/{scheduleId}: Stores schedule data, referencing staff and customers.
 * - /staff/{staffId}/statusUpdates/{statusUpdateId}: Stores real-time status updates for staff. Access is limited to the staff member or admins.
 * - /roles_admin/{userId}: Documents in this collection indicate admin privileges for the corresponding user.
 *
 * Key Security Decisions:
 * - Listing of customers is currently allowed for any signed-in user.
 * - Strict ownership is enforced for staff data and status updates.
 * - Data validation is minimal, focusing on authorization-relevant fields (e.g., staffId in status updates).
 * - To avoid `get()` calls in rules, authorization data is denormalized where necessary.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user ID matches the provided user ID.
     * @param {string} userId The user ID to compare against.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is an admin by verifying the existence of an admin role document.
     */
    function isAdmin() {
       return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * @description Checks if the authenticated user is the owner of an existing document.
     * @param {string} userId The user ID to compare against.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
    
    /**
     * @description Rules for staff documents.
     * @path /staff/{staffId}
     * @allow (create) User with UID 'staff_abc' can create a document at /staff/staff_abc.
     * @deny (create) User with UID 'other_user' cannot create a document at /staff/staff_abc.
     * @allow (get, list, update, delete) User with UID 'staff_abc' can read/write their own document at /staff/staff_abc.
     * @deny (get, list, update, delete) User with UID 'other_user' cannot read/write document at /staff/staff_abc.
     * @principle Enforces document ownership for writes.
     */
    match /staff/{staffId} {
      allow get: if isOwner(staffId) || isAdmin();
      allow list: if false;
      allow create: if isOwner(staffId);
      allow update: if isExistingOwner(staffId) || isAdmin();
      allow delete: if isExistingOwner(staffId) || isAdmin();
    }

    /**
     * @description Rules for customer documents.  Allows public read access.
     * @path /customers/{customerId}
     * @allow (get, list) Any signed-in user can read customer data.
     * @deny (create, update, delete) Only admins can create, update, or delete customer data.
     * @principle Allows public read with admin-only writes for customer data.
     */
    match /customers/{customerId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Rules for schedule documents.
     * @path /schedules/{scheduleId}
     * @allow (create) Any signed-in user can create a schedule.
     * @deny (update, delete) Only admins can update or delete schedules.
     * @principle Allows signed-in users to create schedules, but restricts updates and deletes to admins.
     */
    match /schedules/{scheduleId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Rules for staff status updates.
     * @path /staff/{staffId}/statusUpdates/{statusUpdateId}
     * @allow (create) User with UID 'staff_abc' can create a status update under /staff/staff_abc/statusUpdates/.
     * @deny (create) User with UID 'other_user' cannot create a status update under /staff/staff_abc/statusUpdates/.
     * @allow (get, list, update, delete) User with UID 'staff_abc' or an admin can read/write their own status updates.
     * @deny (get, list, update, delete) User with UID 'other_user' cannot read/write status updates under /staff/staff_abc/statusUpdates/.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /staff/{staffId}/statusUpdates/{statusUpdateId} {
      allow get: if isOwner(staffId) || isAdmin();
      allow list: if isOwner(staffId) || isAdmin();
      allow create: if isOwner(staffId) ;
      allow update: if isExistingOwner(staffId) || isAdmin();
      allow delete: if isExistingOwner(staffId) || isAdmin();
    }

    /**
     * @description Rules for admin roles.
     * @path /roles_admin/{userId}
     * @allow (create) Only the user themselves can create their admin role document.
     * @deny (create) Another user cannot create an admin role document for a different user.
     * @allow (get, list, update, delete) Only the user themselves can read/write their admin role document.
     * @principle Enforces self-creation and ownership for admin role documents.
     */
    match /roles_admin/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
  }
}