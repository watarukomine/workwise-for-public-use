/**
 * @file Firebase Security Rules for WorkWise Application
 *
 * @core_philosophy This ruleset implements a combination of ownership-based access control
 * and public read access with restricted writes. User-specific data is stored under
 * the /users/{userId} path, enforcing strict ownership. Other data is publicly accessible.
 *
 * @data_structure The Firestore data is organized as follows:
 * - /users/{userId}/staff/{staffId}: Staff profiles, accessible only to the owning user.
 * - /customers/{customerId}: Customer data, publicly readable, writable by authenticated users.
 * - /workSchedules/{workScheduleId}: Work schedule data, publicly readable, writable by authenticated users.
 * - /locations/{locationId}: Location data, publicly readable, writable by authenticated users.
 * - /employeeActions/{employeeActionId}: Employee action data, publicly readable, writable by authenticated users.
 * - /orders/{orderId}: Order data, publicly readable, writable by authenticated users.
 *
 * @key_security_decisions
 * - User listing is disallowed for privacy.
 * - Public read access is granted to collections where this is a safe default.
 * - All write operations require user authentication.
 *
 * @denormalization The `EmployeeAction` entity includes a denormalized `staffId` to enable
 * authorization independence, avoiding costly `get()` calls to the `WorkSchedule` collection.
 *
 * @structural_segregation Data is segregated into collections based on access requirements.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Defines the base `isSignedIn()` function.
     * @param N/A
     * @return {boolean} `true` if request.auth is not null, `false` otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Defines the `isOwner(userId)` function to check if the request is made by the owner of the document.
     * @param {string} userId - The user ID to compare against the request's authentication UID.
     * @return {boolean} `true` if the request is authenticated and the provided userId matches the request's authentication UID, `false` otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is the owner of the existing document.
     * @param {string} userId - The user ID to compare against the resource's data.
     * @return {boolean} - True if the user is the owner and the resource exists.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Rules for staff profiles under a user's document.
     * @path /users/{userId}/staff/{staffId}
     * @allow (create) - Authenticated user creates their own staff profile.
     * @allow (get, list) - Authenticated user reads their own staff profile.
     * @allow (update, delete) - Authenticated user updates or deletes their own staff profile.
     * @deny (create) - User attempts to create a staff profile for another user.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/staff/{staffId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for customer data. Accessible to all authenticated users.
     * @path /customers/{customerId}
     * @allow (get, list) - Any authenticated user can read customer data.
     * @allow (create, update, delete) - Any authenticated user can create, update, or delete customer data.
     * @deny (create) - If the user is not authenticated
     * @principle Allows public read access with authentication required for writes.
     */
    match /customers/{customerId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Rules for work schedule data. Accessible to all authenticated users.
     * @path /workSchedules/{workScheduleId}
     * @allow (get, list) - Any authenticated user can read work schedule data.
     * @allow (create, update, delete) - Any authenticated user can create, update, or delete work schedule data.
     * @deny (create) - If the user is not authenticated
     * @principle Allows public read access with authentication required for writes.
     */
    match /workSchedules/{workScheduleId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Rules for location data. Accessible to all authenticated users.
     * @path /locations/{locationId}
     * @allow (get, list) - Any authenticated user can read location data.
     * @allow (create, update, delete) - Any authenticated user can create, update, or delete location data.
     * @deny (create) - If the user is not authenticated
     */
    match /locations/{locationId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Rules for employee action data. Accessible to all authenticated users.
     * @path /employeeActions/{employeeActionId}
     * @allow (get, list) - Any authenticated user can read employee action data.
     * @allow (create, update, delete) - Any authenticated user can create, update, or delete employee action data.
     * @deny (create) - If the user is not authenticated
     * @principle Allows public read access with authentication required for writes.
     */
    match /employeeActions/{employeeActionId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Rules for order data. Accessible to all authenticated users.
     * @path /orders/{orderId}
     * @allow (get, list) - Any authenticated user can read order data.
     * @allow (create, update, delete) - Any authenticated user can create, update, or delete order data.
     * @deny (create) - If the user is not authenticated
     * @principle Allows public read access with authentication required for writes.
     */
    match /orders/{orderId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }
  }
}