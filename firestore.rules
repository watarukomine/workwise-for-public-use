/**
 * @fileOverview
 * This ruleset enforces a strict user-ownership model for staff members and an admin-only model for customers, schedules, and locations.
 * Data is organized into top-level collections for each entity (staff, customers, schedules, locations), with staff-specific data nested under /staff/{staffId}.
 * Key security decisions include isolating authentication data in the `staff_credentials` collection, using an existence check for admin roles in `roles_admin`, and enforcing path-based ownership for staff data.
 * The rules are designed to prevent unauthorized data access and manipulation, ensuring that only authenticated staff members can manage their own data and only admins can manage customer, schedule, and location data.
 * Staff credentials are kept separate from general staff information to isolate authentication data. Each top-level collection represents a distinct entity with its own security posture.
 * User-specific data (e.g., employee actions related to a specific staff) will be located under a collection whose ID is the staff's UID to implement path-based ownership.
 * Existence-based rules for admin roles are utilized via the `roles_admin` collection.
 * Secure `list` operations are supported by enforcing authorization rules at the collection level.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows staff members to manage their own profile data.
     * @path /staff/{staffId}
     * @allow (get, create, update, delete) if the request is made by the staff member with matching UID.
     * @deny (get, create, update, delete) if the request is made by a different staff member or an unauthenticated user.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /staff/{staffId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      // Read rules
      allow get: if isOwner(staffId);
      allow list: if false; // Listing staff profiles is not permitted.

      // Write rules
      allow create: if isOwner(staffId);
      allow update: if isExistingOwner(staffId);
      allow delete: if isExistingOwner(staffId);
    }

    /**
     * @description Allows admins to manage customer profiles.
     * @path /customers/{customerId}
     * @allow (get, create, update, delete) if the request is made by an authenticated admin user.
     * @deny (get, create, update, delete) if the request is made by a non-admin user or an unauthenticated user.
     * @principle Restricts access to admins only.
     */
    match /customers/{customerId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isAdmin() {
        return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Allows admins to manage work schedules.
     * @path /schedules/{scheduleId}
     * @allow (get, create, update, delete) if the request is made by an authenticated admin user.
     * @deny (get, create, update, delete) if the request is made by a non-admin user or an unauthenticated user.
     * @principle Restricts access to admins only.
     */
    match /schedules/{scheduleId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isAdmin() {
        return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Allows admins to manage location data.
     * @path /locations/{locationId}
     * @allow (get, create, update, delete) if the request is made by an authenticated admin user.
     * @deny (get, create, update, delete) if the request is made by a non-admin user or an unauthenticated user.
     * @principle Restricts access to admins only.
     */
    match /locations/{locationId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isAdmin() {
        return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Allows staff members to manage their own employee actions.
     * @path /staff/{staffId}/employee_actions/{employeeActionId}
     * @allow (get, create, update, delete) if the request is made by the staff member with matching UID.
     * @deny (get, create, update, delete) if the request is made by a different staff member or an unauthenticated user.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /staff/{staffId}/employee_actions/{employeeActionId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      // Read rules
      allow get: if isOwner(staffId);
      allow list: if isOwner(staffId);

      // Write rules
      allow create: if isOwner(staffId);
      allow update: if isExistingOwner(staffId);
      allow delete: if isExistingOwner(staffId);
    }

    /**
     * @description Marks a user as an administrator. Existence of the document grants admin privileges.
     * @path /roles_admin/{userId}
     * @allow (get, create, update, delete) if the request is made by an authenticated admin user.
     * @deny (get, create, update, delete) if the request is made by a non-admin user or an unauthenticated user.
     * @principle Restricts access to admins only.
     */
    match /roles_admin/{userId} {
        function isSignedIn() {
          return request.auth != null;
        }

        // Only allow admins to create/modify other admins.  This prevents privilege escalation.
        function isAdmin() {
          return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
        }

        allow get: if isAdmin();
        allow list: if false; // No listing of admins

        // An admin can create, update or delete other admins
        allow create: if isAdmin();
        allow update: if isAdmin();
        allow delete: if isAdmin();
    }

       /**
     * @description Stores staff login credentials (email/password or other authentication info).
     * @path /staff_credentials/{staffId}
     * @allow (get, create, update, delete) if the request is made by the staff member with matching UID.
     * @deny (get, create, update, delete) if the request is made by a different staff member or an unauthenticated user.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /staff_credentials/{staffId} {
        function isSignedIn() {
          return request.auth != null;
        }

        function isOwner(userId) {
          return isSignedIn() && request.auth.uid == userId;
        }

        function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
        }


        // Read rules:
        // The collection's intended design is a security through obscurity approach.  Prevent "get" and "list"
        allow get: if false;
        allow list: if false;


        // Write rules
        allow create: if isOwner(staffId);
        allow update: if isExistingOwner(staffId);
        allow delete: if isExistingOwner(staffId);
    }
  }
}