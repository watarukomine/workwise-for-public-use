/**
 * @file Firebase Security Rules for WorkWise Application
 *
 * @core_philosophy This ruleset enforces a strict user-ownership model for staff data and allows general authenticated access to customer, location, and work schedule data.  Employee actions are tied to specific staff members and only accessible by that staff member.  No public listing is permitted for staff data or employee actions.
 * @data_structure
 *   - /staff/{staffId}: Stores individual staff member details. Each staff member can only access their own document.
 *   - /customers/{customerId}: Stores customer information. Accessible to all authenticated users.
 *   - /locations/{locationId}: Stores location data. Accessible to all authenticated users.
 *   - /workSchedules/{workScheduleId}: Stores work schedule entries. Accessible to all authenticated users.
 *   - /staff/{staffId}/employeeActions/{employeeActionId}: Stores employee actions (e.g., clock-in, task start/end). Only the associated staff member can access these actions.
 * @key_security_decisions
 *   - Staff members can only access their own staff document and associated employee actions.
 *   - Customers, locations, and work schedules are accessible to any authenticated user.
 *   - Listing of the `staff` collection is disallowed to prevent enumeration of users.
 *   - Listing of employeeActions is only allowed by the owning staff member.
 * @denormalization_for_authorization N/A - Current rules do not require denormalization.
 * @structural_segregation Separate collections are used for staff, customers, locations, work schedules, and employee actions to allow for clear security boundaries and different access control requirements.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to staff member documents.
     * @path /staff/{staffId}
     * @allow (create) User with UID 'staffId' creates their own staff document.
     * @allow (get, update, delete) User with UID 'staffId' accesses their own staff document.
     * @deny (create, update, delete) User with UID 'anotherUserId' attempts to modify staff document for 'staffId'.
     * @deny (list) Any user attempts to list staff documents.
     * @principle Enforces document ownership for staff data.
     */
    match /staff/{staffId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(staffId);
      allow list: if false;
      allow create: if isOwner(staffId);
      allow update: if isExistingOwner(staffId);
      allow delete: if isExistingOwner(staffId);
    }

    /**
     * @description Controls access to customer documents. All authenticated users can read customer data.
     * @path /customers/{customerId}
     * @allow (get, list) Any authenticated user can read customer data.
     * @allow (create) Any authenticated user can create customer data.
     * @allow (update) Any authenticated user can update customer data.
     * @allow (delete) Any authenticated user can delete customer data.
     * @deny Unauthenticated users cannot access customer data.
     * @principle Allows general authenticated access to customer data.
     */
    match /customers/{customerId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Controls access to location documents. All authenticated users can read location data.
     * @path /locations/{locationId}
     * @allow (get, list) Any authenticated user can read location data.
     * @allow (create) Any authenticated user can create location data.
     * @allow (update) Any authenticated user can update location data.
     * @allow (delete) Any authenticated user can delete location data.
     * @deny Unauthenticated users cannot access location data.
     * @principle Allows general authenticated access to location data.
     */
    match /locations/{locationId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Controls access to work schedule documents. All authenticated users can read work schedule data.
     * @path /workSchedules/{workScheduleId}
     * @allow (get, list) Any authenticated user can read work schedule data.
     * @allow (create) Any authenticated user can create work schedule data.
     * @allow (update) Any authenticated user can update work schedule data.
     * @allow (delete) Any authenticated user can delete work schedule data.
     * @deny Unauthenticated users cannot access work schedule data.
     * @principle Allows general authenticated access to work schedule data.
     */
    match /workSchedules/{workScheduleId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Controls access to employee action documents.
     * @path /staff/{staffId}/employeeActions/{employeeActionId}
     * @allow (create, get, update, delete) User with UID 'staffId' can access their own employee actions.
     * @deny (create, get, update, delete) User with UID 'anotherUserId' attempts to access employee actions for 'staffId'.
     * @deny (list) Any user attempts to list employee actions for 'staffId' if they are not the owner.
     * @principle Enforces document ownership for employee actions.
     */
    match /staff/{staffId}/employeeActions/{employeeActionId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(staffId);
      allow list: if isOwner(staffId);
      allow create: if isOwner(staffId);
      allow update: if isExistingOwner(staffId);
      allow delete: if isExistingOwner(staffId);
    }
  }
}