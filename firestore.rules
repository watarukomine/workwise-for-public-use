rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile information.
     * @path /users/{userId}
     * @allow (get) User with matching {userId} can read their profile. Admin can read any profile.
     * @allow (list) User with matching {userId} can list their profile. Admin can list all profiles.
     * @allow (create) User with matching {userId} can create their profile.
     * @allow (update) User with matching {userId} can update their profile.
     * @allow (delete) User with matching {userId} can delete their profile.
     * @deny (get) User without matching {userId} cannot read another user's profile.
     * @deny (list) User without matching {userId} cannot list another user's profile.
     * @deny (create) User without matching {userId} cannot create a profile with a different user ID.
     * @deny (update) User without matching {userId} cannot update another user's profile.
     * @deny (delete) User without matching {userId} cannot delete another user's profile.
     * @principle Enforces document ownership for writes and provides admin read access.
     */
    match /users/{userId} {
      // Read access: owner or admin
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isOwner(userId) || isAdmin();

      // Write access: only the owner can create, update, or delete
      allow create: if isSignedIn() && isSelfCreate(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Controls access to staff profiles.
     * @path /staff/{staffId}
     * @allow (get) Admin can read staff profiles.
     * @allow (list) Admin can list staff profiles.
     * @allow (create) Admin can create staff profiles.
     * @allow (update) Admin can update staff profiles.
     * @allow (delete) Admin can delete staff profiles.
     * @deny (get) Non-admin cannot read staff profiles.
     * @deny (list) Non-admin cannot list staff profiles.
     * @deny (create) Non-admin cannot create staff profiles.
     * @deny (update) Non-admin cannot update staff profiles.
     * @deny (delete) Non-admin cannot delete staff profiles.
     * @principle Restricts staff management to admins.
     */
    match /staff/{staffId} {
      // Only admins can manage staff profiles
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn() && isAdmin();
      allow update: if isSignedIn() && isAdmin();
      allow delete: if isSignedIn() && isAdmin();
    }

    /**
     * @description Controls access to customer profiles.
     * @path /customers/{customerId}
     * @allow (get) Admin can read customer profiles.
     * @allow (list) Admin can list customer profiles.
     * @allow (create) Admin can create customer profiles.
     * @allow (update) Admin can update customer profiles.
     * @allow (delete) Admin can delete customer profiles.
     * @deny (get) Non-admin cannot read customer profiles.
     * @deny (list) Non-admin cannot list customer profiles.
     * @deny (create) Non-admin cannot create customer profiles.
     * @deny (update) Non-admin cannot update customer profiles.
     * @deny (delete) Non-admin cannot delete customer profiles.
     * @principle Restricts customer management to admins.
     */
    match /customers/{customerId} {
      // Only admins can manage customer profiles
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn() && isAdmin();
      allow update: if isSignedIn() && isAdmin();
      allow delete: if isSignedIn() && isAdmin();
    }

    /**
     * @description Controls access to work schedules.
     * @path /schedules/{scheduleId}
     * @allow (get) Admin can read work schedules.
     * @allow (list) Admin can list work schedules.
     * @allow (create) Admin can create work schedules.
     * @allow (update) Admin can update work schedules.
     * @allow (delete) Admin can delete work schedules.
     * @deny (get) Non-admin cannot read work schedules.
     * @deny (list) Non-admin cannot list work schedules.
     * @deny (create) Non-admin cannot create work schedules.
     * @deny (update) Non-admin cannot update work schedules.
     * @deny (delete) Non-admin cannot delete work schedules.
     * @principle Restricts schedule management to admins.
     */
    match /schedules/{scheduleId} {
      // Only admins can manage work schedules
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn() && isAdmin();
      allow update: if isSignedIn() && isAdmin();
      allow delete: if isSignedIn() && isAdmin();
    }

    /**
     * @description Controls access to location data.
     * @path /locations/{locationId}
     * @allow (get) Admin can read location data.
     * @allow (list) Admin can list location data.
     * @allow (create) Admin can create location data.
     * @allow (update) Admin can update location data.
     * @allow (delete) Admin can delete location data.
     * @deny (get) Non-admin cannot read location data.
     * @deny (list) Non-admin cannot list location data.
     * @deny (create) Non-admin cannot create location data.
     * @deny (update) Non-admin cannot update location data.
     * @deny (delete) Non-admin cannot delete location data.
     * @principle Restricts location management to admins.
     */
    match /locations/{locationId} {
      // Only admins can manage location data
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn() && isAdmin();
      allow update: if isSignedIn() && isAdmin();
      allow delete: if isSignedIn() && isAdmin();
    }

    /**
     * @description Controls access to employee actions.
     * @path /staff/{staffId}/employee_actions/{employeeActionId}
     * @allow (get) Staff can read their own employee actions. Admin can read any employee action.
     * @allow (list) Staff can list their own employee actions. Admin can list all employee actions.
     * @allow (create) Staff can create their own employee actions. Admin can create employee actions for any staff member.
     * @allow (update) Staff can update their own employee actions. Admin can update employee actions for any staff member.
     * @allow (delete) Staff can delete their own employee actions. Admin can delete employee actions for any staff member.
     * @deny (get) Staff cannot read other staff's employee actions.
     * @deny (list) Staff cannot list other staff's employee actions.
     * @deny (create) Staff cannot create employee actions for other staff members.
     * @deny (update) Staff cannot update other staff's employee actions.
     * @deny (delete) Staff cannot delete other staff's employee actions.
     * @principle Enforces ownership for staff actions and provides admin access.
     */
    match /staff/{staffId}/employee_actions/{employeeActionId} {
      // Read access: owner or admin
      allow get: if isStaffActionOwner(staffId) || isAdmin();
      allow list: if isStaffActionOwner(staffId) || isAdmin();

      // Write access: only the owner or admin can create, update, or delete
      allow create: if isSignedIn() && (isStaffActionOwner(staffId) || isAdmin());
      allow update: if isSignedIn() && (isStaffActionOwner(staffId) || isAdmin());
      allow delete: if isSignedIn() && (isStaffActionOwner(staffId) || isAdmin());
    }

    /**
     * @description Controls access to the admin configuration.
     * @path /config/admins
     * @allow (get) Anyone can read the admin configuration.
     * @allow (list) Anyone can list the admin configuration.
     * @deny (create) No one can create the admin configuration through client side.
     * @deny (update) No one can update the admin configuration through client side.
     * @deny (delete) No one can delete the admin configuration through client side.
     * @principle Defines access to the admin configuration document, only readable for all.
     */
    match /config/admins {
      // Anyone can read the admin config
      allow get: if true;
      allow list: if true;

      // No one should be able to create, update, or delete this document through client side.
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isStaffActionOwner(staffId) {
        return request.auth.uid == staffId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource.data != null;
    }

    function isSelfCreate(userId) {
        return request.auth.uid == userId;
    }

    function isAdmin() {
      return get(/databases/$(database)/documents/config/admins).data.admin_uids.has(request.auth.uid);
    }
  }
}