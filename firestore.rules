/**
 * @fileoverview Firestore Security Rules for the WorkWise application.
 *
 * Core Philosophy:
 * This ruleset enforces a combination of user-ownership for staff data and admin-only access for customer, work schedule, and location data.
 *
 * Data Structure:
 * - /staff/{staffId}: Stores individual staff member data, accessible only to the staff member themselves.
 * - /customers/{customerId}: Stores customer data, accessible only to admins.
 * - /workSchedules/{workScheduleId}: Stores work schedule data, accessible only to admins.
 * - /locations/{locationId}: Stores location data, accessible only to admins.
 * - /staff/{staffId}/employeeActions/{employeeActionId}: Stores employee action history, accessible only to the staff member.
 * - /roles_admin/{uid}: Stores admin role assignments; the existence of a document grants admin privileges to the user.
 *
 * Key Security Decisions:
 * - Staff members can only access their own data.
 * - Customer, work schedule, and location data is only accessible to admins.
 * - Listing customers is only allowed for admins.
 * - Denormalization: The workSchedules collection contains staffId and locationId fields for simplified data retrieval and rule enforcement.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     * @return {boolean} True if the request is authenticated, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user ID matches the provided user ID.
     * @param {string} userId The user ID to compare against.
     * @return {boolean} True if the user IDs match, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is an admin.
     * @return {boolean} True if the user has an admin role, false otherwise.
     */
    function isAdmin() {
      return exists(/databases/(default)/documents/roles_admin/$(request.auth.uid));
    }
    
    /**
     * @description Checks if the authenticated user owns the existing document.
     * @param {string} userId The user ID to compare against.
     * @return {boolean} True if the user IDs match and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    /**
     * @description Rules for the /staff collection.
     * @path /staff/{staffId}
     * @allow (create) Signed-in user with matching UID can create their own staff document.
     * @deny (create) Signed-in user cannot create a staff document with a mismatched UID.
     * @allow (get, update, delete) Signed-in user with matching UID can get, update and delete their own staff document.
     * @deny (get, update, delete) Signed-in user cannot get, update and delete other staff documents.
     * @principle Enforces document ownership for staff data.
     */
    match /staff/{staffId} {
      allow get: if isOwner(staffId);
      allow list: if false;
      allow create: if isOwner(staffId) && request.resource.data.id == request.auth.uid;
      allow update: if isExistingOwner(staffId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(staffId);
    }

    /**
     * @description Rules for the /customers collection.
     * @path /customers/{customerId}
     * @allow (get, list, create, update, delete) Only admins can manage customer data.
     * @deny (get, list, create, update, delete) Non-admins cannot access customer data.
     * @principle Restricts customer data access to admins.
     */
    match /customers/{customerId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Rules for the /workSchedules collection.
     * @path /workSchedules/{workScheduleId}
     * @allow (get, list, create, update, delete) Only admins can manage work schedule data.
     * @deny (get, list, create, update, delete) Non-admins cannot access work schedule data.
     * @principle Restricts work schedule data access to admins.
     */
    match /workSchedules/{workScheduleId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Rules for the /locations collection.
     * @path /locations/{locationId}
     * @allow (get, list, create, update, delete) Only admins can manage location data.
     * @deny (get, list, create, update, delete) Non-admins cannot access location data.
     * @principle Restricts location data access to admins.
     */
    match /locations/{locationId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Rules for the /staff/{staffId}/employeeActions collection.
     * @path /staff/{staffId}/employeeActions/{employeeActionId}
     * @allow (create) Signed-in user with matching UID can create their own employee action document.
     * @deny (create) Signed-in user cannot create an employee action document with a mismatched UID.
     * @allow (get, list, update, delete) Signed-in user with matching UID can get, list, update and delete their own employee action document.
     * @deny (get, list, update, delete) Signed-in user cannot get, list, update and delete other staff member's employee action documents.
     * @principle Enforces document ownership for employee action data.
     */
    match /staff/{staffId}/employeeActions/{employeeActionId} {
      allow get: if isOwner(staffId);
      allow list: if isOwner(staffId);
      allow create: if isOwner(staffId) && request.resource.data.staffId == staffId;
      allow update: if isExistingOwner(staffId) && request.resource.data.staffId == staffId;
      allow delete: if isExistingOwner(staffId) && request.resource.data.staffId == staffId;
    }

    /**
     * @description Rules for the /roles_admin collection.
     * @path /roles_admin/{uid}
     * @allow (get, create, update, delete) No direct client access is permitted for the roles_admin collection.
     * @deny (get, create, update, delete) All requests are denied.
     * @principle Protects admin role assignment from unauthorized access.
     */
    match /roles_admin/{uid} {
      allow get: if false;
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}