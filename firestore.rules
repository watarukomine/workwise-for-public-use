/**
 * @fileoverview Firestore Security Rules for WorkWise application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for staff-related data (work schedules, employee actions) and allows open access to customer and location data.
 *
 * Data Structure:
 * - `/staff/{staffId}`: Stores staff member profiles, accessible only to the staff member themselves.
 * - `/staff/{staffId}/workSchedules/{workScheduleId}`: Stores work schedules, accessible only to the owning staff member.
 * - `/staff/{staffId}/employeeActions/{employeeActionId}`: Stores employee actions, accessible only to the owning staff member.
 * - `/customers/{customerId}`: Stores customer profiles, publicly readable and writable.
 * - `/locations/{locationId}`: Stores location information, publicly readable and writable.
 *
 * Key Security Decisions:
 * - Staff members can only access their own data (profile, work schedules, actions).
 * - Customer and location data is publicly accessible.
 * - Data consistency between the path and document data is enforced on create and update for staff-owned data.
 * - No user listing is allowed for the /staff collection.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Protects staff member profiles.
     * @path /staff/{staffId}
     * @allow (create) - Authenticated user can create their own profile if the staffId matches their UID.
     * @allow (get, update, delete) - Authenticated user can read, update, and delete their own profile if the staffId matches their UID.
     * @deny (create) - Authenticated user cannot create a profile with a staffId that doesn't match their UID.
     * @deny (get, update, delete) - Authenticated user cannot read, update, or delete another user's profile.
     * @principle Enforces document ownership for reads and writes.
     */
    match /staff/{staffId} {
      function isOwner(staffId) {
        return request.auth != null && request.auth.uid == staffId;
      }
      function isExistingOwner(staffId) {
        return isOwner(staffId) && resource != null;
      }

      allow get: if isOwner(staffId);
      allow list: if false; // Explicitly disallow listing of staff members.
      allow create: if isOwner(staffId) && request.resource.data.id == staffId;
      allow update: if isExistingOwner(staffId) && request.resource.data.id == resource.data.id; // enforce immutability
      allow delete: if isExistingOwner(staffId);
    }

    /**
     * @description Allows public access to customer profiles.
     * @path /customers/{customerId}
     * @allow (get, list, create, update, delete) - Any user can create, read, update, and delete customer profiles.
     * @principle Allows public read and write access.
     */
    match /customers/{customerId} {
      allow get, list, create, update, delete: if true;
    }

    /**
     * @description Protects work schedules for each staff member.
     * @path /staff/{staffId}/workSchedules/{workScheduleId}
     * @allow (create, get, update, delete) - Authenticated user can create, read, update, and delete their own work schedules if the staffId matches their UID.
     * @deny (create) - Authenticated user cannot create a work schedule with a staffId that doesn't match their UID.
     * @deny (get, update, delete) - Authenticated user cannot read, update, or delete another user's work schedules.
     * @principle Enforces document ownership for reads and writes.
     */
    match /staff/{staffId}/workSchedules/{workScheduleId} {
      function isOwner(staffId) {
        return request.auth != null && request.auth.uid == staffId;
      }
       function isExistingOwner(staffId) {
        return isOwner(staffId) && resource != null;
      }

      allow get, list: if isOwner(staffId);
      allow create: if isOwner(staffId) && request.resource.data.staffId == staffId;
      allow update: if isExistingOwner(staffId) && request.resource.data.staffId == resource.data.staffId; // enforce immutability
      allow delete: if isExistingOwner(staffId);
    }

    /**
     * @description Allows public access to location information.
     * @path /locations/{locationId}
     * @allow (get, list, create, update, delete) - Any user can create, read, update, and delete location information.
     * @principle Allows public read and write access.
     */
    match /locations/{locationId} {
      allow get, list, create, update, delete: if true;
    }

    /**
     * @description Protects employee actions for each staff member.
     * @path /staff/{staffId}/employeeActions/{employeeActionId}
     * @allow (create, get, update, delete) - Authenticated user can create, read, update, and delete their own employee actions if the staffId matches their UID.
     * @deny (create) - Authenticated user cannot create an employee action with a staffId that doesn't match their UID.
     * @deny (get, update, delete) - Authenticated user cannot read, update, or delete another user's employee actions.
     * @principle Enforces document ownership for reads and writes.
     */
    match /staff/{staffId}/employeeActions/{employeeActionId} {
      function isOwner(staffId) {
        return request.auth != null && request.auth.uid == staffId;
      }
       function isExistingOwner(staffId) {
        return isOwner(staffId) && resource != null;
      }

      allow get, list: if isOwner(staffId);
      allow create: if isOwner(staffId) && request.resource.data.staffId == staffId;
      allow update: if isExistingOwner(staffId) && request.resource.data.staffId == resource.data.staffId; // enforce immutability
      allow delete: if isExistingOwner(staffId);
    }
  }
}